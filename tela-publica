    ps = (
        "Get-PnpDevice -Class AudioEndpoint -Status OK -ErrorAction SilentlyContinue "
        "| Where-Object { $_.InstanceId -match '\\{0\\.0\\.1\\.00000000\\}' } "
        "| ForEach-Object { $_.FriendlyName }"
    )
    try:
        kwargs = dict(capture_output=True, text=True, timeout=8)
        if IS_WINDOWS:
            kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        res = subprocess.run(
            ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", ps],
            **kwargs)
        linhas = [ln.strip() for ln in (res.stdout or "").splitlines() if ln.strip()]
        # remove duplicatas preservando ordem
