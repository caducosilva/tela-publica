            "Shell_SecondaryTrayWnd",
            "Progman",
            "WorkerW",
            "NotifyIconOverflowWindow",
            "Xaml_WindowedPopupClass",
            "Dwm",
        )
        ignorar_app = ("textinputhost", "systemsettings", "dwm")

        @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
        def enum_windows_callback(hwnd, extra):
            try:
                if not user32.IsWindowVisible(hwnd) and not user32.IsIconic(hwnd):
                    return True
                if _janela_cloaked(hwnd):
                    return True
                owner = user32.GetWindow(hwnd, GW_OWNER)
                ex = user32.GetWindowLongW(hwnd, GWL_EXSTYLE) & 0xFFFFFFFF
                if owner and not (ex & WS_EX_APPWINDOW):
                    return True
                if (ex & WS_EX_TOOLWINDOW) and not (ex & WS_EX_APPWINDOW):
                    return True

                cls = ctypes.create_unicode_buffer(256)
                user32.GetClassNameW(hwnd, cls, 256)
                classe = cls.value or ""
                if classe in ignorar_classe:
                    return True

                length = user32.GetWindowTextLengthW(hwnd)
                title = ""
                if length > 0:
                    buff = ctypes.create_unicode_buffer(length + 1)
                    user32.GetWindowTextW(hwnd, buff, length + 1)
                    title = buff.value or ""
                if any(ig.lower() in title.lower() for ig in ignorar_titulo):
                    return True

                rect = wintypes.RECT()
                user32.GetWindowRect(hwnd, ctypes.byref(rect))
                w = int(rect.right - rect.left)
                h = int(rect.bottom - rect.top)
                minimizada = bool(user32.IsIconic(hwnd))
                # Minimizada no Windows pode reportar tamanho pequeno/negativo.
