<script>
const T = location.pathname.split("/").pop();
const v = document.getElementById("v");
const MS = window.ManagedMediaSource || window.MediaSource;
let ms, sb, fila = [], ativo = true, ultimoChat = 0, conectando = false, meuNome = "";
let volSalvo = 1;
// Atraso definido pelo host (padrao 6s). Quem assiste nao escolhe.
let ATRASO = 6;
let prontoParaTocar = false;
let sumirBarra = null;
let chatAberto = true;

function emTelaCheia(){
  return !!(document.fullscreenElement || document.webkitFullscreenElement);
}
function lerChatPref(){
  try{
    const s = localStorage.getItem("tp_chat");
    if (s === "0") return false;
    if (s === "1") return true;
  }catch(e){}
  // Fora de FS: aberto. Em FS: fechado por padrao (video limpo).
  return !emTelaCheia();
}
function salvarChatPref(aberto){
  try{ localStorage.setItem("tp_chat", aberto ? "1" : "0"); }catch(e){}
}
function aplicarChat(){
  const chat = document.getElementById("chat");
  const btn = document.getElementById("bchat");
  chat.className = chatAberto ? "aberto" : "fechado";
  if (btn){
    btn.textContent = chatAberto ? "Ocultar chat" : "Chat";
    btn.className = chatAberto ? "ligado" : "";
  }
}
function abrirChat(){
  chatAberto = true;
  salvarChatPref(true);
  aplicarChat();
  mostrarBarra();
}
function fecharChat(){
  chatAberto = false;
  salvarChatPref(false);
  aplicarChat();
  mostrarBarra();
}
function alternarChat(){
  if (chatAberto) fecharChat();
  else abrirChat();
}
function mostrarBarra(){
  const barra = document.getElementById("barra");
  barra.className = "on";
  clearTimeout(sumirBarra);
  const ae = document.activeElement;
  // So segura a barra se estiver mexendo nela (nao no chat).
  const naBarra = ae && barra.contains(ae);
  sumirBarra = setTimeout(() => {
    if (naBarra || (document.activeElement && barra.contains(document.activeElement))){
      mostrarBarra();
      return;
    }
    barra.className = "";
  }, emTelaCheia() ? 2600 : 3200);
}
function esconderBarra(){
  document.getElementById("barra").className = "";
}
function mostrarUI(){ mostrarBarra(); }

function aplicarAtrasoHost(sec){
  const n = parseInt(sec, 10);
  if ([3, 6, 10].indexOf(n) < 0 || n === ATRASO) return;
  ATRASO = n;
  prontoParaTocar = false;
  aviso("Atraso do anfitriao: " + n + "s");
  setTimeout(() => aviso(""), 1600);
  alinhar(true);
}

function folga(){
  try{
    const b = v.buffered;
    if (!b.length) return 0;
    return b.end(b.length - 1) - v.currentTime;
  }catch(e){ return 0; }
}

function aviso(t){
  const a = document.getElementById("aviso");
  a.textContent = t || ""; a.className = t ? "on" : "";
}
function mostrarEspera(msg){
  const e = document.getElementById("espera");
  e.className = "";
  if (msg) document.getElementById("espera-msg").textContent = msg;
}
function esconderEspera(){
  document.getElementById("espera").className = "ok";
}

function setVol(x){
  x = Math.max(0, Math.min(1, Number(x) || 0));
  v.volume = x;
  if (x > 0.001){ v.muted = false; volSalvo = x; }
  const r = document.getElementById("vol");
  if (r) r.value = Math.round(x * 100);
  const lbl = document.getElementById("vollbl");
  if (lbl) lbl.textContent = Math.round(x * 100) + "%";
  const bm = document.getElementById("bmute");
  if (bm) bm.textContent = (v.muted || x < 0.001) ? "Mudo" : "Som";
  try{ localStorage.setItem("tp_vol", String(x)); }catch(e){}
}
function mudarVol(delta){ setVol((v.muted ? 0 : v.volume) + delta); mostrarBarra(); }
function alternarMudo(){
  if (v.muted || v.volume < 0.001){
    v.muted = false;
    setVol(volSalvo > 0.05 ? volSalvo : 0.7);
  } else {
    volSalvo = v.volume || volSalvo;
    v.muted = true;
    const bm = document.getElementById("bmute");
    if (bm) bm.textContent = "Mudo";
  }
  mostrarBarra();
}
function pedirQualidade(nome){
  fetch("/qualidade?t=" + encodeURIComponent(T), {
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body: JSON.stringify({qualidade: nome})
  }).then(r => r.json()).then(d => {
    if (d && d.ok === false) aviso(d.erro || "Nao foi possivel mudar a qualidade");
    else {
      aviso("Qualidade: " + (nome || ""));
      if (d && d.atraso) aplicarAtrasoHost(d.atraso);
    }
    setTimeout(() => aviso(""), 1800);
  }).catch(() => aviso("Falha ao pedir qualidade"));
  mostrarBarra();
}
function atualizarQualidadeUI(nome){
  const s = document.getElementById("bq");
  if (s && nome && [...s.options].some(o => o.value === nome)) s.value = nome;
}
try{
  const vs = parseFloat(localStorage.getItem("tp_vol") || "1");
  setVol(isFinite(vs) ? vs : 1);
}catch(e){ setVol(1); }

function atualizarGate(){
  meuNome = (localStorage.getItem("tp_apelido") || "").trim();
  const gate = document.getElementById("gate");
  const form = document.getElementById("form");
  if (meuNome.length >= 2){
    gate.style.display = "none";
    form.style.display = "flex";
    document.getElementById("nome-ativo").textContent = meuNome;
  } else {
    gate.style.display = "flex";
    form.style.display = "none";
  }
}
function salvarNome(){
  const n = document.getElementById("nome-novo").value.trim();
  const av = document.getElementById("chat-aviso");
  if (n.length < 2){ av.textContent = "Use pelo menos 2 letras."; return; }
  localStorage.setItem("tp_apelido", n);
  av.textContent = "";
  atualizarGate();
  document.getElementById("texto").focus();
  abrirChat();
}

async function telaCheia(){
  try{
    if (!emTelaCheia()){
      const alvo = document.documentElement;
      if (alvo.requestFullscreen) await alvo.requestFullscreen({navigationUI:"hide"});
      else if (alvo.webkitRequestFullscreen) alvo.webkitRequestFullscreen();
      else if (v.webkitEnterFullscreen){ v.webkitEnterFullscreen(); return; }
      try{ await screen.orientation.lock("landscape"); }catch(e){}
    } else {
      try{ screen.orientation.unlock(); }catch(e){}
      if (document.exitFullscreen) await document.exitFullscreen();
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    }
  }catch(e){}
  atualizarBotao();
  mostrarBarra();
}
function atualizarBotao(){
  const cheio = emTelaCheia();
  const estavaFs = document.body.classList.contains("fs");
  document.body.classList.toggle("fs", cheio);
  document.getElementById("bfs").textContent = cheio ? "Sair da tela cheia" : "Tela cheia";
  // Entra em tela cheia: video limpo (chat fechado). Nao grava preferencia.
  // Usuario abre de novo pelo botao Chat; ai fica ate ele fechar.
  if (cheio && !estavaFs){
    chatAberto = false;
    aplicarChat();
  }
  if (!cheio && estavaFs){
    chatAberto = lerChatPref();
    aplicarChat();
  }
}
document.addEventListener("fullscreenchange", () => { atualizarBotao(); mostrarBarra(); });
document.addEventListener("webkitfullscreenchange", () => { atualizarBotao(); mostrarBarra(); });

let ultimoToque = 0;
let ultimoMoveUI = 0;
v.addEventListener("click", () => {
  if (v.paused) v.play().catch(()=>{});
  if (v.muted){ v.muted = false; setVol(volSalvo > 0.05 ? volSalvo : 1); }
  const agora = Date.now();
  if (agora - ultimoToque < 350) telaCheia();
  ultimoToque = agora;
  mostrarBarra();
});
function atividadeUI(e){
  const agora = Date.now();
  if (agora - ultimoMoveUI < 120) return;
  ultimoMoveUI = agora;
  const alvo = e && e.target;
  if (alvo && alvo.closest && alvo.closest("#chat")) return; // chat nao mexe na barra
  if (emTelaCheia()){ mostrarBarra(); return; }
  if (!alvo) return;
  if (alvo.closest && (alvo.closest("#palco") || alvo.closest("#barra"))) mostrarBarra();
}
document.addEventListener("mousemove", atividadeUI, {passive:true});
document.addEventListener("touchstart", e => {
  const t = e.target;
  if (t && t.closest && t.closest("#chat")) return;
  mostrarBarra();
}, {passive:true});
["bq","vol"].forEach(id => {
  const el = document.getElementById(id);
  if (!el) return;
  el.addEventListener("focus", () => mostrarBarra());
  el.addEventListener("input", () => mostrarBarra());
});

async function conectar(){
  if (!ativo || conectando) return;
  conectando = true;
  try{
    const r = await fetch("/stream?t=" + encodeURIComponent(T), {cache:"no-store"});
    if (!r.ok){
      mostrarEspera(r.status === 404
        ? "O anfitriao ainda nao clicou em Comecar. Esta pagina atualiza sozinha."
        : "Sem acesso a esta transmissao.");
      conectando = false;
      setTimeout(conectar, 2500);
      return;
    }
    const mime = r.headers.get("X-Mime") || 'video/mp4; codecs="avc1.64002A"';
    if (!MS || !MS.isTypeSupported(mime)){
      mostrarEspera("Este navegador nao consegue tocar a transmissao.");
      conectando = false;
      return;
    }
    if (v.src) { try { URL.revokeObjectURL(v.src); } catch(e){} }
    ms = new MS();
    v.disableRemotePlayback = true;
    if (window.ManagedMediaSource && ms instanceof window.ManagedMediaSource){
      v.srcObject = ms;
    } else {
      v.src = URL.createObjectURL(ms);
    }
    await new Promise((ok, err) => {
      const t = setTimeout(() => err(new Error("timeout sourceopen")), 8000);
      ms.addEventListener("sourceopen", () => { clearTimeout(t); ok(); }, {once:true});
    });
    sb = ms.addSourceBuffer(mime);
    sb.mode = "segments";
    sb.addEventListener("updateend", () => { alinhar(); bombear(); tentarTocar(); });
    fila = [];
    prontoParaTocar = false;
    aviso("Carregando buffer (" + ATRASO + "s)...");
    esconderEspera();
    const leitor = r.body.getReader();
    while (true){
      const {done, value} = await leitor.read();
      if (done) break;
      fila.push(value);
      bombear();
      tentarTocar();
    }
    mostrarEspera("Transmissao pausada. Reconectando...");
  }catch(e){
    mostrarEspera("Reconectando...");
  }
  try{ if (ms && ms.readyState === "open") ms.endOfStream(); }catch(e){}
  sb = null; ms = null; conectando = false; prontoParaTocar = false;
  if (ativo) setTimeout(conectar, 1200);
}

function alinhar(forcar){
  if (!sb) return;
  const b = sb.buffered;
  if (!b.length) return;
  const fim = b.end(b.length - 1);
  const alvo = Math.max(b.start(0), fim - ATRASO);
  if (forcar || v.currentTime < b.start(0) || v.currentTime > fim ||
      (!prontoParaTocar && fim - b.start(0) >= Math.min(2, ATRASO * 0.5))){
    try{ v.currentTime = alvo; }catch(e){}
  }
}
function tentarTocar(){
  if (!sb) return;
  const b = sb.buffered;
  if (!b.length) return;
  const tem = b.end(b.length - 1) - b.start(0);
  const precisa = Math.max(2, ATRASO * 0.75);
  if (!prontoParaTocar){
    if (tem < precisa){
      aviso("Carregando buffer " + Math.min(100, Math.round(100 * tem / precisa)) + "%...");
      return;
    }
    prontoParaTocar = true;
    alinhar(true);
    aviso("");
  }
  if (v.paused && v.readyState >= 2) v.play().catch(()=>{});
}
function bombear(){
  if (!sb || sb.updating || !fila.length) return;
  let n = 0;
  for (const p of fila) n += p.byteLength;
  const juntos = new Uint8Array(n);
  let off = 0;
  for (const p of fila){ juntos.set(p, off); off += p.byteLength; }
  fila = [];
  try{ sb.appendBuffer(juntos); }
  catch(e){
    if (e.name === "QuotaExceededError"){
      try{
        const b = sb.buffered;
        if (b.length) sb.remove(b.start(0), Math.max(b.start(0), v.currentTime - Math.max(8, ATRASO + 2)));
      }catch(_){}
    }
  }
}
let repondo = false;
setInterval(() => {
  if (!sb || sb.updating || !prontoParaTocar) return;
  const b = sb.buffered;
  if (!b.length) return;
  const fim = b.end(b.length - 1);
  const atras = fim - v.currentTime;
  if (atras > ATRASO + 4){
    v.currentTime = fim - ATRASO;
    v.playbackRate = 1;
  } else if (atras > ATRASO + 1.5){
    v.playbackRate = 1.03;
  } else if (atras < Math.max(1.2, ATRASO * 0.45)){
    v.playbackRate = 1;
    if (!repondo && !v.paused && atras < 0.8){
      repondo = true;
      v.pause();
      aviso("Repondo buffer...");
      const precisa = Math.max(2, ATRASO * 0.7);
      const t0 = setInterval(() => {
        const f = folga();
        if (f >= precisa || !ativo){
          clearInterval(t0);
          repondo = false;
          aviso("");
          alinhar(true);
          v.play().catch(()=>{});
        }
      }, 300);
    }
  } else {
    v.playbackRate = 1;
  }
  if (v.currentTime - b.start(0) > Math.max(40, ATRASO + 25)){
    try{ sb.remove(b.start(0), v.currentTime - Math.max(15, ATRASO + 5)); }catch(e){}
  }
}, 2000);

v.addEventListener("playing", () => { esconderEspera(); aviso(""); });
v.addEventListener("waiting", () => { if (prontoParaTocar) aviso("Repondo buffer..."); });
v.addEventListener("error", () => { if (ativo) aviso("Erro no video"); });

setInterval(() => {
  let buf = 0;
  try{
    const b = v.buffered;
    if (b.length) buf = b.end(b.length - 1) - v.currentTime;
  }catch(e){}
  fetch("/sinal?t=" + encodeURIComponent(T), {method:"POST",
    headers:{"Content-Type":"application/json"},
    body: JSON.stringify({tocando: !v.paused && v.readyState >= 3, buffer: buf})
  }).then(r => r.json()).then(d => {
    if (d && d.qualidade) atualizarQualidadeUI(d.qualidade);
    if (d && d.atraso != null) aplicarAtrasoHost(d.atraso);
  }).catch(()=>{});
}, 4000);

function adicionar(m){
  const lista = document.getElementById("lista");
  const el = document.createElement("div");
  el.className = "msg";
  const b = document.createElement("b");
  b.textContent = m.nome;
  el.appendChild(b);
  el.appendChild(document.createTextNode(m.texto));
  lista.appendChild(el);
  while (lista.children.length > 200) lista.removeChild(lista.firstChild);
  lista.scrollTop = lista.scrollHeight;
}
function puxarChat(){
  fetch("/chat?t=" + encodeURIComponent(T) + "&desde=" + ultimoChat)
    .then(r => r.json())
    .then(d => { ultimoChat = d.ultimo; (d.mensagens || []).forEach(adicionar); })
    .catch(()=>{});
}
function mandar(){
  if (meuNome.length < 2){ atualizarGate(); abrirChat(); return; }
  const campo = document.getElementById("texto");
  const texto = campo.value.trim();
  const av = document.getElementById("chat-aviso2");
  if (!texto) return;
  fetch("/chat?t=" + encodeURIComponent(T), {method:"POST",
    headers:{"Content-Type":"application/json"},
    body: JSON.stringify({nome: meuNome, texto: texto})
  }).then(r => r.json()).then(d => {
    if (d.ok){ campo.value = ""; av.textContent = ""; puxarChat(); }
    else av.textContent = d.erro + (d.espera ? " (" + d.espera + "s)" : "");
  }).catch(()=>{ av.textContent = "Falha ao enviar."; });
}
document.getElementById("texto").addEventListener("keydown", ev => {
  if (ev.key === "Enter") mandar();
});
document.getElementById("nome-novo").addEventListener("keydown", ev => {
  if (ev.key === "Enter") salvarNome();
});
atualizarGate();
chatAberto = lerChatPref();
aplicarChat();
atualizarBotao();
mostrarBarra();
setInterval(puxarChat, 2000);
conectar();
</script>
