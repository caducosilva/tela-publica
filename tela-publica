                    "classe": classe or app or "app",
                    "x": int(rect.left),
                    "y": int(rect.top),
                    "w": max(0, w),
                    "h": max(0, h),
                    "minimizada": minimizada,
                })
            except Exception:
                pass
            return True

        # Mantem referencia do callback (senao o GC do Python quebra o EnumWindows).
        listar_janelas._cb = enum_windows_callback
        user32.EnumWindows.argtypes = [type(enum_windows_callback), wintypes.LPARAM]
        ok = user32.EnumWindows(enum_windows_callback, 0)
        if not ok and not janelas:
            log("EnumWindows falhou ao listar janelas")
        janelas.sort(key=lambda j: (j["minimizada"], j["app"].lower(), j["titulo"].lower()))
        return janelas

