def ambiente():
    env = dict(os.environ)
    if not IS_WINDOWS:
        env.setdefault("DISPLAY", ":0")
        env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    return env


def rodar(cmd, timeout=8):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True,
                           timeout=timeout, env=ambiente())
        return p.stdout
    except Exception:
        return ""


def porta_livre(host, preferida=0):
    for tentativa in ([preferida] if preferida else []) + [0]:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind((host, tentativa))
            return s
        except OSError:
            s.close()
    raise RuntimeError("nenhuma porta disponivel")


def ip_local():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def ips_v6():
    if IS_WINDOWS:
        return []
    saida = rodar(["ip", "-6", "addr", "show", "scope", "global"])
    achados = re.findall(r"inet6 ([0-9a-f:]+)/\d+(.*)", saida)
    fixos, temporarios = [], []
    for ip, resto in achados:
        (temporarios if "temporary" in resto else fixos).append(ip)
    return fixos + temporarios


def fatiar(texto):
    return {p for p in re.split(r"[^a-z0-9]+", (texto or "").lower()) if len(p) > 2}


def limpar_texto(bruto, maximo):
    texto = re.sub(r"[\x00-\x1f\x7f]", " ", str(bruto or ""))
    return texto.strip()[:maximo]


