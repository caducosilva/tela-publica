class Manipulador(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "tela-publica/" + VERSAO

    def __init__(self, *a, ctx=None, publico=False, **kw):
        self.ctx = ctx
        self.publico = publico
        super().__init__(*a, **kw)

    def log_message(self, *a):
        pass          # o registro do programa nunca guarda o que trafega aqui

    # ------------------------------------------------------------------ ajuda

    def _quem(self):
        """Endereco de quem pediu. Atras do tunel todo mundo chega como
        127.0.0.1, entao vale o cabecalho que o Cloudflare repassa."""
        for cab in ("CF-Connecting-IP", "X-Forwarded-For"):
            valor = self.headers.get(cab)
            if valor:
                return valor.split(",")[0].strip()[:45]
        return self.client_address[0]

    def _rota(self):
        p = urllib.parse.urlparse(self.path)
        return p.path, urllib.parse.parse_qs(p.query)

    def _corpo(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if not n or n > 8192:
                return {}
            return json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return {}

    def _envia(self, dados, tipo="application/json; charset=utf-8", codigo=200):
        if isinstance(dados, str):
            dados = dados.encode("utf-8")
        self.send_response(codigo)
        self.send_header("Content-Type", tipo)
        self.send_header("Content-Length", str(len(dados)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(dados)
        except Exception:
            pass

    def _json(self, obj, codigo=200):
        self._envia(json.dumps(obj), codigo=codigo)

    def do_GET(self):
        self._servir()

    def do_POST(self):
        self._servir()

    # ------------------------------------------------------- painel (so local)

    def _servir(self):
        rota, q = self._rota()
        ctx = self.ctx
        if self.publico:
            return self._lado_publico(rota, q)

        if q.get("k", [""])[0] != ctx.chave_painel and rota != "/":
            return self._json({"erro": "chave invalida"}, 403)

        if rota == "/":
            if q.get("k", [""])[0] != ctx.chave_painel:
                return self._envia("Abra pelo atalho Tela publica.", "text/plain", 403)
            ctx.viu_painel = True
            ctx.ultimo_ping = time.time()
            ctx.cancelar_saida()
            dados = {"chave": ctx.chave_painel, "opcoes": ctx.captura.opcoes}
            return self._envia(PAGINA_PAINEL.replace("__DADOS__", json.dumps(dados)),
                               "text/html; charset=utf-8")

        if rota == "/api/fontes":
            return self._json({"janelas": listar_janelas(), "telas": listar_telas(),
                               "microfones": listar_microfones()})

        if rota == "/api/estado":
            return self._json(self._estado_completo())

        if rota == "/api/opcoes":
            ctx.captura.aplicar(self._corpo())
            ctx.salvar()
            return self._json(self._estado_completo())

        if rota == "/api/microfone":
            corpo = self._corpo()
            ctx.captura.ajustar_microfone(corpo.get("microfone", ""),
                                          corpo.get("mic_ligado", False))
            ctx.salvar()
            return self._json(self._estado_completo())

        if rota == "/api/iniciar":
            ctx.captura.aplicar(self._corpo())
            ctx.captura.iniciar()
            ctx.salvar()
            if ctx.tunel.disponivel and not ctx.tunel.url:
                ctx.tunel.iniciar(ctx.porta_publica)
            return self._json(self._estado_completo())

        if rota == "/api/parar":
            ctx.captura.parar()
            return self._json(self._estado_completo())

        if rota == "/api/tunel":
            ctx.tunel.iniciar(ctx.porta_publica)
            return self._json(self._estado_completo())

        if rota == "/api/chat":
            if self.command == "POST":
                corpo = self._corpo()
                ok, erro, espera = ctx.chat.enviar("painel", corpo.get("nome"),
                                                   corpo.get("texto"))
                return self._json({"ok": ok, "erro": erro, "espera": espera})
            desde = int((q.get("desde", ["0"])[0] or "0").isdigit() and
                        q.get("desde", ["0"])[0] or 0)
            return self._json(ctx.chat.recentes(desde))

        if rota == "/api/ping":
            ctx.viu_painel = True
            ctx.ultimo_ping = time.time()
            ctx.cancelar_saida()
            return self._json({"ok": True})

        if rota == "/api/encerrar":
            self._json({"ok": True})
            if q.get("agora", [""])[0] == "1":
                ctx.encerrar()
            else:
                ctx.agendar_saida()
            return

        return self._json({"erro": "rota desconhecida"}, 404)

    def _estado_completo(self):
        ctx = self.ctx
        e = ctx.captura.estado_atual()
        agora = time.time()
        e.update({
            "url_publica": ctx.url_publica(),
            "urls_diretas": ctx.urls_diretas(),
            "tunel": ctx.tunel.estado,
            "tunel_disponivel": ctx.tunel.disponivel,
            "visores": [v for v in ctx.visores.values() if agora - v["quando"] < 15],
            "adaptacao": ctx.adaptador.diagnostico(),
            "saude": ctx.saude(),
            "problemas": ctx.problemas,
        })
        return e

    # ------------------------------------------------------- lado de quem ve

    def _lado_publico(self, rota, q):
        ctx = self.ctx
        token = rota[3:] if rota.startswith("/v/") else q.get("t", [""])[0]
        try:
            valido = secrets.compare_digest(token, ctx.token)
        except TypeError:
            valido = False
        if not valido:
            return self._envia("Link invalido.", "text/plain", 403)

        if rota.startswith("/v/"):
            return self._envia(PAGINA_VISOR, "text/html; charset=utf-8")

        if rota == "/stream":
            return self._fluxo()

        if rota == "/chat":
            if self.command == "POST":
                corpo = self._corpo()
                ok, erro, espera = ctx.chat.enviar(self._quem(), corpo.get("nome"),
                                                   corpo.get("texto"))
                return self._json({"ok": ok, "erro": erro, "espera": espera})
            bruto = q.get("desde", ["0"])[0]
            return self._json(ctx.chat.recentes(int(bruto) if bruto.isdigit() else 0))

        if rota == "/sinal":
            info = self._corpo()
            agora = time.time()
            chave = self._quem()
            antes = ctx.visores.get(chave) or {}
            ctx.visores[chave] = {
                "tocando": bool(info.get("tocando")),
                "buffer": round(float(info.get("buffer") or 0), 1),
                "quando": agora,
                "desde": antes.get("desde", agora),
            }
            return self._json({"ok": True})

        return self._envia("Nao encontrado.", "text/plain", 404)

    def _fluxo(self):
        assinante, inicial, mime = self.ctx.captura.assinar()
        if not assinante:
            return self._envia("Transmissao parada.", "text/plain", 404)
        try:
            self.send_response(200)
            self.send_header("Content-Type", "video/mp4")
            self.send_header("X-Mime", mime)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            self._pedaco(inicial)
            while True:
                try:
                    dados = assinante.fila.get(timeout=20)
                except queue.Empty:
                    break
                if dados is None:
                    break
                self._pedaco(dados)
            self._pedaco(b"")
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            self.ctx.captura.desassinar(assinante)

    def _pedaco(self, dados):
        self.wfile.write(b"%X\r\n" % len(dados))
        if dados:
            self.wfile.write(dados)
        self.wfile.write(b"\r\n")
        self.wfile.flush()


class Servidor(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, sock, handler):
        self.socket = sock
        self.server_address = sock.getsockname()
        socketserver.BaseServer.__init__(self, self.server_address, handler)
        self.socket.listen(64)

    def handle_error(self, request, client_address):
        pass


