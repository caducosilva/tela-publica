def ambiente():
    env = dict(os.environ)
    if not IS_WINDOWS:
        env.setdefault("DISPLAY", ":0")
        env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    return env


def rodar(cmd, timeout=8):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True,
                           timeout=timeout, env=ambiente())
        return p.stdout
    except Exception:
        return ""


def porta_em_uso(host, porta):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.settimeout(0.3)
        return s.connect_ex((host, porta)) == 0
    except OSError:
        return False
    finally:
        s.close()


def porta_livre(host, preferida=0):
    """Bind em porta livre: tenta a preferida, vizinhas e por fim qualquer porta do SO."""
    tentativas = []
    if preferida:
        tentativas.append(preferida)
        for offset in range(1, 80):
            tentativas.append(preferida + offset)
    tentativas.append(0)
    vistos = set()
    for tentativa in tentativas:
        if tentativa in vistos:
            continue
        vistos.add(tentativa)
        if tentativa and porta_em_uso("127.0.0.1", tentativa):
            continue
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        # Sem SO_REUSEADDR: evita duas instancias na mesma porta no Windows.
        try:
            s.bind((host, tentativa))
            return s
        except OSError:
            s.close()
    raise RuntimeError("nenhuma porta disponivel")


_MUTEX_HANDLE = None
_LOCK_FD = None


def _pid_vivo(pid):
    if not pid:
        return False
    try:
        if IS_WINDOWS:
            kernel32 = ctypes.windll.kernel32
            PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
            STILL_ACTIVE = 259
            h = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, int(pid))
            if not h:
                return False
            try:
                code = wintypes.DWORD()
                if kernel32.GetExitCodeProcess(h, ctypes.byref(code)):
                    return int(code.value) == STILL_ACTIVE
                return True
            finally:
                kernel32.CloseHandle(h)
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


