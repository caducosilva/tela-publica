class MesaDeSom:
    def __init__(self):
        self.trava = threading.RLock()
        self.modulo = None
        self.pid_alvo = None
        self.tokens = set()
        self.usar_sistema = True
        self.mic = ""
        self.mic_ligado = False
        self.programa = ""
        self.achou_programa = True
        self.mic_no_ar = False
        if not IS_WINDOWS:
            self.limpar_restos()
            threading.Thread(target=self._laco, daemon=True).start()

    def monitor(self):
        if IS_WINDOWS:
            # No Windows o som do sistema so entra se existir Stereo Mix / Cable.
            return listar_loopback_windows() or None
        return SINK_MESA + ".monitor" if self.modulo else None

    def limpar_restos(self):
        if IS_WINDOWS:
            return
        for linha in rodar(["pactl", "list", "short", "modules"]).splitlines():
            if SINK_MESA in linha:
                rodar(["pactl", "unload-module", linha.split("\t")[0]])

    def _garantir_destino(self):
        if IS_WINDOWS:
            return True
        if self.modulo:
            return True
        saida = rodar(["pactl", "load-module", "module-null-sink",
                       "sink_name=" + SINK_MESA,
                       "sink_properties=device.description=Tela_publica"]).strip()
        if saida.isdigit():
            self.modulo = saida
            log("destino de som criado (modulo %s)" % saida)
            return True
        return False

    def definir_janela(self, pid, textos):
        with self.trava:
            self.pid_alvo = pid
            self.tokens = set()
            for t in textos:
                self.tokens |= fatiar(t)
            self.usar_sistema = True
        self._garantir_destino()
        self._religar()

    def definir_tela_inteira(self):
        with self.trava:
            self.pid_alvo = None
            self.tokens = set()
            self.usar_sistema = True
        self._garantir_destino()
        self._religar()

    def definir_microfone(self, nome, ligado):
        with self.trava:
            self.mic = nome or ""
            self.mic_ligado = bool(ligado and self.mic)
        self._garantir_destino()
        self._religar()

    def desligar(self):
        with self.trava:
            self.pid_alvo = None
            self.tokens = set()
            self.usar_sistema = False
            self.achou_programa = False
            self.programa = ""
        self._religar()

    def _religar(self):
        if IS_WINDOWS:
            with self.trava:
                self.achou_programa = True
                self.mic_no_ar = self.mic_ligado
            return

        with self.trava:
            if not self.modulo:
                return
            quer_programa = bool(self.tokens or self.pid_alvo)
            quer_sistema = self.usar_sistema
            quer_mic = self.mic_ligado
            mic = self.mic

        dados = pw_dump()
        if not dados:
            return

        nos, portas, ligacoes = {}, [], {}
        for o in dados:
            tipo = o.get("type", "")
            info = o.get("info", {}) or {}
            props = info.get("props", {}) or {}
            if tipo.endswith("Node"):
                nos[o["id"]] = props
            elif tipo.endswith("Port"):
                portas.append((o["id"], props))
            elif tipo.endswith("Link"):
                ligacoes[(info.get("output-port-id"), info.get("input-port-id"))] = o["id"]

        destino = next((i for i, p in nos.items()
                        if p.get("node.name") == SINK_MESA), None)
        if destino is None:
            return
        entradas = {p.get("audio.channel"): i for i, p in portas
                    if p.get("node.id") == destino and p.get("port.direction") == "in"}
        if not entradas:
            return

        padrao = sink_padrao() if quer_sistema else ""
        desejados, nome_programa, achou, mic_ativo = set(), "", False, False

        for nid, props in nos.items():
            if nid == destino:
                continue
            classe = props.get("media.class", "")
            nome_no = props.get("node.name", "")
            if quer_programa and classe == "Stream/Output/Audio" \
                    and self._combina_programa(props):
                desejados.add(nid)
                achou = True
                nome_programa = props.get("application.name") or nome_no
            elif quer_sistema and classe == "Audio/Sink" and nome_no == padrao:
                desejados.add(nid)
            elif quer_mic and classe == "Audio/Source" and nome_no == mic:
                desejados.add(nid)
                mic_ativo = True

        for nid in desejados:
            saidas = [(p.get("audio.channel"), i) for i, p in portas
                      if p.get("node.id") == nid and p.get("port.direction") == "out"]
            for canal, porta_saida in saidas:
                alvos = ([entradas[canal]] if canal in entradas
                         else list(entradas.values()))
                for porta_entrada in alvos:
                    if (porta_saida, porta_entrada) not in ligacoes:
                        rodar(["pw-link", str(porta_saida), str(porta_entrada)])

        for (saida_id, entrada_id), link_id in ligacoes.items():
            if entrada_id not in entradas.values():
                continue
            dono = next((p.get("node.id") for i, p in portas if i == saida_id), None)
            if dono is not None and dono not in desejados:
                rodar(["pw-link", "-d", str(saida_id), str(entrada_id)])

        with self.trava:
            self.achou_programa = achou
            self.mic_no_ar = mic_ativo
            if achou:
                self.programa = re.sub(r"^PipeWire ALSA \[(.*)\]$", r"\1",
                                       nome_programa)

    def _combina_programa(self, props):
        pid = props.get("application.process.id")
        try:
            if pid is not None and self.pid_alvo and int(pid) == self.pid_alvo:
                return True
        except (TypeError, ValueError):
            pass
        nomes = fatiar(" ".join(str(props.get(k, "")) for k in (
            "node.name", "application.name", "application.process.binary",
            "media.name")))
        return bool(nomes & self.tokens)

    def _laco(self):
        while True:
            time.sleep(2.5)
            try:
                self._religar()
            except Exception as e:
                log("mesa de som:", e)

    def estado(self):
        with self.trava:
            return {
                "tem_destino": True if IS_WINDOWS else bool(self.modulo),
                "achou_programa": True if IS_WINDOWS else self.achou_programa,
                "programa": self.programa or "Áudio do Sistema Windows",
                "microfone": self.mic,
                "mic_ligado": self.mic_ligado,
                "mic_no_ar": self.mic_no_ar if not IS_WINDOWS else self.mic_ligado,
                "tela_inteira": self.usar_sistema,
            }

    def limpar(self):
        if IS_WINDOWS:
            return
        with self.trava:
            mod, self.modulo = self.modulo, None
        if mod:
            rodar(["pactl", "unload-module", mod])


class Chat:
    VIDA = 60
    INTERVALO = 5
    TETO = 60
    MAX_TEXTO = 200
    MAX_NOME = 20

    def __init__(self):
        self.trava = threading.Lock()
        self.mensagens = deque(maxlen=self.TETO)
        self.ultimo_envio = {}
        self.sequencia = 0

    def _limpar(self, agora):
        while self.mensagens and agora - self.mensagens[0]["quando"] > self.VIDA:
            self.mensagens.popleft()
        for ip, quando in list(self.ultimo_envio.items()):
            if agora - quando > 300:
                del self.ultimo_envio[ip]

    def enviar(self, quem, nome, texto):
        agora = time.time()
        nome = limpar_texto(nome, self.MAX_NOME)
        texto = limpar_texto(texto, self.MAX_TEXTO)
        with self.trava:
            self._limpar(agora)
            if len(nome) < 2:
                return False, "Escolha um nome antes de mandar mensagem.", 0
            if not texto:
                return False, "Escreva alguma coisa.", 0
            espera = self.INTERVALO - (agora - self.ultimo_envio.get(quem, 0))
            if espera > 0:
                return False, "Espere %d s para mandar de novo." % (int(espera) + 1), int(espera) + 1
            self.ultimo_envio[quem] = agora
            self.sequencia += 1
            self.mensagens.append({"id": self.sequencia, "nome": nome,
                                   "texto": texto, "quando": agora})
            return True, "", 0

    def recentes(self, desde=0):
        agora = time.time()
        with self.trava:
            self._limpar(agora)
            novas = [{"id": m["id"], "nome": m["nome"], "texto": m["texto"],
                      "resta": round(self.VIDA - (agora - m["quando"]), 1)}
                     for m in self.mensagens if m["id"] > desde]
            return {"mensagens": novas, "ultimo": self.sequencia,
                    "vivas": len(self.mensagens)}


class Assinante:
    LIMITE = 12
    ATRASO = 4

    def __init__(self, gen):
        self.gen = gen
        self.fila = queue.Queue(maxsize=self.LIMITE)
        self.viva = True

    def enviar(self, dados):
        try:
            self.fila.put_nowait(dados)
        except queue.Full:
            self.viva = False
            try:
                while True:
                    self.fila.get_nowait()
            except queue.Empty:
                pass
            try:
                self.fila.put_nowait(None)
            except queue.Full:
                pass

    def encerrar(self):
        self.viva = False
        try:
            self.fila.put_nowait(None)
        except queue.Full:
            pass


PADRAO = {
    "alvo": "",
    "microfone": "",
    "mic_ligado": False,
}


class Captura:
    def __init__(self, mesa):
        self.trava = threading.RLock()
        self.mesa = mesa
        self.opcoes = dict(PADRAO)
        self.nivel = 0
        self.codificador = encoder_preferido()
        self.gen = 0
        self.proc = None
        self.init_seg = None
        self.mime = ""
        self.assinantes = set()
        self.deve_rodar = False
        self.estado = "parado"
        self.erro = ""
        self.aviso_nivel = ""
        self.registro = []
        self.velocidade = ""
        self.bytes_janela = 0
        self.kbps_real = 0
        self.inicio = 0
        self.falhas = 0
        self.quedas = 0
        self.dimensoes = ""
        self.pausado_por_janela = False
        threading.Thread(target=self._medidor, daemon=True).start()
        threading.Thread(target=self._vigia_janela, daemon=True).start()

    def aplicar(self, novas):
        with self.trava:
            for k in PADRAO:
                if k in novas:
                    self.opcoes[k] = novas[k]
            rodando = self.deve_rodar
        self._ajustar_som()
        if rodando:
            with self.trava:
                self._parar_processo()
                self._iniciar_processo()

    def ajustar_microfone(self, nome, ligado):
        with self.trava:
            self.opcoes["microfone"] = nome or ""
            self.opcoes["mic_ligado"] = bool(ligado)
            rodando = self.deve_rodar
        self.mesa.definir_microfone(nome, ligado)
        # No Windows o mic entra pelo ffmpeg; precisa religar o processo.
        if IS_WINDOWS and rodando:
            with self.trava:
                self._parar_processo()
                self._iniciar_processo()

    def iniciar(self):
        self._ajustar_som()
        with self.trava:
            self.deve_rodar = True
            self.pausado_por_janela = False
            self.falhas = 0
            self.nivel = 0
            self.aviso_nivel = ""
            self._parar_processo()
            self._iniciar_processo()

    def parar(self):
        with self.trava:
            self.deve_rodar = False
            self.pausado_por_janela = False
            self._parar_processo()
            self.estado = "parado"
            self.erro = ""
        self.mesa.desligar()

    def _ajustar_som(self):
        with self.trava:
            alvo = self.opcoes["alvo"]
            mic, ligado = self.opcoes["microfone"], self.opcoes["mic_ligado"]
        tipo, _, ref = alvo.partition(":")
        if tipo == "janela":
            janela = next((j for j in listar_janelas() if str(j["id"]) == str(ref)), None)
            if janela:
                self.mesa.definir_janela(janela["pid"], [janela["classe"], janela["app"]])
            else:
                self.mesa.desligar()
        elif tipo == "tela":
            self.mesa.definir_tela_inteira()
        else:
            self.mesa.desligar()
        self.mesa.definir_microfone(mic, ligado)

    def _parar_processo(self):
        p, self.proc = self.proc, None
        self.init_seg = None
        for a in list(self.assinantes):
            a.encerrar()
        self.assinantes.clear()
        if p and p.poll() is None:
            try:
                p.terminate()
                p.wait(timeout=3)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass

    def _iniciar_processo(self):
        if not self.opcoes["alvo"]:
            self.estado = "escolha uma janela"
            return
        tipo, _, ref = self.opcoes["alvo"].partition(":")
        if tipo == "janela" and not janela_visivel(ref):
            if not restaurar_janela(ref):
                self.estado = "janela minimizada"
                self.erro = ("Essa janela esta minimizada. Restaure ela na tela "
                             "para poder transmitir.")
                self.deve_rodar = False
                return
        cmd = self._montar_comando()
        self.dimensoes = "%dx%d" % (NIVEIS[self.nivel]["larg"], NIVEIS[self.nivel]["alt"])
        self.gen += 1
        gen = self.gen
        self.mime = self._mime()
        self.registro = []
        self.erro = ""
        self.velocidade = ""
        self.inicio = time.time()
        log("captura gen", gen, "nivel", self.nivel, self.codificador)
        try:
            kwargs = dict(
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL, bufsize=0, env=ambiente())
            if IS_WINDOWS:
                kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            self.proc = subprocess.Popen(cmd, **kwargs)
        except FileNotFoundError:
            self.estado = "erro"
            self.erro = "FFmpeg nao encontrado. No Windows: winget install Gyan.FFmpeg"
            return
        self.estado = "iniciando"
        threading.Thread(target=self._leitor, args=(self.proc, gen), daemon=True).start()
        threading.Thread(target=self._erros, args=(self.proc, gen), daemon=True).start()

    def _montar_comando(self):
        n = NIVEIS[self.nivel]
        cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-nostdin"]
        tipo, _, ref = self.opcoes["alvo"].partition(":")
        tem_audio = False

        if IS_WINDOWS:
            if tipo == "janela":
                # No Windows, title= do gdigrab e fragil (titulo muda, acentos,
                # maximizada). Capturamos a regiao da janela no desktop.
                geo = geometria_janela(ref)
                if geo:
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-offset_x", str(geo["x"]), "-offset_y", str(geo["y"]),
                            "-video_size", "%dx%d" % (geo["w"], geo["h"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "desktop"]
                else:
                    janela = next((j for j in listar_janelas()
                                   if str(j["id"]) == str(ref)), None)
                    titulo = (janela["titulo"] if janela else "") or titulo_janela(ref)
                    if titulo:
                        cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                                "-thread_queue_size", "1024", "-draw_mouse", "0",
                                "-i", "title=%s" % titulo]
                    else:
                        cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                                "-thread_queue_size", "1024", "-draw_mouse", "0",
                                "-i", "desktop"]
            else:
                tela = next((t for t in listar_telas() if t["nome"] == ref), None) \
                    or (listar_telas()[0] if listar_telas() else None)
                if tela and (tela["x"] or tela["y"]):
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-offset_x", str(tela["x"]), "-offset_y", str(tela["y"]),
                            "-video_size", "%dx%d" % (tela["w"], tela["h"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "desktop"]
                else:
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "desktop"]

            # Audio: Stereo Mix/Cable se existir; microfone se o dono ligar.
            loop = self.mesa.monitor()
            mic = self.opcoes.get("microfone") or ""
            mic_on = bool(self.opcoes.get("mic_ligado") and mic)
            audio_inputs = []
            if loop:
                audio_inputs.append(loop)
            if mic_on and mic not in audio_inputs:
                audio_inputs.append(mic)
            for nome_aud in audio_inputs:
                cmd += ["-f", "dshow", "-thread_queue_size", "1024",
                        "-i", "audio=%s" % nome_aud]
            tem_audio = bool(audio_inputs)

        else:
            display = ambiente()["DISPLAY"]
            gpu = self.codificador == "vaapi" and tem_vaapi()
            if gpu:
                cmd += ["-vaapi_device", RENDER_NODE]

            cmd += ["-f", "x11grab", "-framerate", str(n["fps"]),
                    "-thread_queue_size", "1024", "-draw_mouse", "0"]

            if tipo == "janela":
                cmd += ["-window_id", ref, "-i", display]
            else:
                telas = listar_telas()
                tela = next((t for t in telas if t["nome"] == ref), None) or \
                    (telas[0] if telas else {"w": 1920, "h": 1080, "x": 0, "y": 0})
                cmd += ["-video_size", "%dx%d" % (tela["w"], tela["h"]),
                        "-i", "%s+%d,%d" % (display, tela["x"], tela["y"])]

            fonte = self.mesa.monitor()
            if fonte:
                cmd += ["-f", "pulse", "-thread_queue_size", "1024", "-i", fonte]
                tem_audio = True

        # Quadro fixo 1920x1080 (ou nivel atual) com tarja.
        if self.codificador == "vaapi" and tem_vaapi() and not IS_WINDOWS:
            filtros = (
                "scale=%d:%d:force_original_aspect_ratio=decrease:flags=bicubic,"
                "pad=%d:%d:(ow-iw)/2:(oh-ih)/2,format=nv12,hwupload"
                % (n["larg"], n["alt"], n["larg"], n["alt"])
            )
        else:
            filtros = (
                "scale=%d:%d:force_original_aspect_ratio=decrease:flags=bicubic,"
                "pad=%d:%d:(ow-iw)/2:(oh-ih)/2,format=yuv420p"
                % (n["larg"], n["alt"], n["larg"], n["alt"])
            )
        cmd += ["-vf", filtros]

        gop = str(n["fps"] * 2)
        k = n["kbps"]
        enc = self.codificador
        if enc == "nvenc":
            cmd += ["-c:v", "h264_nvenc", "-preset", "p4", "-tune", "ll",
                    "-rc", "vbr", "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2), "-g", gop, "-bf", "0"]
        elif enc == "amf":
            cmd += ["-c:v", "h264_amf", "-quality", "speed",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2), "-g", gop]
        elif enc == "qsv":
            cmd += ["-c:v", "h264_qsv", "-preset", "veryfast",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2), "-g", gop]
        elif enc == "vaapi" and tem_vaapi() and not IS_WINDOWS:
            cmd += ["-c:v", "h264_vaapi", "-profile:v", "high", "-level", "42",
                    "-rc_mode", "CQP", "-qp", str(n["qp"]), "-g", gop, "-bf", "0"]
        else:
            cmd += ["-c:v", "libx264", "-preset", "veryfast",
                    "-profile:v", "high", "-level", "4.2",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2),
                    "-g", gop, "-keyint_min", gop, "-sc_threshold", "0", "-bf", "2"]

        if tem_audio:
            if IS_WINDOWS:
                loop = self.mesa.monitor()
                mic = self.opcoes.get("microfone") or ""
                mic_on = bool(self.opcoes.get("mic_ligado") and mic)
                idx = 1
                mapas = []
                if loop:
                    mapas.append("[%d:a]" % idx)
                    idx += 1
                if mic_on and mic != loop:
                    mapas.append("[%d:a]" % idx)
                if len(mapas) > 1:
                    cmd += ["-filter_complex",
                            "".join(mapas) + "amix=inputs=%d:duration=first:dropout_transition=0[aout]" % len(mapas),
                            "-map", "0:v:0", "-map", "[aout]",
                            "-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", "2"]
                else:
                    cmd += ["-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", "2",
                            "-af", "aresample=async=1000",
                            "-map", "0:v:0", "-map", "1:a:0"]
            else:
                cmd += ["-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", "2",
                        "-af", "aresample=async=1000",
                        "-map", "0:v:0", "-map", "1:a:0"]
        else:
            cmd += ["-an", "-map", "0:v:0"]

        cmd += ["-movflags", "+frag_keyframe+empty_moov+default_base_moof",
                "-flush_packets", "1", "-stats_period", "3",
                "-progress", "pipe:2", "-f", "mp4", "pipe:1"]
        return cmd

    def _mime(self):
        # Sem audio (Windows sem Stereo Mix e mic desligado) o MSE aceita so AVC.
        if IS_WINDOWS:
            loop = self.mesa.monitor()
            mic_on = bool(self.opcoes.get("mic_ligado") and self.opcoes.get("microfone"))
            if loop or mic_on:
                return 'video/mp4; codecs="avc1.64002A, mp4a.40.2"'
            return 'video/mp4; codecs="avc1.64002A"'
        if self.mesa.monitor():
            return 'video/mp4; codecs="avc1.64002A, mp4a.40.2"'
        return 'video/mp4; codecs="avc1.64002A"'

    def mudar_nivel(self, delta, motivo=""):
        with self.trava:
            novo = max(0, min(len(NIVEIS) - 1, self.nivel + delta))
            if novo == self.nivel or not self.deve_rodar:
                return False
            self.nivel = novo
            self.aviso_nivel = motivo
            log("qualidade ->", NIVEIS[novo]["nome"], motivo)
            self._parar_processo()
            self._iniciar_processo()
            return True

    @staticmethod
    def _proxima_caixa(buf):
        if len(buf) < 8:
            return None
        tamanho = int.from_bytes(buf[0:4], "big")
        tipo = bytes(buf[4:8])
        if tamanho == 1:
            if len(buf) < 16:
                return None
            tamanho = int.from_bytes(buf[8:16], "big")
        if tamanho < 8:
            raise ValueError("caixa mp4 invalida")
        if len(buf) < tamanho:
            return None
        dados = bytes(buf[:tamanho])
        del buf[:tamanho]
        return tipo, dados

    def _leitor(self, proc, gen):
        buf, inicial, frag = bytearray(), bytearray(), bytearray()
        pronto = False
        try:
            while True:
                pedaco = proc.stdout.read(65536)
                if not pedaco:
                    break
                buf += pedaco
                while True:
                    try:
                        caixa = self._proxima_caixa(buf)
                    except ValueError:
                        buf.clear()
                        break
                    if caixa is None:
                        break
                    tipo, dados = caixa
                    if not pronto:
                        if tipo in (b"ftyp", b"moov"):
                            inicial += dados
                            if tipo == b"moov":
                                pronto = True
                                with self.trava:
                                    if gen == self.gen:
                                        self.init_seg = bytes(inicial)
                                        self.estado = "no ar"
                                        self.falhas = 0
                        continue
                    if tipo == b"moof":
                        frag = bytearray(dados)
                    elif tipo == b"mdat" and frag:
                        frag += dados
                        self._difundir(gen, bytes(frag))
                        frag = bytearray()
        except Exception as e:
            log("leitor:", e)
        finally:
            self._encerrou(proc, gen)

    def _difundir(self, gen, dados):
        with self.trava:
            if gen != self.gen:
                return
            self.bytes_janela += len(dados)
            for a in list(self.assinantes):
                a.enviar(dados)
                if not a.viva:
                    self.assinantes.discard(a)
                    self.quedas += 1

    CHAVES_PROGRESSO = ("frame=", "fps=", "stream_", "bitrate=", "total_size=",
                        "out_time", "dup_frames=", "drop_frames=", "speed=",
                        "progress=")

    def _erros(self, proc, gen):
        for linha in iter(proc.stderr.readline, b""):
            texto = linha.decode("utf-8", "replace").rstrip()
            if not texto:
                continue
            if texto.startswith(self.CHAVES_PROGRESSO):
                if texto.startswith("speed="):
                    with self.trava:
                        if gen == self.gen:
                            self.velocidade = texto.split("=", 1)[1].strip()
                continue
            with self.trava:
                if gen == self.gen:
                    self.registro.append(texto)
                    del self.registro[:-40]
            log("ffmpeg:", texto)

    def _encerrou(self, proc, gen):
        time.sleep(0.2)
        with self.trava:
            if gen != self.gen:
                return
            codigo = proc.poll()
            for a in list(self.assinantes):
                a.encerrar()
            self.assinantes.clear()
            self.init_seg = None
            if not self.deve_rodar:
                self.estado = "parado"
                return
            self.falhas += 1
            pistas = [l for l in self.registro
                      if "rror" in l or "nvalid" in l or "ailed" in l
                      or "Cannot load" in l or "nvcuda" in l]
            self.erro = pistas[-1] if pistas else ("ffmpeg saiu com codigo %s" % codigo)
            # GPU encoder listado mas sem driver/CUDA: cai para CPU.
            if self.codificador in ("nvenc", "amf", "qsv") and self.falhas >= 1:
                log("encoder", self.codificador, "falhou, caindo para CPU (libx264)")
                self.codificador = "cpu"
                self.falhas = 0
                self.erro = ""
            elif self.falhas >= 5:
                self.deve_rodar = False
                self.estado = "erro"
                return
            self.estado = "reconectando"
        time.sleep(1.5)
        with self.trava:
            if self.deve_rodar and gen == self.gen:
                self._parar_processo()
                self._iniciar_processo()

    def _medidor(self):
        while True:
            time.sleep(2)
            with self.trava:
                self.kbps_real = int(self.bytes_janela * 8 / 2 / 1000)
                self.bytes_janela = 0

    def _vigia_janela(self):
        geo_cache = None
        while True:
            time.sleep(2)
            try:
                with self.trava:
                    tipo, _, ref = self.opcoes["alvo"].partition(":")
                    rodando, pausado = self.deve_rodar, self.pausado_por_janela
                if tipo != "janela" or not (rodando or pausado):
                    geo_cache = None
                    continue
                situacao = estado_janela(ref)
                with self.trava:
                    if situacao == "visivel" and pausado:
                        self.pausado_por_janela = False
                        self.deve_rodar = True
                        self.erro = ""
                        self.falhas = 0
                        geo_cache = None
                        log("janela voltou, retomando")
                        self._parar_processo()
                        self._iniciar_processo()
                    elif situacao != "visivel" and not pausado and rodando:
                        self.pausado_por_janela = True
                        self.deve_rodar = False
                        self._parar_processo()
                        geo_cache = None
                        if situacao == "sumiu":
                            self.estado = "janela fechada"
                            self.erro = "Essa janela foi fechada. Escolha outra na lista."
                            self.pausado_por_janela = False
                        else:
                            self.estado = "janela minimizada"
                            self.erro = ("A janela saiu da tela. Restaure ela e a "
                                         "transmissao volta sozinha.")
                    elif situacao == "visivel" and rodando and IS_WINDOWS:
                        # Se a janela moveu/redimensionou, reinicia a captura
                        # na nova regiao (no Linux o x11grab usa window_id).
                        geo = geometria_janela(ref)
                        if geo and geo_cache and geo != geo_cache:
                            log("janela moveu, ajustando captura",
                                "%(w)dx%(h)d+%(x)d+%(y)d" % geo)
                            self._parar_processo()
                            self._iniciar_processo()
                        if geo:
                            geo_cache = geo
            except Exception as e:
                log("vigia da janela:", e)

    def assinar(self):
        with self.trava:
            if not self.init_seg:
                return None, None, None
            a = Assinante(self.gen)
            self.assinantes.add(a)
            return a, self.init_seg, self.mime

    def desassinar(self, a):
        with self.trava:
            self.assinantes.discard(a)
            a.viva = False

    def consumir_quedas(self):
        with self.trava:
            q, self.quedas = self.quedas, 0
            return q

    def congestionado(self):
        with self.trava:
            return any(a.fila.qsize() >= Assinante.ATRASO for a in self.assinantes)

    def estado_atual(self):
        with self.trava:
            n = NIVEIS[self.nivel]
            nomes_enc = {
                "nvenc": "NVIDIA NVENC",
                "amf": "AMD AMF",
                "qsv": "Intel QSV",
                "vaapi": "VAAPI",
                "cpu": "CPU (libx264)",
            }
            return {
                "estado": self.estado,
                "erro": self.erro,
                "espectadores": len(self.assinantes),
                "kbps": self.kbps_real,
                "segundos": int(time.time() - self.inicio) if self.inicio and self.deve_rodar else 0,
                "rodando": self.deve_rodar,
                "opcoes": dict(self.opcoes),
                "qualidade": n["nome"],
                "nivel": self.nivel,
                "fps": n["fps"],
                "dimensoes": self.dimensoes,
                "codificador": nomes_enc.get(self.codificador, self.codificador),
                "velocidade": self.velocidade,
                "aviso_nivel": self.aviso_nivel,
                "som": self.mesa.estado(),
                "registro": list(self.registro[-6:]),
            }


class Adaptador:
    PACIENCIA = 180

    def __init__(self, captura, ctx):
        self.captura = captura
        self.ctx = ctx
        self.apertado = 0
        self.calmo_desde = time.time()
        self.motivo = ""
        threading.Thread(target=self._laco, daemon=True).start()

    def diagnostico(self):
        return {"calmo_ha": int(time.time() - self.calmo_desde),
                "paciencia": self.PACIENCIA, "motivo": self.motivo}

    def _laco(self):
        while True:
            time.sleep(5)
            try:
                self._avaliar()
            except Exception as e:
                log("adaptador:", e)

    def _avaliar(self):
        cap = self.captura
        if not cap.deve_rodar or cap.estado != "no ar":
            self.motivo = "captura parada"
            return
        quedas = cap.consumir_quedas()
        saude = self.ctx.saude()
        entupido = cap.congestionado()
        if quedas or saude == "apertado" or entupido:
            self.apertado += 1
            self.calmo_desde = time.time()
            self.motivo = "apertado (quedas=%d, saude=%s, fila=%s)" % (
                quedas, saude, entupido)
            if self.apertado >= 2:
                self.apertado = 0
                cap.mudar_nivel(+1, "a conexão de quem assiste não estava dando conta")
            return
        self.apertado = 0
        self.motivo = "calmo (%s)" % saude
        if saude in ("ok", "sem publico") and \
                time.time() - self.calmo_desde > self.PACIENCIA:
            self.calmo_desde = time.time()
            cap.mudar_nivel(-1, "")


class Tunel:
    def __init__(self):
        self.proc = None
        self.url = ""
        self.estado = "desligado"

    @property
    def disponivel(self):
        if os.path.exists(CLOUDFLARED_BIN):
            return True
        return shutil.which("cloudflared") is not None

    def iniciar(self, porta):
        if self.proc and self.proc.poll() is None:
            return
        if not self.disponivel:
            self.estado = "cloudflared nao instalado"
            return
        self.url = ""
        self.estado = "conectando"
        cmd_cf = CLOUDFLARED_BIN if os.path.exists(CLOUDFLARED_BIN) else (shutil.which("cloudflared") or CLOUDFLARED_BIN)
        self.proc = subprocess.Popen(
            [cmd_cf, "tunnel", "--no-autoupdate", "--url",
             "http://127.0.0.1:%d" % porta],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, bufsize=1, text=True,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0) if IS_WINDOWS else 0)
        threading.Thread(target=self._ler, daemon=True).start()

    def _ler(self):
        padrao = re.compile(r"https://[a-z0-9-]+\.trycloudflare\.com")
        for linha in iter(self.proc.stderr.readline, ""):
            m = padrao.search(linha)
            if m and not self.url:
                self.url = m.group(0)
                self.estado = "no ar"
                log("tunel no ar")
        if self.estado == "conectando":
            self.estado = "falhou"

    def parar(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=3)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
        self.proc = None
        self.url = ""
        self.estado = "desligado"


class Contexto:
    def __init__(self):
        self.mesa = MesaDeSom()
        self.captura = Captura(self.mesa)
        self.chat = Chat()
        self.tunel = Tunel()
        self.token = secrets.token_urlsafe(9)
        self.chave_painel = secrets.token_urlsafe(12)
        self.porta_publica = 0
        self.porta_painel = 0
        self.visores = {}
        self.ultimo_ping = 0
        self.viu_painel = False
        self.encerrando = False
        self.timer_saida = None
        self.problemas = verificar_ambiente()
        self.carregar()
        self.adaptador = Adaptador(self.captura, self)

    def carregar(self):
        try:
            with open(ARQ_CONFIG) as f:
                salvo = json.load(f)
            for k in PADRAO:
                if k in salvo:
                    self.captura.opcoes[k] = salvo[k]
        except Exception:
            pass

    def salvar(self):
        try:
            os.makedirs(DIR_CACHE, exist_ok=True)
            guardar = {k: v for k, v in self.captura.opcoes.items() if k != "alvo"}
            with open(ARQ_CONFIG, "w") as f:
                json.dump(guardar, f)
        except Exception:
            pass

    def saude(self):
        agora = time.time()
        vivos = [v for v in self.visores.values() if agora - v["quando"] < 15]
        if not vivos:
            return "sem publico"
        for v in vivos:
            if agora - v.get("desde", agora) < 12:
                continue
            if v["buffer"] < 0.4:
                return "apertado"
        return "ok"

    def agendar_saida(self, segundos=6):
        self.cancelar_saida()
        self.timer_saida = threading.Timer(segundos, self.encerrar)
        self.timer_saida.daemon = True
        self.timer_saida.start()

    def cancelar_saida(self):
        if self.timer_saida:
            self.timer_saida.cancel()
            self.timer_saida = None

    def url_publica(self):
        return "%s/v/%s" % (self.tunel.url, self.token) if self.tunel.url else ""

    def urls_diretas(self):
        saida = ["http://%s:%d/v/%s" % (ip_local(), self.porta_publica, self.token)]
        for ip in ips_v6()[:1]:
            saida.append("http://[%s]:%d/v/%s" % (ip, self.porta_publica, self.token))
        return saida

    def encerrar(self):
        if self.encerrando:
            return
        self.encerrando = True
        log("encerrando")
        self.salvar()
        for acao in (self.captura.parar, self.tunel.parar, self.mesa.limpar):
            try:
                acao()
            except Exception:
                pass
        threading.Timer(0.6, lambda: os._exit(0)).start()


