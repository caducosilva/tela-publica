def _probe_encoder(codec, extras=()):
    """Tenta codificar 1 frame; evita escolher encoder so listado (ex.: nvenc sem CUDA)."""
    cmd = [
        FFMPEG_BIN, "-hide_banner", "-loglevel", "error",
        "-f", "lavfi", "-i", "color=c=black:s=320x180:d=0.1",
        "-frames:v", "1", "-c:v", codec,
    ]
    cmd += list(extras)
    cmd += ["-f", "null", "-"]
    try:
        kwargs = dict(capture_output=True, text=True, timeout=6)
        if IS_WINDOWS:
            kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        r = subprocess.run(cmd, **kwargs)
        return r.returncode == 0
    except Exception:
        return False


def encoder_preferido():
    """nvenc/amf/qsv no Windows; vaapi no Linux; senao libx264."""
    if not IS_WINDOWS:
        return "vaapi" if tem_vaapi() else "cpu"
    if _probe_encoder("h264_nvenc", ("-preset", "p4", "-tune", "ll", "-b:v", "1M")):
        return "nvenc"
    if _probe_encoder("h264_amf", ("-b:v", "1M")):
        return "amf"
    if _probe_encoder("h264_qsv", ("-b:v", "1M")):
        return "qsv"
    return "cpu"


