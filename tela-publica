class Manipulador(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "tela-publica/" + VERSAO

    def __init__(self, *a, ctx=None, publico=False, **kw):
        self.ctx = ctx
        self.publico = publico
        super().__init__(*a, **kw)

    def log_message(self, *a):
        pass

    def _quem(self):
        for cab in ("CF-Connecting-IP", "X-Forwarded-For"):
            valor = self.headers.get(cab)
            if valor:
                return valor.split(",")[0].strip()[:45]
        return self.client_address[0]

    def _rota(self):
        p = urllib.parse.urlparse(self.path)
        return p.path, urllib.parse.parse_qs(p.query)

    def _corpo(self):
        """Le e descarta o body. Sempre consome Content-Length (senao o proximo
        request na mesma conexao HTTP/1.1 nasce corrompido, ex.: '{}POST')."""
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except Exception:
            n = 0
        if n <= 0:
            return {}
        try:
            bruto = self.rfile.read(n)
        except Exception:
            return {}
        if n > 8192:
            return {}
        try:
            return json.loads(bruto or b"{}")
        except Exception:
            return {}

    def _json_html(self, obj):
        """JSON seguro para embutir dentro de <script>."""
        return (json.dumps(obj, ensure_ascii=False)
                .replace("<", "\\u003c")
                .replace(">", "\\u003e")
                .replace("&", "\\u0026")
                .replace("\u2028", "\\u2028")
                .replace("\u2029", "\\u2029"))

    def _envia(self, dados, tipo="application/json; charset=utf-8", codigo=200):
        if isinstance(dados, str):
            dados = dados.encode("utf-8")
        self.send_response(codigo)
        self.send_header("Content-Type", tipo)
        self.send_header("Content-Length", str(len(dados)))
        self.send_header("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0")
        self.send_header("Pragma", "no-cache")
        self.send_header("Expires", "0")
        self.end_headers()
        try:
            self.wfile.write(dados)
        except Exception:
            pass

    def _json(self, obj, codigo=200):
        self._envia(json.dumps(obj, ensure_ascii=False), codigo=codigo)

    def do_GET(self):
        self._servir()

    def do_POST(self):
        self._servir()

    def _montar_fontes(self, ctx, forcar_mics=False):
        try:
            janelas = listar_janelas()
        except Exception as e:
            log("erro listar_janelas:", e)
            janelas = []
        try:
            telas = listar_telas()
        except Exception as e:
            log("erro listar_telas:", e)
            telas = []
        try:
            mics = listar_microfones(forcar=forcar_mics)
        except Exception as e:
            log("erro listar_microfones:", e)
            mics = list(_CACHE_MICS["lista"] or [])
        if not mics:
            salvo = (ctx.captura.opcoes.get("microfone") or "").strip()
            if salvo:
                mics = [{"nome": salvo, "rotulo": salvo[:64]}]
            threading.Thread(target=aquecer_cache_mics, daemon=True).start()
        atual = (ctx.captura.opcoes.get("microfone") or "").strip()
        escolhido = preferir_microfone(mics, atual)
        if escolhido and escolhido != atual:
            ctx.captura.opcoes["microfone"] = escolhido
            ctx.salvar()
        return {
            "janelas": janelas,
            "telas": telas,
            "microfones": mics,
            "microfone_atual": ctx.captura.opcoes.get("microfone", ""),
        }

    def _servir(self):
        # Consome o body ANTES de qualquer resposta/atalho.
        corpo = self._corpo() if self.command == "POST" else {}
        rota, q = self._rota()
        ctx = self.ctx
        if self.publico:
            return self._lado_publico(rota, q, corpo)

        if q.get("k", [""])[0] != ctx.chave_painel and rota != "/":
            return self._json({"erro": "chave invalida"}, 403)

        if rota == "/":
            if q.get("k", [""])[0] != ctx.chave_painel:
                return self._envia("Abra pelo atalho Transmitir Tela.", "text/plain; charset=utf-8", 403)
            ctx.viu_painel = True
            ctx.ultimo_ping = time.time()
            ctx.cancelar_saida()
            fontes = self._montar_fontes(ctx, forcar_mics=False)
            log("painel HTML com", len(fontes["janelas"]), "janelas,",
                len(fontes["telas"]), "telas")
            dados = {
                "chave": ctx.chave_painel,
                "opcoes": ctx.captura.opcoes,
                "fontes": fontes,
                "versao": VERSAO,
            }
            corpo_pagina = PAGINA_PAINEL.replace("__DADOS__", self._json_html(dados))
            html = (
                "<!DOCTYPE html><html lang=\"pt-BR\"><head>\n"
                + corpo_pagina
                + "\n</body></html>"
            )
            # PAGINA comeca com <meta>/<style>/<div>; fecha o head no fim do style.
            if "</style>" in html and "</head>" not in html.lower():
                html = html.replace("</style>", "</style></head><body>", 1)
            return self._envia(html, "text/html; charset=utf-8")

        if rota == "/api/fontes":
            forcar_mics = bool(corpo.get("atualizar_mics"))
            fontes = self._montar_fontes(ctx, forcar_mics=forcar_mics)
            log("fontes:", len(fontes["janelas"]), "janelas,",
                len(fontes["telas"]), "telas,",
                len(fontes["microfones"]), "mics | mic=",
                fontes.get("microfone_atual", ""))
            return self._json(fontes)

        if rota == "/api/estado":
            return self._json(self._estado_completo())

        if rota == "/api/opcoes":
            ctx.captura.aplicar(corpo)
            ctx.salvar()
            return self._json(self._estado_completo())

        if rota == "/api/qualidade":
            nome = corpo.get("qualidade") or corpo.get("nome") or ""
            if not nome and "nivel" in corpo:
                try:
                    idx = int(corpo.get("nivel"))
                    if 0 <= idx < len(NIVEIS):
                        nome = NIVEIS[idx]["nome"]
                except Exception:
                    nome = ""
            if not nome:
                return self._json({"erro": "informe qualidade 480p, 720p ou 1080p"}, 400)
            if ctx.captura._indice_qualidade(nome) is None:
                return self._json({"erro": "qualidade invalida (use 480p, 720p ou 1080p)"}, 400)
            ctx.captura.definir_qualidade(nome)
            ctx.salvar()
            return self._json(self._estado_completo())

        if rota == "/api/atraso":
            if not ctx.captura.definir_atraso(corpo.get("atraso")):
                return self._json({"erro": "informe atraso 3, 6 ou 10"}, 400)
            ctx.salvar()
            return self._json(self._estado_completo())

        if rota == "/api/microfone":
            ctx.captura.ajustar_microfone(corpo.get("microfone", ""),
                                          corpo.get("mic_ligado", False))
            ctx.salvar()
            return self._json(self._estado_completo())

        if rota == "/api/iniciar":
            ctx.captura.aplicar(corpo)
            ctx.captura.iniciar()
            ctx.salvar()
            if ctx.tunel.disponivel and not ctx.tunel.url:
                ctx.tunel.iniciar(ctx.porta_publica)
            return self._json(self._estado_completo())

        if rota == "/api/parar":
            ctx.captura.parar()
            return self._json(self._estado_completo())

        if rota == "/api/tunel":
            ctx.tunel.iniciar(ctx.porta_publica)
            return self._json(self._estado_completo())

        if rota == "/api/chat":
            if self.command == "POST" and (corpo.get("texto") is not None or corpo.get("nome") is not None):
                ok, erro, espera = ctx.chat.enviar("painel", corpo.get("nome"),
                                                   corpo.get("texto"))
                return self._json({"ok": ok, "erro": erro, "espera": espera})
            desde = int((q.get("desde", ["0"])[0] or "0").isdigit() and
                        q.get("desde", ["0"])[0] or 0)
            return self._json(ctx.chat.recentes(desde))

        if rota == "/api/ping":
            ctx.viu_painel = True
            ctx.ultimo_ping = time.time()
            ctx.cancelar_saida()
            return self._json({"ok": True})

        if rota == "/api/encerrar":
            self._json({"ok": True})
            if q.get("agora", [""])[0] == "1":
                ctx.encerrar()
            else:
                ctx.agendar_saida()
            return

        return self._json({"erro": "rota desconhecida"}, 404)

    def _estado_completo(self):
        ctx = self.ctx
        e = ctx.captura.estado_atual()
        agora = time.time()
        saude = ctx.saude()
        with ctx.captura.trava:
            conexao = ctx.captura.diagnostico_conexao(saude)
        e.update({
            "url_publica": ctx.url_publica(),
            "urls_diretas": ctx.urls_diretas(),
            "tunel": ctx.tunel.estado,
            "tunel_disponivel": ctx.tunel.disponivel,
            "visores": [v for v in ctx.visores.values() if agora - v["quando"] < 15],
            "adaptacao": ctx.adaptador.diagnostico(),
            "saude": saude,
            "conexao": conexao,
            "problemas": ctx.problemas,
            "versao": VERSAO,
        })
        return e

    def _lado_publico(self, rota, q, corpo=None):
        ctx = self.ctx
        if corpo is None:
            corpo = {}
        token = rota[3:] if rota.startswith("/v/") else q.get("t", [""])[0]
        try:
            valido = secrets.compare_digest(token, ctx.token)
        except TypeError:
            valido = False
        if not valido:
            return self._envia("Link invalido.", "text/plain", 403)

        if rota.startswith("/v/"):
            return self._envia(PAGINA_VISOR, "text/html; charset=utf-8")

        if rota == "/stream":
            return self._fluxo()

        if rota == "/chat":
            if self.command == "POST" and (corpo.get("texto") is not None or corpo.get("nome") is not None):
                ok, erro, espera = ctx.chat.enviar(self._quem(), corpo.get("nome"),
                                                   corpo.get("texto"))
                return self._json({"ok": ok, "erro": erro, "espera": espera})
            bruto = q.get("desde", ["0"])[0]
            return self._json(ctx.chat.recentes(int(bruto) if bruto.isdigit() else 0))

        if rota == "/sinal":
            info = corpo
            agora = time.time()
            chave = self._quem()
            antes = ctx.visores.get(chave) or {}
            ctx.visores[chave] = {
                "tocando": bool(info.get("tocando")),
                "buffer": round(float(info.get("buffer") or 0), 1),
                "quando": agora,
                "desde": antes.get("desde", agora),
            }
            with ctx.captura.trava:
                qnome = NIVEIS[ctx.captura.nivel]["nome"]
            return self._json({"ok": True, "qualidade": qnome,
                               "atraso": ctx.captura.atraso_atual(),
                               "niveis": [n["nome"] for n in NIVEIS]})

        if rota == "/qualidade":
            nome = (corpo.get("qualidade") or corpo.get("nome") or "").strip()
            if not nome:
                return self._json({"ok": False, "erro": "informe 480p, 720p ou 1080p"}, 400)
            if ctx.captura._indice_qualidade(nome) is None:
                return self._json({"ok": False, "erro": "qualidade invalida"}, 400)
            ctx.captura.definir_qualidade(nome)
            ctx.salvar()
            with ctx.captura.trava:
                atual = NIVEIS[ctx.captura.nivel]["nome"]
            return self._json({"ok": True, "qualidade": atual,
                               "atraso": ctx.captura.atraso_atual()})

        return self._envia("Nao encontrado.", "text/plain", 404)

    def _fluxo(self):
        assinante, inicial, mime = self.ctx.captura.assinar()
        if not assinante:
            return self._envia("Transmissao parada.", "text/plain", 404)
        try:
            self.send_response(200)
            self.send_header("Content-Type", "video/mp4")
            self.send_header("X-Mime", mime)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            self._pedaco(inicial)
            while True:
                try:
                    dados = assinante.fila.get(timeout=20)
                except queue.Empty:
                    break
                if dados is None:
                    break
                self._pedaco(dados)
            self._pedaco(b"")
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            self.ctx.captura.desassinar(assinante)

    def _pedaco(self, dados):
        self.wfile.write(b"%X\r\n" % len(dados))
        if dados:
            self.wfile.write(dados)
        self.wfile.write(b"\r\n")
        self.wfile.flush()


class Servidor(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = False
    block_on_close = False

    def __init__(self, sock, handler):
        self.socket = sock
        self.server_address = sock.getsockname()
        socketserver.BaseServer.__init__(self, self.server_address, handler)
        self.socket.listen(64)

    def handle_error(self, request, client_address):
        pass


def instalar_cloudflared():
    destino = CLOUDFLARED_BIN
    url = ("https://github.com/cloudflare/cloudflared/releases/latest/download/" +
           ("cloudflared-windows-amd64.exe" if IS_WINDOWS else "cloudflared-linux-amd64"))
    print("Baixando o cloudflared para criar links públicos de transmissão...")
    print("  origem:  " + url)
    print("  destino: " + destino)
    os.makedirs(os.path.dirname(destino), exist_ok=True)
    urllib.request.urlretrieve(url, destino + ".tmp")
    if not IS_WINDOWS:
        os.chmod(destino + ".tmp", 0o755)
    os.replace(destino + ".tmp", destino)
    print("Pronto! Cloudflared instalado com sucesso:")
    subprocess.run([destino, "--version"])
    return 0


def achar_chrome():
    if IS_WINDOWS:
        candidatos = [
            shutil.which("chrome"),
            os.path.expandvars(r"%ProgramFiles%\Google\Chrome\Application\chrome.exe"),
            os.path.expandvars(r"%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe"),
            os.path.expandvars(r"%LocalAppData%\Google\Chrome\Application\chrome.exe"),
        ]
        for c in candidatos:
            if c and os.path.isfile(c):
                return c
        return None
    for nome in ("google-chrome", "google-chrome-stable", "chromium",
                 "chromium-browser"):
        caminho = shutil.which(nome)
        if caminho:
            return caminho
    return None


def abrir_navegador(url):
    """Abre sempre no Google Chrome quando disponivel."""
    chrome = achar_chrome()
    if chrome:
        try:
            # DETACHED para o Chrome nao herdar o console (evita fechar junto).
            flags = 0
            if IS_WINDOWS:
                flags = (
                    getattr(subprocess, "DETACHED_PROCESS", 0x00000008)
                    | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0x00000200)
                )
            subprocess.Popen(
                [chrome, "--new-window", "--new-tab", url],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                creationflags=flags if IS_WINDOWS else 0,
                start_new_session=(not IS_WINDOWS),
                close_fds=True)
            log("abrindo painel no Chrome")
            return True
        except Exception as e:
            log("falha ao abrir Chrome:", e)

    if IS_WINDOWS:
        try:
            os.startfile(url)
            log("Chrome nao encontrado; abrindo navegador padrao")
            return True
        except Exception:
            subprocess.Popen(["start", "", url], shell=True)
            return True

    for nome in ("firefox",):
        caminho = shutil.which(nome)
        if caminho:
            subprocess.Popen([caminho, url], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return False


def registrar_saida_console(ctx):
    """No Windows, fechar o terminal tambem libera porta e tunel."""
    if not IS_WINDOWS:
        return

    Handler = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.DWORD)

    @Handler
    def _handler(ctrl_type):
        # So reage a fechar janela / logoff / shutdown.
        # CTRL_C e CTRL_BREAK ficam com o signal do Python.
        if ctrl_type in (2, 5, 6):
            try:
                ctx.encerrar()
            except Exception:
                pass
            time.sleep(1.2)
            return True
        return False

    ctypes.windll.kernel32.SetConsoleCtrlHandler(_handler, True)
    ctx._console_handler = _handler


def aguardar_porta(host, porta, timeout=5.0):
    fim = time.time() + timeout
    while time.time() < fim:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.3)
        try:
            if s.connect_ex((host, porta)) == 0:
                s.close()
                return True
        except Exception:
            pass
        finally:
            try:
                s.close()
            except Exception:
                pass
        time.sleep(0.05)
    return False


def vigia_painel(ctx):
    while True:
        time.sleep(20)
        if ctx.viu_painel and time.time() - ctx.ultimo_ping > LIMITE_SEM_PING:
            log("painel sumiu, encerrando")
            ctx.encerrar()
            return


def main():
    args = sys.argv[1:]
    if "--instalar-cloudflared" in args:
        return instalar_cloudflared()
    if {"--ajuda", "-h", "--help"} & set(args):
        print(__doc__)
        print("Opcoes:")
        print("  --sem-navegador          nao abre o navegador sozinho")
        print("  --sem-tunel              nao cria o link publico")
        print("  --porta N                porta preferida para quem assiste")
        print("  --instalar-cloudflared   baixa o cloudflared para a pasta de cache")
        return 0

    os.makedirs(DIR_CACHE, exist_ok=True)
    if not garantir_instancia_unica():
        time.sleep(1.2)
        return 0

    if not sys.stdout.isatty():
        sys.stdout = sys.stderr = open(ARQ_LOG, "a", buffering=1)
    else:
        print(MARCA)

    problemas = verificar_ambiente()
    for p in problemas:
        log("ATENCAO:", p["texto"], "->", p["solucao"])
    if any(p["grave"] for p in problemas):
        log("Corrija os pontos acima e abra de novo.")

    preferida = PORTA_PREFERIDA
    if "--porta" in args:
        try:
            preferida = int(args[args.index("--porta") + 1])
        except Exception:
            pass

    # Cache de mics em background pra nao travar o painel.
    threading.Thread(target=aquecer_cache_mics, daemon=True).start()

    ctx = Contexto()
    sock_pub = porta_livre("0.0.0.0", preferida)
    sock_pai = porta_livre("127.0.0.1", 0)
    ctx.porta_publica = sock_pub.getsockname()[1]
    ctx.porta_painel = sock_pai.getsockname()[1]

    srv_pub = Servidor(sock_pub, partial(Manipulador, ctx=ctx, publico=True))
    srv_pai = Servidor(sock_pai, partial(Manipulador, ctx=ctx, publico=False))
    ctx.servidores = [srv_pub, srv_pai]
    threading.Thread(target=srv_pub.serve_forever, daemon=True).start()
    threading.Thread(target=srv_pai.serve_forever, daemon=True).start()

    log("tela-publica", VERSAO, "| publica", ctx.porta_publica,
        "| painel", ctx.porta_painel)
    if preferida and ctx.porta_publica != preferida:
        log("porta", preferida, "ocupada; usando", ctx.porta_publica)

    if "--sem-tunel" not in args and ctx.tunel.disponivel:
        ctx.tunel.iniciar(ctx.porta_publica)
        log("tunel cloudflared apontando para 127.0.0.1:%d" % ctx.porta_publica)
    elif "--sem-tunel" not in args:
        log("cloudflared ausente; rode com --instalar-cloudflared para link publico")

    atexit.register(ctx.encerrar)
    registrar_saida_console(ctx)
    for s in (signal.SIGINT, signal.SIGTERM):
        try:
            signal.signal(s, lambda *_: ctx.encerrar())
        except Exception:
            pass
    if hasattr(signal, "SIGBREAK"):
        try:
            signal.signal(signal.SIGBREAK, lambda *_: ctx.encerrar())
        except Exception:
            pass

    url_painel = "http://127.0.0.1:%d/?k=%s" % (ctx.porta_painel, ctx.chave_painel)
    salvar_url_painel(url_painel)
    log("painel:", url_painel)

    if not aguardar_porta("127.0.0.1", ctx.porta_painel, 5.0):
        log("aviso: painel ainda nao respondeu na porta", ctx.porta_painel)
    try:
        n_jan = len(listar_janelas())
        log("janelas detectadas na subida:", n_jan)
    except Exception as e:
        log("falha ao listar janelas na subida:", e)

    if "--sem-navegador" not in args:
        abrir_navegador(url_painel)

    threading.Thread(target=vigia_painel, args=(ctx,), daemon=True).start()
    try:
        while not ctx.encerrando:
            time.sleep(0.5)
    except KeyboardInterrupt:
        ctx.encerrar()
    return 0


if __name__ == "__main__":
    sys.exit(main())
