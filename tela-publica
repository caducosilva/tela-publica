class Captura:
    def __init__(self, mesa):
        self.trava = threading.RLock()
        self.mesa = mesa
        self.opcoes = dict(PADRAO)
        self.nivel = NIVEL_PADRAO
        self.codificador = encoder_preferido()
        self.gen = 0
        self.proc = None
        self.init_seg = None
        self.mime = ""
        self.assinantes = set()
        self.deve_rodar = False
        self.estado = "parado"
        self.erro = ""
        self.aviso_nivel = ""
        self.registro = []
        self.velocidade = ""
        self.bytes_janela = 0
        self.kbps_real = 0
        self.inicio = 0
        self.falhas = 0
        self.quedas = 0
        self.dimensoes = ""
        self.pausado_por_janela = False
        # printwindow = PrintWindow (funciona coberta); titulo/regiao = fallback gdigrab
        self._modo_janela = "printwindow"
        self._feeder_stop = threading.Event()
        self._feeder_thread = None
        self._cap_wh = (0, 0)
        self._wasapi = None
        self._wasapi_porta = 0
        self._audio_inputs = []
        threading.Thread(target=self._medidor, daemon=True).start()
        threading.Thread(target=self._vigia_janela, daemon=True).start()

    def aplicar(self, novas):
        with self.trava:
            alvo_antes = self.opcoes.get("alvo")
            for k in PADRAO:
                if k in novas:
                    self.opcoes[k] = novas[k]
            if "qualidade" in novas:
                self._aplicar_qualidade_nome(novas["qualidade"], reiniciar=False)
            if self.opcoes.get("alvo") != alvo_antes:
                self._modo_janela = "printwindow"
            rodando = self.deve_rodar
        self._ajustar_som()
        if rodando:
            with self.trava:
                self._parar_processo()
                self._iniciar_processo()

    def _indice_qualidade(self, nome):
        nome = (nome or "").strip().lower().replace(" ", "")
        for i, n in enumerate(NIVEIS):
            if n["nome"].lower() == nome:
                return i
        if nome in ("480", "480p30", "sd"):
            return 0
        if nome in ("720", "720p30"):
            return 1
        if nome in ("1080", "1080p30", "fullhd"):
            return 2
        return None

    def _aplicar_qualidade_nome(self, nome, reiniciar=True):
        idx = self._indice_qualidade(nome)
        if idx is None:
            return False
        if idx == self.nivel:
            self.opcoes["qualidade"] = NIVEIS[idx]["nome"]
            return False
        self.nivel = idx
        self.opcoes["qualidade"] = NIVEIS[idx]["nome"]
        self.aviso_nivel = ""
        log("qualidade ->", NIVEIS[idx]["nome"])
        if reiniciar and self.deve_rodar:
            self._parar_processo()
            self._iniciar_processo()
        return True

    def definir_qualidade(self, nome):
        with self.trava:
            ok = self._aplicar_qualidade_nome(nome, reiniciar=True)
            return ok or self._indice_qualidade(nome) is not None

    def definir_atraso(self, segundos):
        try:
            n = int(segundos)
        except (TypeError, ValueError):
            return False
        if n not in ATRASOS_OK:
            return False
        with self.trava:
            if self.opcoes.get("atraso") == n:
                return True
            self.opcoes["atraso"] = n
            log("atraso do host ->", n, "s")
            return True

    def atraso_atual(self):
        with self.trava:
            n = self.opcoes.get("atraso", ATRASO_PADRAO)
        try:
            n = int(n)
        except (TypeError, ValueError):
            n = ATRASO_PADRAO
        return n if n in ATRASOS_OK else ATRASO_PADRAO

    def ajustar_microfone(self, nome, ligado):
        with self.trava:
            self.opcoes["microfone"] = nome or ""
            self.opcoes["mic_ligado"] = bool(ligado)
            rodando = self.deve_rodar
        self.mesa.definir_microfone(nome, ligado)
        # No Windows o mic entra pelo ffmpeg; precisa religar o processo.
        if IS_WINDOWS and rodando:
            with self.trava:
                self._parar_processo()
                self._iniciar_processo()

    def iniciar(self):
        self._ajustar_som()
        with self.trava:
            self.deve_rodar = True
            self.pausado_por_janela = False
            self.falhas = 0
            # Mantem a qualidade escolhida; so sincroniza o nome.
            self.nivel = max(0, min(len(NIVEIS) - 1, self.nivel))
            self.opcoes["qualidade"] = NIVEIS[self.nivel]["nome"]
            self.aviso_nivel = ""
            self._modo_janela = "printwindow"
            self._parar_processo()
            self._iniciar_processo()

    def parar(self):
        with self.trava:
            self.deve_rodar = False
            self.pausado_por_janela = False
            self._parar_processo()
            self.estado = "parado"
            self.erro = ""
        self.mesa.desligar()

    def _ajustar_som(self):
        with self.trava:
            alvo = self.opcoes["alvo"]
            mic, ligado = self.opcoes["microfone"], self.opcoes["mic_ligado"]
        tipo, _, ref = alvo.partition(":")
        if tipo == "janela":
            janela = next((j for j in listar_janelas() if str(j["id"]) == str(ref)), None)
            if janela:
                self.mesa.definir_janela(janela["pid"], [janela["classe"], janela["app"]])
            else:
                self.mesa.desligar()
        elif tipo == "tela":
            self.mesa.definir_tela_inteira()
        else:
            self.mesa.desligar()
        self.mesa.definir_microfone(mic, ligado)

    def _parar_processo(self):
        self._feeder_stop.set()
        if self._wasapi:
            try:
                self._wasapi.parar()
            except Exception:
                pass
            self._wasapi = None
        p, self.proc = self.proc, None
        self.init_seg = None
        for a in list(self.assinantes):
            a.encerrar()
        self.assinantes.clear()
        if p is not None:
            try:
                if p.stdin:
                    p.stdin.close()
            except Exception:
                pass
        feeder = self._feeder_thread
        self._feeder_thread = None
        if feeder and feeder.is_alive() and feeder is not threading.current_thread():
            try:
                feeder.join(timeout=1.5)
            except Exception:
                pass
        if p and p.poll() is None:
            try:
                p.terminate()
                p.wait(timeout=3)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass

    def _iniciar_processo(self):
        if not self.opcoes["alvo"]:
            self.estado = "escolha uma janela"
            return
        tipo, _, ref = self.opcoes["alvo"].partition(":")
        usar_pipe = False
        if tipo == "janela" and IS_WINDOWS:
            # Nao rouba foco: so garante que nao esta minimizada.
            if not garantir_janela_capturavel(ref):
                self.estado = "janela minimizada"
                self.erro = ("Essa janela esta minimizada. Restaure ela na tela "
                             "(pode ficar atras de outras) para transmitir.")
                self.deve_rodar = False
                return
            if getattr(self, "_modo_janela", "printwindow") == "printwindow":
                w, h = tamanho_janela_captura(ref)
                if w >= 16 and h >= 16:
                    self._cap_wh = (w, h)
                    usar_pipe = True
                else:
                    log("PrintWindow sem tamanho util (janela minimizada?)")
                    self._cap_wh = (0, 0)

        cmd = self._montar_comando()
        self.dimensoes = "%dx%d" % (NIVEIS[self.nivel]["larg"], NIVEIS[self.nivel]["alt"])
        self.gen += 1
        gen = self.gen
        self.mime = self._mime()
        self.registro = []
        self.erro = ""
        self.velocidade = ""
        self.inicio = time.time()
        log("captura gen", gen, "nivel", self.nivel, NIVEIS[self.nivel]["nome"],
            self.codificador, "alvo", self.opcoes["alvo"], "modo",
            getattr(self, "_modo_janela", ""),
            "size", "%dx%d" % self._cap_wh if usar_pipe else "-",
            "audio", (self.mesa.monitor() or ("?",))[0])
        try:
            # WASAPI / audio do processo: sobe o TCP antes do ffmpeg conectar.
            if IS_WINDOWS:
                fonte = self.mesa.monitor()
                if fonte and fonte[0] in ("wasapi", "wasapi_proc"):
                    try:
                        if fonte[0] == "wasapi_proc":
                            self._wasapi = WasapiProcessLoopback(fonte[1], include=True)
                        else:
                            self._wasapi = WasapiLoopback()
                        porta = self._wasapi.preparar()
                        self._wasapi_porta = porta
                        cmd = self._montar_comando()
                    except Exception as e:
                        log("audio wasapi indisponivel:", e)
                        if self._wasapi:
                            try:
                                self._wasapi.parar()
                            except Exception:
                                pass
                        self._wasapi = None
                        self._wasapi_porta = 0
                        cmd = self._montar_comando()
            kwargs = dict(
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                bufsize=0, env=ambiente())
            if usar_pipe:
                kwargs["stdin"] = subprocess.PIPE
            else:
                kwargs["stdin"] = subprocess.DEVNULL
            if IS_WINDOWS:
                kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            self.proc = subprocess.Popen(cmd, **kwargs)
        except FileNotFoundError:
            if self._wasapi:
                self._wasapi.parar()
                self._wasapi = None
            self.estado = "erro"
            self.erro = "FFmpeg nao encontrado. No Windows: winget install Gyan.FFmpeg"
            return
        except Exception as e:
            if self._wasapi:
                self._wasapi.parar()
                self._wasapi = None
            self.estado = "erro"
            self.erro = "Falha ao iniciar captura: %s" % e
            log("iniciar captura:", e)
            return
        self.estado = "iniciando"
        threading.Thread(target=self._leitor, args=(self.proc, gen), daemon=True).start()
        threading.Thread(target=self._erros, args=(self.proc, gen), daemon=True).start()
        if usar_pipe:
            self._feeder_stop.clear()
            self._feeder_thread = threading.Thread(
                target=self._alimentar_printwindow,
                args=(self.proc, gen, ref, NIVEIS[self.nivel]["fps"]),
                daemon=True)
            self._feeder_thread.start()

    def _alimentar_printwindow(self, proc, gen, jid, fps):
        """Envia frames BGR da HWND para o stdin do ffmpeg (janela coberta ok)."""
        intervalo = 1.0 / max(1, int(fps or 30))
        hwnd = int(str(jid), 0)
        falhas = 0
        pendente_resize = None
        ultimo_frame = None
        aviso_min = 0.0
        while not self._feeder_stop.is_set():
            t0 = time.perf_counter()
            with self.trava:
                if gen != self.gen or proc is not self.proc or not self.deve_rodar:
                    break
                w0, h0 = self._cap_wh
            if not ctypes.windll.user32.IsWindow(hwnd):
                log("PrintWindow: janela fechada")
                break
            w, h = tamanho_janela_captura(hwnd)
            if w < 16 or h < 16:
                falhas += 1
                # Minimizada de verdade: tenta restaurar sem roubar foco.
                # Enquanto isso reenvia o ultimo frame (stream nao cai).
                if falhas == 1 or falhas % 40 == 0:
                    garantir_janela_capturavel(hwnd)
                if ultimo_frame is not None:
                    frame = ultimo_frame
                    agora = time.perf_counter()
                    if agora - aviso_min > 8:
                        log("PrintWindow: janela sem tamanho (minimizou?); mantendo ultimo frame")
                        aviso_min = agora
                else:
                    frame = bytes(w0 * h0 * 3)
                    time.sleep(0.05)
                    try:
                        proc.stdin.write(frame)
                        proc.stdin.flush()
                    except (BrokenPipeError, OSError, ValueError):
                        break
                    continue
            else:
                # Ignora trepidacao de 1-2px (borda DWM). So reinicia se mudou de verdade.
                if abs(w - w0) > 16 or abs(h - h0) > 16:
                    if pendente_resize is None:
                        pendente_resize = (w, h, time.perf_counter())
                    else:
                        pw, ph, pt = pendente_resize
                        if abs(w - pw) <= 8 and abs(h - ph) <= 8 and (time.perf_counter() - pt) >= 0.6:
                            log("PrintWindow: tamanho mudou %dx%d -> %dx%d, reiniciando" % (w0, h0, w, h))
                            with self.trava:
                                if gen == self.gen and self.deve_rodar:
                                    self._cap_wh = (w, h)
                                    threading.Thread(target=self._reiniciar_suave, daemon=True).start()
                            return
                        if abs(w - pw) > 8 or abs(h - ph) > 8:
                            pendente_resize = (w, h, time.perf_counter())
                else:
                    pendente_resize = None
                # Sempre captura no tamanho travado do processo ffmpeg (w0xh0).
                frame = capturar_hwnd_bgr(hwnd, w0, h0)
                if frame is None or len(frame) < w0 * h0 * 3:
                    falhas += 1
                    frame = ultimo_frame if ultimo_frame is not None else bytes(w0 * h0 * 3)
                    if falhas == 30:
                        log("PrintWindow: frames vazios (app pode usar DirectX puro)")
                else:
                    if len(frame) > w0 * h0 * 3:
                        frame = frame[:w0 * h0 * 3]
                    ultimo_frame = frame
                    falhas = 0
            try:
                proc.stdin.write(frame)
                proc.stdin.flush()
            except (BrokenPipeError, OSError, ValueError):
                break
            restante = intervalo - (time.perf_counter() - t0)
            if restante > 0:
                fim = time.perf_counter() + restante
                while time.perf_counter() < fim and not self._feeder_stop.is_set():
                    time.sleep(min(0.005, max(0.0, fim - time.perf_counter())))
        try:
            if proc.stdin:
                proc.stdin.close()
        except Exception:
            pass

    def _reiniciar_suave(self):
        time.sleep(0.05)
        with self.trava:
            if not self.deve_rodar:
                return
            self._parar_processo()
            self._iniciar_processo()

    def _montar_comando(self):
        n = NIVEIS[self.nivel]
        tipo, _, ref = self.opcoes["alvo"].partition(":")
        modo = getattr(self, "_modo_janela", "printwindow")
        usar_pipe = (IS_WINDOWS and tipo == "janela" and modo == "printwindow"
                     and self._cap_wh[0] >= 16)

        cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning"]
        if not usar_pipe:
            cmd.append("-nostdin")
        tem_audio = False

        if IS_WINDOWS:
            if tipo == "janela" and usar_pipe:
                w, h = self._cap_wh
                cmd += [
                    "-f", "rawvideo", "-pix_fmt", "bgr24",
                    "-s:v", "%dx%d" % (w, h),
                    "-r", str(n["fps"]),
                    "-thread_queue_size", "64",
                    "-i", "pipe:0",
                ]
            elif tipo == "janela":
                # Sem PrintWindow (tamanho invalido): ainda evita gdigrab de
                # regiao, que transmite o que esta na frente (YouTube etc).
                janela = next((j for j in listar_janelas()
                               if str(j["id"]) == str(ref)), None)
                titulo = titulo_janela(ref) or ((janela or {}).get("titulo") or "")
                if titulo.strip():
                    log("aviso: PrintWindow indisponivel, tentando title= (pode falhar coberta)")
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "title=%s" % titulo]
                else:
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "desktop"]
            else:
                tela = next((t for t in listar_telas() if t["nome"] == ref), None) \
                    or (listar_telas()[0] if listar_telas() else None)
                if tela and (tela["x"] or tela["y"]):
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-offset_x", str(tela["x"]), "-offset_y", str(tela["y"]),
                            "-video_size", "%dx%d" % (tela["w"], tela["h"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "desktop"]
                else:
                    cmd += ["-f", "gdigrab", "-framerate", str(n["fps"]),
                            "-thread_queue_size", "1024", "-draw_mouse", "0",
                            "-i", "desktop"]

            # Audio: processo (janela), Stereo Mix/Cable, ou WASAPI geral via TCP.
            fonte = self.mesa.monitor()
            mic = self.opcoes.get("microfone") or ""
            mic_on = bool(self.opcoes.get("mic_ligado") and mic)
            audio_inputs = []  # ("dshow"|"wasapi"|"pulse", nome_ou_porta)
            if fonte:
                if fonte[0] == "dshow":
                    audio_inputs.append(("dshow", fonte[1]))
                elif fonte[0] in ("wasapi", "wasapi_proc"):
                    porta = getattr(self, "_wasapi_porta", 0) or (
                        self._wasapi.porta if self._wasapi else 0)
                    if porta:
                        audio_inputs.append(("wasapi", porta))
            if mic_on:
                if not any(t == "dshow" and r == mic for t, r in audio_inputs):
                    audio_inputs.append(("dshow", mic))
            for tipo_a, ref_a in audio_inputs:
                if tipo_a == "dshow":
                    cmd += ["-f", "dshow", "-thread_queue_size", "1024",
                            "-i", "audio=%s" % ref_a]
                elif tipo_a == "wasapi":
                    # PCM cru: timestamps por taxa de amostragem (nao wallclock),
                    # senao o muxer MP4 explode com DTS gigante.
                    cmd += [
                        "-f", "s16le", "-ar", "48000", "-ac", "2",
                        "-channel_layout", "stereo",
                        "-thread_queue_size", "1024",
                        "-i", "tcp://127.0.0.1:%d" % int(ref_a),
                    ]
            tem_audio = bool(audio_inputs)
            self._audio_inputs = audio_inputs

        else:
            display = ambiente()["DISPLAY"]
            gpu = self.codificador == "vaapi" and tem_vaapi()
            if gpu:
                cmd += ["-vaapi_device", RENDER_NODE]

            cmd += ["-f", "x11grab", "-framerate", str(n["fps"]),
                    "-thread_queue_size", "1024", "-draw_mouse", "0"]

            if tipo == "janela":
                cmd += ["-window_id", ref, "-i", display]
            else:
                telas = listar_telas()
                tela = next((t for t in telas if t["nome"] == ref), None) or \
                    (telas[0] if telas else {"w": 1920, "h": 1080, "x": 0, "y": 0})
                cmd += ["-video_size", "%dx%d" % (tela["w"], tela["h"]),
                        "-i", "%s+%d,%d" % (display, tela["x"], tela["y"])]

            fonte = self.mesa.monitor()
            if fonte and fonte[0] == "pulse" and fonte[1]:
                cmd += ["-f", "pulse", "-thread_queue_size", "1024", "-i", fonte[1]]
                tem_audio = True
                self._audio_inputs = [("pulse", fonte[1])]
            else:
                self._audio_inputs = []

        # Escala para o nivel escolhido (480p/720p/1080p) @ 30fps CFR.
        larg, alt, fps = n["larg"], n["alt"], n["fps"]
        if self.codificador == "vaapi" and tem_vaapi() and not IS_WINDOWS:
            filtros = (
                "fps=%d,"
                "scale=%d:%d:force_original_aspect_ratio=decrease:flags=bicubic,"
                "pad=%d:%d:(ow-iw)/2:(oh-ih)/2,format=nv12,hwupload"
                % (fps, larg, alt, larg, alt)
            )
        else:
            filtros = (
                "fps=%d,"
                "scale=%d:%d:force_original_aspect_ratio=decrease:flags=bicubic,"
                "pad=%d:%d:(ow-iw)/2:(oh-ih)/2,format=yuv420p"
                % (fps, larg, alt, larg, alt)
            )
        cmd += ["-vf", filtros, "-r", str(fps), "-fps_mode", "cfr"]

        gop = str(fps * 2)
        k = n["kbps"]
        enc = self.codificador
        if enc == "nvenc":
            cmd += ["-c:v", "h264_nvenc", "-preset", "p4", "-tune", "ll",
                    "-rc", "vbr", "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2), "-g", gop, "-bf", "0"]
        elif enc == "amf":
            cmd += ["-c:v", "h264_amf", "-quality", "speed",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2), "-g", gop]
        elif enc == "qsv":
            cmd += ["-c:v", "h264_qsv", "-preset", "veryfast",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2), "-g", gop]
        elif enc == "vaapi" and tem_vaapi() and not IS_WINDOWS:
            cmd += ["-c:v", "h264_vaapi", "-profile:v", "high", "-level", "42",
                    "-rc_mode", "CQP", "-qp", str(n["qp"]), "-g", gop, "-bf", "0"]
        else:
            cmd += ["-c:v", "libx264", "-preset", "veryfast",
                    "-profile:v", "high", "-level", "4.2",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2),
                    "-g", gop, "-keyint_min", gop, "-sc_threshold", "0", "-bf", "2",
                    "-x264-params", "force-cfr=1"]

        if tem_audio:
            entradas = getattr(self, "_audio_inputs", []) or []
            af = "volume=%.2f,aresample=async=1000:first_pts=0" % AUDIO_GANHO
            if len(entradas) > 1:
                mapas = ["[%d:a]" % (i + 1) for i in range(len(entradas))]
                cmd += ["-filter_complex",
                        "".join(mapas) +
                        "amix=inputs=%d:duration=first:dropout_transition=0,"
                        "%s[aout]" % (len(mapas), af),
                        "-map", "0:v:0", "-map", "[aout]",
                        "-c:a", "aac", "-b:a", "256k", "-ar", "48000", "-ac", "2"]
            else:
                cmd += ["-c:a", "aac", "-b:a", "256k", "-ar", "48000", "-ac", "2",
                        "-af", af,
                        "-map", "0:v:0", "-map", "1:a:0"]
        else:
            cmd += ["-an", "-map", "0:v:0"]

        cmd += ["-fflags", "+genpts",
                "-avoid_negative_ts", "make_zero",
                "-movflags", "+frag_keyframe+empty_moov+default_base_moof",
                "-flush_packets", "1", "-stats_period", "3",
                "-progress", "pipe:2", "-f", "mp4", "pipe:1"]
        return cmd

    def _mime(self):
        # Sem audio o MSE aceita so AVC; com som inclui AAC.
        if IS_WINDOWS:
            fonte = self.mesa.monitor()
            mic_on = bool(self.opcoes.get("mic_ligado") and self.opcoes.get("microfone"))
            if fonte or mic_on:
                return 'video/mp4; codecs="avc1.64002A, mp4a.40.2"'
            return 'video/mp4; codecs="avc1.64002A"'
        if self.mesa.monitor():
            return 'video/mp4; codecs="avc1.64002A, mp4a.40.2"'
        return 'video/mp4; codecs="avc1.64002A"'

    def mudar_nivel(self, delta, motivo=""):
        with self.trava:
            novo = max(0, min(len(NIVEIS) - 1, self.nivel + delta))
            if novo == self.nivel:
                return False
            self.nivel = novo
            self.opcoes["qualidade"] = NIVEIS[novo]["nome"]
            self.aviso_nivel = motivo or ""
            log("qualidade ->", NIVEIS[novo]["nome"], motivo)
            if self.deve_rodar:
                self._parar_processo()
                self._iniciar_processo()
            return True

    def diagnostico_conexao(self, saude="sem publico"):
        """Texto curto sobre banda e se a transmissao esta ok."""
        n = NIVEIS[self.nivel]
        kbps = self.kbps_real
        alvo = n["kbps"]
        entupido = any(a.fila.qsize() >= Assinante.ATRASO for a in self.assinantes)
        if not self.deve_rodar:
            status = "parado"
            detalhe = "Transmissao desligada."
        elif self.estado == "erro":
            status = "erro"
            detalhe = self.erro or "Falha na captura."
        elif self.estado in ("iniciando", "reconectando"):
            status = "iniciando"
            detalhe = "Subindo o video..."
        elif self.estado == "janela minimizada":
            status = "pausado"
            detalhe = "Janela minimizada. Restaure para continuar."
        elif self.estado == "janela fechada":
            status = "erro"
            detalhe = "Janela fechada."
        elif self.estado != "no ar":
            status = "aviso"
            detalhe = self.estado or "Aguardando..."
        elif entupido or saude == "apertado":
            status = "apertado"
            detalhe = ("Conexao apertada: quem assiste pode travar. "
                       "Se continuar, troque para 720p.")
        elif saude == "sem publico":
            status = "ok"
            detalhe = "Transmitindo. Ninguem assistindo ainda."
        else:
            status = "ok"
            detalhe = "Conexao ok. Transmitindo normalmente."
        return {
            "status": status,
            "detalhe": detalhe,
            "kbps": kbps,
            "kbps_alvo": alvo,
            "mbps": round(kbps / 1000.0, 2),
            "mbps_alvo": round(alvo / 1000.0, 2),
            "espectadores": len(self.assinantes),
            "fila_cheia": entupido,
            "saude": saude,
        }

    @staticmethod
    def _proxima_caixa(buf):
        if len(buf) < 8:
            return None
        tamanho = int.from_bytes(buf[0:4], "big")
        tipo = bytes(buf[4:8])
        if tamanho == 1:
            if len(buf) < 16:
                return None
            tamanho = int.from_bytes(buf[8:16], "big")
        if tamanho < 8:
            raise ValueError("caixa mp4 invalida")
        if len(buf) < tamanho:
            return None
        dados = bytes(buf[:tamanho])
        del buf[:tamanho]
        return tipo, dados

    def _leitor(self, proc, gen):
        buf, inicial, frag = bytearray(), bytearray(), bytearray()
        pronto = False
        try:
            while True:
                pedaco = proc.stdout.read(65536)
                if not pedaco:
                    break
                buf += pedaco
                while True:
                    try:
                        caixa = self._proxima_caixa(buf)
                    except ValueError:
                        buf.clear()
                        break
                    if caixa is None:
                        break
                    tipo, dados = caixa
                    if not pronto:
                        if tipo in (b"ftyp", b"moov"):
                            inicial += dados
                            if tipo == b"moov":
                                pronto = True
                                with self.trava:
                                    if gen == self.gen:
                                        self.init_seg = bytes(inicial)
                                        self.estado = "no ar"
                                        self.falhas = 0
                        continue
                    if tipo == b"moof":
                        frag = bytearray(dados)
                    elif tipo == b"mdat" and frag:
                        frag += dados
                        self._difundir(gen, bytes(frag))
                        frag = bytearray()
        except Exception as e:
            log("leitor:", e)
        finally:
            self._encerrou(proc, gen)

    def _difundir(self, gen, dados):
        with self.trava:
            if gen != self.gen:
                return
            self.bytes_janela += len(dados)
            for a in list(self.assinantes):
                a.enviar(dados)
                if not a.viva:
                    self.assinantes.discard(a)
                    self.quedas += 1

    CHAVES_PROGRESSO = ("frame=", "fps=", "stream_", "bitrate=", "total_size=",
                        "out_time", "dup_frames=", "drop_frames=", "speed=",
                        "progress=")

    def _erros(self, proc, gen):
        for linha in iter(proc.stderr.readline, b""):
            texto = linha.decode("utf-8", "replace").rstrip()
            if not texto:
                continue
            if texto.startswith(self.CHAVES_PROGRESSO):
                if texto.startswith("speed="):
                    with self.trava:
                        if gen == self.gen:
                            self.velocidade = texto.split("=", 1)[1].strip()
                continue
            with self.trava:
                if gen == self.gen:
                    self.registro.append(texto)
                    del self.registro[:-40]
            log("ffmpeg:", texto)

    def _encerrou(self, proc, gen):
        time.sleep(0.2)
        with self.trava:
            if gen != self.gen:
                return
            codigo = proc.poll()
            for a in list(self.assinantes):
                a.encerrar()
            self.assinantes.clear()
            self.init_seg = None
            if not self.deve_rodar:
                self.estado = "parado"
                return
            self.falhas += 1
            pistas = [l for l in self.registro
                      if "rror" in l or "nvalid" in l or "ailed" in l
                      or "Cannot load" in l or "nvcuda" in l
                      or "Can't find window" in l or "Error opening input" in l]
            self.erro = pistas[-1] if pistas else ("ffmpeg saiu com codigo %s" % codigo)
            # Nunca cai de PrintWindow para gdigrab de janela: titulo/regiao
            # so mostram o que esta visivel (VLC atras do YouTube = lixo).
            tipo_alvo, _, _ = self.opcoes.get("alvo", "").partition(":")
            texto_erro = (self.erro or "").lower()
            parece_encoder = any(x in texto_erro for x in (
                "nvenc", "amf", "qsv", "nvcuda", "h264_qsv", "h264_amf", "h264_nvenc",
                "cannot load", "cuda", "encoder"))
            if IS_WINDOWS and tipo_alvo == "janela":
                self._modo_janela = "printwindow"
                if (self.codificador in ("nvenc", "amf", "qsv") and self.falhas >= 1
                        and parece_encoder):
                    log("encoder", self.codificador, "falhou, caindo para CPU (libx264)")
                    self.codificador = "cpu"
                    self.falhas = 0
                    self.erro = ""
                elif self.falhas >= 8:
                    self.deve_rodar = False
                    self.estado = "erro"
                    return
            elif self.codificador in ("nvenc", "amf", "qsv") and self.falhas >= 1 and parece_encoder:
                log("encoder", self.codificador, "falhou, caindo para CPU (libx264)")
                self.codificador = "cpu"
                self.falhas = 0
                self.erro = ""
            elif self.falhas >= 5:
                self.deve_rodar = False
                self.estado = "erro"
                return
            self.estado = "reconectando"
        time.sleep(1.5)
        with self.trava:
            if self.deve_rodar and gen == self.gen:
                self._parar_processo()
                self._iniciar_processo()

    def _medidor(self):
        while True:
            time.sleep(2)
            with self.trava:
                self.kbps_real = int(self.bytes_janela * 8 / 2 / 1000)
                self.bytes_janela = 0

    def _vigia_janela(self):
        geo_cache = None
        titulo_cache = None
        while True:
            time.sleep(2)
            try:
                with self.trava:
                    tipo, _, ref = self.opcoes["alvo"].partition(":")
                    rodando, pausado = self.deve_rodar, self.pausado_por_janela
                    modo = getattr(self, "_modo_janela", "titulo")
                if tipo != "janela" or not (rodando or pausado):
                    geo_cache = None
                    titulo_cache = None
                    continue
                situacao = estado_janela(ref)
                if situacao == "minimizada" and (rodando or pausado):
                    # Fora da trava: ShowWindow + sleep nao podem travar o encoder.
                    garantir_janela_capturavel(ref)
                    situacao = estado_janela(ref)
                with self.trava:
                    # So para de verdade se a janela foi FECHADA.
                    # Coberta, sem foco ou minimizada: continua (PrintWindow /
                    # restaura sem ativar). Voce pode usar o PC normalmente.
                    if situacao == "sumiu":
                        self.pausado_por_janela = False
                        self.deve_rodar = False
                        self._parar_processo()
                        geo_cache = None
                        titulo_cache = None
                        self.estado = "janela fechada"
                        self.erro = "Essa janela foi fechada. Escolha outra na lista."
                        continue
                    if pausado and situacao != "sumiu":
                        # Retoma se ficou pausado por versao antiga / falso IsIconic.
                        self.pausado_por_janela = False
                        self.deve_rodar = True
                        self.erro = ""
                        self.falhas = 0
                        geo_cache = None
                        titulo_cache = None
                        log("janela ainda aberta, retomando")
                        self._parar_processo()
                        self._iniciar_processo()
                        continue
                    if situacao in ("visivel", "minimizada") and rodando and IS_WINDOWS:
                        # printwindow nao depende do titulo (VLC muda o titulo o tempo todo)
                        # e o feeder ja reinicia se o tamanho mudar.
                        if modo in ("titulo", "regiao"):
                            if modo == "titulo":
                                tit = titulo_janela(ref)
                                if titulo_cache is None:
                                    titulo_cache = tit
                                elif tit and tit != titulo_cache:
                                    log("titulo da janela mudou, recapturando")
                                    titulo_cache = tit
                                    geo_cache = None
                                    self._parar_processo()
                                    self._iniciar_processo()
                                    continue
                            geo = geometria_janela(ref)
                            if modo == "regiao" and geo and geo_cache and geo != geo_cache:
                                log("janela moveu, ajustando captura",
                                    "%(w)dx%(h)d+%(x)d+%(y)d" % geo)
                                self._parar_processo()
                                self._iniciar_processo()
                            if geo:
                                geo_cache = geo
                        else:
                            # printwindow: so acompanha se a janela ainda existe
                            titulo_cache = None
                            geo_cache = None
            except Exception as e:
                log("vigia da janela:", e)

    def assinar(self):
        with self.trava:
            if not self.init_seg:
                return None, None, None
            a = Assinante(self.gen)
            self.assinantes.add(a)
            return a, self.init_seg, self.mime

    def desassinar(self, a):
        with self.trava:
            self.assinantes.discard(a)
            a.viva = False

    def consumir_quedas(self):
        with self.trava:
            q, self.quedas = self.quedas, 0
            return q

    def congestionado(self):
        with self.trava:
            return any(a.fila.qsize() >= Assinante.ATRASO for a in self.assinantes)

    def estado_atual(self):
        with self.trava:
            n = NIVEIS[self.nivel]
            nomes_enc = {
                "nvenc": "NVIDIA NVENC",
                "amf": "AMD AMF",
                "qsv": "Intel QSV",
                "vaapi": "VAAPI",
                "cpu": "CPU (libx264)",
            }
            return {
                "estado": self.estado,
                "erro": self.erro,
                "espectadores": len(self.assinantes),
                "kbps": self.kbps_real,
                "kbps_alvo": n["kbps"],
                "segundos": int(time.time() - self.inicio) if self.inicio and self.deve_rodar else 0,
                "rodando": self.deve_rodar,
                "opcoes": dict(self.opcoes),
                "qualidade": n["nome"],
                "nivel": self.nivel,
                "fps": n["fps"],
                "dimensoes": "%dx%d" % (n["larg"], n["alt"]),
                "niveis": [{"nome": x["nome"], "larg": x["larg"], "alt": x["alt"],
                            "fps": x["fps"], "kbps": x["kbps"]} for x in NIVEIS],
                "codificador": nomes_enc.get(self.codificador, self.codificador),
                "velocidade": self.velocidade,
                "aviso_nivel": self.aviso_nivel,
                "atraso": self.atraso_atual(),
                "atrasos": list(ATRASOS_OK),
                "som": self.mesa.estado(),
                "registro": list(self.registro[-6:]),
            }


class Adaptador:
    PACIENCIA = 180

    def __init__(self, captura, ctx):
        self.captura = captura
        self.ctx = ctx
        self.apertado = 0
        self.calmo_desde = time.time()
        self.motivo = ""
        threading.Thread(target=self._laco, daemon=True).start()

    def diagnostico(self):
        return {"calmo_ha": int(time.time() - self.calmo_desde),
                "paciencia": self.PACIENCIA, "motivo": self.motivo}

    def _laco(self):
        while True:
            time.sleep(5)
            try:
                self._avaliar()
            except Exception as e:
                log("adaptador:", e)

    def _avaliar(self):
        # Nao troca qualidade sozinho: dono ou quem assiste escolhe no painel/viewer.
        cap = self.captura
        if not cap.deve_rodar or cap.estado != "no ar":
            self.motivo = "captura parada"
            return
        quedas = cap.consumir_quedas()
        saude = self.ctx.saude()
        entupido = cap.congestionado()
        qnome = NIVEIS[cap.nivel]["nome"]
        if quedas or saude == "apertado" or entupido:
            self.apertado += 1
            self.calmo_desde = time.time()
            self.motivo = "apertado (quedas=%d, saude=%s, fila=%s) em %s" % (
                quedas, saude, entupido, qnome)
            return
        self.apertado = 0
        self.motivo = "calmo (%s) em %s" % (saude, qnome)


class Tunel:
    def __init__(self):
        self.proc = None
        self.url = ""
        self.estado = "desligado"

    @property
    def disponivel(self):
        if os.path.exists(CLOUDFLARED_BIN):
            return True
        return shutil.which("cloudflared") is not None

    def iniciar(self, porta):
        if self.proc and self.proc.poll() is None:
            return
        if not self.disponivel:
            self.estado = "cloudflared nao instalado"
            return
        self.url = ""
        self.estado = "conectando"
        cmd_cf = CLOUDFLARED_BIN if os.path.exists(CLOUDFLARED_BIN) else (shutil.which("cloudflared") or CLOUDFLARED_BIN)
        self.proc = subprocess.Popen(
            [cmd_cf, "tunnel", "--no-autoupdate", "--url",
             "http://127.0.0.1:%d" % porta],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, bufsize=1, text=True,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0) if IS_WINDOWS else 0)
        threading.Thread(target=self._ler, daemon=True).start()

    def _ler(self):
        padrao = re.compile(r"https://[a-z0-9-]+\.trycloudflare\.com")
        for linha in iter(self.proc.stderr.readline, ""):
            m = padrao.search(linha)
            if m and not self.url:
                self.url = m.group(0)
                self.estado = "no ar"
                log("tunel no ar")
        if self.estado == "conectando":
            self.estado = "falhou"

    def parar(self):
        proc = self.proc
        self.proc = None
        self.url = ""
        self.estado = "desligado"
        if not proc or proc.poll() is not None:
            return
        pid = proc.pid
        try:
            if IS_WINDOWS:
                subprocess.run(
                    ["taskkill", "/F", "/T", "/PID", str(pid)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
            else:
                proc.terminate()
                try:
                    proc.wait(timeout=3)
                except Exception:
                    proc.kill()
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
        try:
            proc.wait(timeout=2)
        except Exception:
            pass


class Contexto:
    def __init__(self):
        self.mesa = MesaDeSom()
        self.captura = Captura(self.mesa)
        self.chat = Chat()
        self.tunel = Tunel()
        self.token = secrets.token_urlsafe(9)
        self.chave_painel = secrets.token_urlsafe(12)
        self.porta_publica = 0
        self.porta_painel = 0
        self.servidores = []
        self.visores = {}
        self.ultimo_ping = 0
        self.viu_painel = False
        self.encerrando = False
        self.timer_saida = None
        self.problemas = verificar_ambiente()
        self.carregar()
        self.adaptador = Adaptador(self.captura, self)

    def carregar(self):
        try:
            with open(ARQ_CONFIG) as f:
                salvo = json.load(f)
            for k in PADRAO:
                if k in salvo:
                    self.captura.opcoes[k] = salvo[k]
            q = self.captura.opcoes.get("qualidade") or "1080p"
            idx = self.captura._indice_qualidade(q)
            if idx is not None:
                self.captura.nivel = idx
                self.captura.opcoes["qualidade"] = NIVEIS[idx]["nome"]
            atraso = self.captura.opcoes.get("atraso", ATRASO_PADRAO)
            try:
                atraso = int(atraso)
            except (TypeError, ValueError):
                atraso = ATRASO_PADRAO
            self.captura.opcoes["atraso"] = atraso if atraso in ATRASOS_OK else ATRASO_PADRAO
        except Exception:
            pass

    def salvar(self):
        try:
            os.makedirs(DIR_CACHE, exist_ok=True)
            self.captura.opcoes["qualidade"] = NIVEIS[self.captura.nivel]["nome"]
            guardar = {k: v for k, v in self.captura.opcoes.items() if k != "alvo"}
            with open(ARQ_CONFIG, "w") as f:
                json.dump(guardar, f)
        except Exception:
            pass

    def saude(self):
        agora = time.time()
        vivos = [v for v in self.visores.values() if agora - v["quando"] < 15]
        if not vivos:
            return "sem publico"
        for v in vivos:
            if agora - v.get("desde", agora) < 12:
                continue
            if v["buffer"] < 0.4:
                return "apertado"
        return "ok"

    def agendar_saida(self, segundos=6):
        self.cancelar_saida()
        self.timer_saida = threading.Timer(segundos, self.encerrar)
        self.timer_saida.daemon = True
        self.timer_saida.start()

    def cancelar_saida(self):
        if self.timer_saida:
            self.timer_saida.cancel()
            self.timer_saida = None

    def url_publica(self):
        return "%s/v/%s" % (self.tunel.url, self.token) if self.tunel.url else ""

    def urls_diretas(self):
        saida = ["http://%s:%d/v/%s" % (ip_local(), self.porta_publica, self.token)]
        for ip in ips_v6()[:1]:
            saida.append("http://[%s]:%d/v/%s" % (ip, self.porta_publica, self.token))
        return saida

    def liberar_portas(self):
        for srv in list(self.servidores or []):
            try:
                srv.shutdown()
            except Exception:
                pass
            try:
                srv.server_close()
            except Exception:
                pass
            try:
                if getattr(srv, "socket", None):
                    srv.socket.close()
            except Exception:
                pass
        self.servidores = []

    def encerrar(self):
        if self.encerrando:
            return
        self.encerrando = True
        log("encerrando: liberando tunel e portas")
        self.salvar()
        for acao in (self.captura.parar, self.tunel.parar, self.mesa.limpar,
                     self.liberar_portas):
            try:
                acao()
            except Exception:
                pass
        threading.Timer(0.4, lambda: os._exit(0)).start()


