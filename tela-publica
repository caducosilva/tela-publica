def garantir_instancia_unica():
    """Impede dois Transmitir Tela ao mesmo tempo (isso quebrava a lista)."""
    global _MUTEX_HANDLE, _LOCK_FD
    os.makedirs(DIR_CACHE, exist_ok=True)

    # 1) Mutex do Windows (atomico).
    if IS_WINDOWS:
        kernel32 = ctypes.windll.kernel32
        kernel32.CreateMutexW.argtypes = [ctypes.c_void_p, wintypes.BOOL, wintypes.LPCWSTR]
        kernel32.CreateMutexW.restype = wintypes.HANDLE
        kernel32.SetLastError(0)
        handle = kernel32.CreateMutexW(None, False, "Local\\TelaPublicaTransmitirTela")
        err = int(kernel32.GetLastError() or 0)
        ERROR_ALREADY_EXISTS = 183
        if handle:
            _MUTEX_HANDLE = handle
            if err == ERROR_ALREADY_EXISTS:
                _reabrir_painel_existente()
                return False

    # 2) Arquivo exclusivo como segunda trava.
    for _ in range(3):
        try:
            fd = os.open(ARQ_LOCK, os.O_CREAT | os.O_EXCL | os.O_RDWR)
            os.write(fd, str(os.getpid()).encode("ascii", "ignore"))
            _LOCK_FD = fd
            break
        except FileExistsError:
            antigo = 0
            try:
                with open(ARQ_LOCK, "r", encoding="utf-8") as f:
                    antigo = int((f.read() or "0").strip() or "0")
            except Exception:
                antigo = 0
            if antigo and antigo != os.getpid() and _pid_vivo(antigo):
                _reabrir_painel_existente()
                return False
            try:
                os.remove(ARQ_LOCK)
            except Exception:
                time.sleep(0.1)
        except Exception:
            break
    else:
        # nao conseguiu criar lock exclusivo e nao confirmou dono vivo
        if os.path.exists(ARQ_LOCK):
            _reabrir_painel_existente()
            return False

    def _limpar_lock():
        global _MUTEX_HANDLE, _LOCK_FD
        try:
            if _LOCK_FD is not None:
                try:
                    os.close(_LOCK_FD)
                except Exception:
                    pass
                _LOCK_FD = None
            if os.path.exists(ARQ_LOCK):
                try:
                    with open(ARQ_LOCK, "r", encoding="utf-8") as f:
                        dono = (f.read() or "").strip()
                    if dono == str(os.getpid()):
                        os.remove(ARQ_LOCK)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            if IS_WINDOWS and _MUTEX_HANDLE:
                ctypes.windll.kernel32.CloseHandle(_MUTEX_HANDLE)
                _MUTEX_HANDLE = None
        except Exception:
            pass

    atexit.register(_limpar_lock)
    return True


