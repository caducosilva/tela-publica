# ==================================================== mesa de som da transmissao

class MesaDeSom:
    """Decide o que vai ao ar em termos de audio.

    Cria um destino de som proprio e liga nele apenas o que deve ser
    transmitido: o programa da janela escolhida e, quando o dono quiser falar,
    o microfone. As ligacoes sao adicionais, entao nada e tirado das caixas do
    computador: quem esta na frente do micro continua ouvindo tudo.

    A mistura acontece no PipeWire e nao no ffmpeg. Por isso ligar e desligar
    o microfone e imediato e nao corta a imagem.
    """

    def __init__(self):
        self.trava = threading.RLock()
        self.modulo = None
        self.pid_alvo = None
        self.tokens = set()
        self.usar_sistema = False      # quando o alvo e a tela inteira
        self.mic = ""
        self.mic_ligado = False
        self.programa = ""
        self.achou_programa = False
        self.mic_no_ar = False
        self.limpar_restos()
        threading.Thread(target=self._laco, daemon=True).start()

    # ---------------------------------------------------------------- destino

    def monitor(self):
        return SINK_MESA + ".monitor" if self.modulo else None

    def limpar_restos(self):
        """Remove destinos deixados para tras por uma execucao anterior."""
        for linha in rodar(["pactl", "list", "short", "modules"]).splitlines():
            if SINK_MESA in linha:
                rodar(["pactl", "unload-module", linha.split("\t")[0]])

    def _garantir_destino(self):
        if self.modulo:
            return True
        saida = rodar(["pactl", "load-module", "module-null-sink",
                       "sink_name=" + SINK_MESA,
                       "sink_properties=device.description=Tela_publica"]).strip()
        if saida.isdigit():
            self.modulo = saida
            log("destino de som criado (modulo %s)" % saida)
            return True
        return False

    # ------------------------------------------------------------- o que entra

    def definir_janela(self, pid, textos):
        with self.trava:
            self.pid_alvo = pid
            self.tokens = set()
            for t in textos:
                self.tokens |= fatiar(t)
            self.tokens -= {"com", "org", "github", "player", "www"}
            self.usar_sistema = False
        self._garantir_destino()
        self._religar()

    def definir_tela_inteira(self):
        """Tela inteira nao tem um programa dono, entao vai o som geral."""
        with self.trava:
            self.pid_alvo = None
            self.tokens = set()
            self.usar_sistema = True
        self._garantir_destino()
        self._religar()

    def definir_microfone(self, nome, ligado):
        with self.trava:
            self.mic = nome or ""
            self.mic_ligado = bool(ligado and self.mic)
        self._garantir_destino()
        self._religar()          # imediato, para o mudo responder na hora

    def desligar(self):
        with self.trava:
            self.pid_alvo = None
            self.tokens = set()
            self.usar_sistema = False
            self.achou_programa = False
            self.programa = ""
        self._religar()

    # ----------------------------------------------------------- as ligacoes

    def _combina_programa(self, props):
        pid = props.get("application.process.id")
        try:
            if pid is not None and self.pid_alvo and int(pid) == self.pid_alvo:
                return True
        except (TypeError, ValueError):
            pass
        # Nem todo programa expoe o PID (o Celluloid, por exemplo, entra pela
        # camada de compatibilidade ALSA). Nesse caso vale o nome.
        nomes = fatiar(" ".join(str(props.get(k, "")) for k in (
            "node.name", "application.name", "application.process.binary",
            "media.name")))
        return bool(nomes & self.tokens)

    def _religar(self):
        with self.trava:
            if not self.modulo:
                return
            quer_programa = bool(self.tokens or self.pid_alvo)
            quer_sistema = self.usar_sistema
            quer_mic = self.mic_ligado
            mic = self.mic

        dados = pw_dump()
        if not dados:
            return

        nos, portas, ligacoes = {}, [], {}
        for o in dados:
            tipo = o.get("type", "")
            info = o.get("info", {}) or {}
            props = info.get("props", {}) or {}
            if tipo.endswith("Node"):
                nos[o["id"]] = props
            elif tipo.endswith("Port"):
                portas.append((o["id"], props))
            elif tipo.endswith("Link"):
                ligacoes[(info.get("output-port-id"), info.get("input-port-id"))] = o["id"]

        destino = next((i for i, p in nos.items()
                        if p.get("node.name") == SINK_MESA), None)
        if destino is None:
            return
        entradas = {p.get("audio.channel"): i for i, p in portas
                    if p.get("node.id") == destino and p.get("port.direction") == "in"}
        if not entradas:
            return

        padrao = sink_padrao() if quer_sistema else ""
        desejados, nome_programa, achou, mic_ativo = set(), "", False, False

        for nid, props in nos.items():
            if nid == destino:
                continue
            classe = props.get("media.class", "")
            nome_no = props.get("node.name", "")
            if quer_programa and classe == "Stream/Output/Audio" \
                    and self._combina_programa(props):
                desejados.add(nid)
                achou = True
                nome_programa = props.get("application.name") or nome_no
            elif quer_sistema and classe == "Audio/Sink" and nome_no == padrao:
                desejados.add(nid)          # monitor da saida padrao
            elif quer_mic and classe == "Audio/Source" and nome_no == mic:
                desejados.add(nid)
                mic_ativo = True

        # Cria o que falta.
        for nid in desejados:
            saidas = [(p.get("audio.channel"), i) for i, p in portas
                      if p.get("node.id") == nid and p.get("port.direction") == "out"]
            for canal, porta_saida in saidas:
                alvos = ([entradas[canal]] if canal in entradas
                         else list(entradas.values()))   # mono vai para os dois lados
                for porta_entrada in alvos:
                    if (porta_saida, porta_entrada) not in ligacoes:
                        rodar(["pw-link", str(porta_saida), str(porta_entrada)])

        # Desfaz o que nao deve mais estar no ar (o mudo do microfone cai aqui).
        for (saida_id, entrada_id), link_id in ligacoes.items():
            if entrada_id not in entradas.values():
                continue
            dono = next((p.get("node.id") for i, p in portas if i == saida_id), None)
            if dono is not None and dono not in desejados:
                rodar(["pw-link", "-d", str(saida_id), str(entrada_id)])

        with self.trava:
            self.achou_programa = achou
            self.mic_no_ar = mic_ativo
            if achou:
                self.programa = re.sub(r"^PipeWire ALSA \[(.*)\]$", r"\1",
                                       nome_programa)

    def _laco(self):
        """Mantem as ligacoes de pe: programas abrem e fecham o som o tempo todo."""
        while True:
            time.sleep(2.5)
            try:
                self._religar()
            except Exception as e:
                log("mesa de som:", e)

    def estado(self):
        with self.trava:
            return {
                "tem_destino": bool(self.modulo),
                "achou_programa": self.achou_programa,
                "programa": self.programa,
                "microfone": self.mic,
                "mic_ligado": self.mic_ligado,
                "mic_no_ar": self.mic_no_ar,
                "tela_inteira": self.usar_sistema,
            }

    def limpar(self):
        with self.trava:
            mod, self.modulo = self.modulo, None
        if mod:
            rodar(["pactl", "unload-module", mod])


# ================================================================ chat efemero

class Chat:
    """Conversa que existe so enquanto acontece.

    Nada e gravado em disco, nada entra no registro do programa e cada
    mensagem desaparece um minuto depois de enviada. Serve para quem esta
    assistindo avisar alguma coisa, nao para guardar historico.
    """

    VIDA = 60          # segundos ate a mensagem sumir
    INTERVALO = 5      # cada pessoa pode mandar uma mensagem a cada 5 segundos
    TETO = 60          # mensagens vivas ao mesmo tempo
    MAX_TEXTO = 200
    MAX_NOME = 20

    def __init__(self):
        self.trava = threading.Lock()
        self.mensagens = deque(maxlen=self.TETO)
        self.ultimo_envio = {}
        self.sequencia = 0

    def _limpar(self, agora):
        while self.mensagens and agora - self.mensagens[0]["quando"] > self.VIDA:
            self.mensagens.popleft()
        for ip, quando in list(self.ultimo_envio.items()):
            if agora - quando > 300:
                del self.ultimo_envio[ip]

    def enviar(self, quem, nome, texto):
        agora = time.time()
        nome = limpar_texto(nome, self.MAX_NOME) or "convidado"
        texto = limpar_texto(texto, self.MAX_TEXTO)
        with self.trava:
            self._limpar(agora)
            if not texto:
                return False, "Escreva alguma coisa.", 0
            espera = self.INTERVALO - (agora - self.ultimo_envio.get(quem, 0))
            if espera > 0:
                return False, "Espere um pouco para mandar de novo.", int(espera) + 1
            self.ultimo_envio[quem] = agora
            self.sequencia += 1
            self.mensagens.append({"id": self.sequencia, "nome": nome,
                                   "texto": texto, "quando": agora})
            return True, "", 0

    def recentes(self, desde=0):
        agora = time.time()
        with self.trava:
            self._limpar(agora)
            novas = [{"id": m["id"], "nome": m["nome"], "texto": m["texto"],
                      "resta": round(self.VIDA - (agora - m["quando"]), 1)}
                     for m in self.mensagens if m["id"] > desde]
            return {"mensagens": novas, "ultimo": self.sequencia,
                    "vivas": len(self.mensagens)}


# ===================================================================== captura

class Assinante:
    # Cada item da fila e um trecho de cerca de 2 segundos de video. Uma fila
    # comprida demoraria minutos para acusar que a banda nao esta dando conta,
    # entao o limite e curto de proposito.
    LIMITE = 12
    ATRASO = 4

    def __init__(self, gen):
        self.gen = gen
        self.fila = queue.Queue(maxsize=self.LIMITE)
        self.viva = True

    def enviar(self, dados):
        try:
            self.fila.put_nowait(dados)
        except queue.Full:
            self.viva = False       # ficou para tras, o navegador reconecta limpo
            try:
                while True:
                    self.fila.get_nowait()
            except queue.Empty:
                pass
            try:
                self.fila.put_nowait(None)
            except queue.Full:
                pass

    def encerrar(self):
        self.viva = False
        try:
            self.fila.put_nowait(None)
        except queue.Full:
            pass


PADRAO = {
    "alvo": "",           # "janela:0x123" ou "tela:DP-2"
    "microfone": "",      # node do microfone escolhido
    "mic_ligado": False,
}


class Captura:
    def __init__(self, mesa):
        self.trava = threading.RLock()
        self.mesa = mesa
        self.opcoes = dict(PADRAO)
        self.nivel = 0
        self.codificador = "gpu" if tem_vaapi() else "cpu"
        self.gen = 0
        self.proc = None
        self.init_seg = None
        self.mime = ""
        self.assinantes = set()
        self.deve_rodar = False
        self.estado = "parado"
        self.erro = ""
        self.aviso_nivel = ""
        self.registro = []
        self.velocidade = ""
        self.bytes_janela = 0
        self.kbps_real = 0
        self.inicio = 0
        self.falhas = 0
        self.quedas = 0
        self.dimensoes = ""
        self.pausado_por_janela = False
        threading.Thread(target=self._medidor, daemon=True).start()
        threading.Thread(target=self._vigia_janela, daemon=True).start()

    # ------------------------------------------------------------ ciclo de vida

    def aplicar(self, novas):
        with self.trava:
            for k in PADRAO:
                if k in novas:
                    self.opcoes[k] = novas[k]
            rodando = self.deve_rodar
        self._ajustar_som()
        if rodando:
            with self.trava:
                self._parar_processo()
                self._iniciar_processo()

    def ajustar_microfone(self, nome, ligado):
        """Nao reinicia a captura: o mudo vale na hora."""
        with self.trava:
            self.opcoes["microfone"] = nome or ""
            self.opcoes["mic_ligado"] = bool(ligado)
        self.mesa.definir_microfone(nome, ligado)

    def iniciar(self):
        self._ajustar_som()
        with self.trava:
            self.deve_rodar = True
            self.pausado_por_janela = False
            self.falhas = 0
            self.nivel = 0
            self.aviso_nivel = ""
            self._parar_processo()
            self._iniciar_processo()

    def parar(self):
        with self.trava:
            self.deve_rodar = False
            self.pausado_por_janela = False
            self._parar_processo()
            self.estado = "parado"
            self.erro = ""
        self.mesa.desligar()

    def _ajustar_som(self):
        with self.trava:
            alvo = self.opcoes["alvo"]
            mic, ligado = self.opcoes["microfone"], self.opcoes["mic_ligado"]
        tipo, _, ref = alvo.partition(":")
        if tipo == "janela":
            janela = next((j for j in listar_janelas() if j["id"] == ref), None)
            if janela:
                self.mesa.definir_janela(janela["pid"], [janela["classe"], janela["app"]])
            else:
                self.mesa.desligar()
        elif tipo == "tela":
            self.mesa.definir_tela_inteira()
        else:
            self.mesa.desligar()
        self.mesa.definir_microfone(mic, ligado)

    def _parar_processo(self):
        p, self.proc = self.proc, None
        self.init_seg = None
        for a in list(self.assinantes):
            a.encerrar()
        self.assinantes.clear()
        if p and p.poll() is None:
            try:
                p.terminate()
                p.wait(timeout=3)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass

    def _iniciar_processo(self):
        if not self.opcoes["alvo"]:
            self.estado = "escolha uma janela"
            return
        tipo, _, ref = self.opcoes["alvo"].partition(":")
        if tipo == "janela" and not janela_visivel(ref):
            # Minimizada, o X nega a captura. Tenta trazer de volta.
            if not restaurar_janela(ref):
                self.estado = "janela minimizada"
                self.erro = ("Essa janela esta minimizada. Restaure ela na tela "
                             "para poder transmitir.")
                self.deve_rodar = False
                return
        cmd = self._montar_comando()
        self.dimensoes = "%dx%d" % (NIVEIS[self.nivel]["larg"], NIVEIS[self.nivel]["alt"])
        self.gen += 1
        gen = self.gen
        self.mime = self._mime()
        self.registro = []
        self.erro = ""
        self.velocidade = ""
        self.inicio = time.time()
        log("captura gen", gen, "nivel", self.nivel, self.codificador)
        try:
            self.proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL, bufsize=0, env=ambiente())
        except FileNotFoundError:
            self.estado = "erro"
            self.erro = "ffmpeg nao encontrado. Instale com: sudo apt install ffmpeg"
            return
        self.estado = "iniciando"
        threading.Thread(target=self._leitor, args=(self.proc, gen), daemon=True).start()
        threading.Thread(target=self._erros, args=(self.proc, gen), daemon=True).start()

    def _montar_comando(self):
        n = NIVEIS[self.nivel]
        display = ambiente()["DISPLAY"]
        gpu = self.codificador == "gpu" and tem_vaapi()

        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "warning", "-nostdin"]
        if gpu:
            cmd += ["-vaapi_device", RENDER_NODE]

        # draw_mouse 0: o cursor do mouse nunca aparece para quem assiste.
        cmd += ["-f", "x11grab", "-framerate", str(n["fps"]),
                "-thread_queue_size", "1024", "-draw_mouse", "0"]

        tipo, _, ref = self.opcoes["alvo"].partition(":")
        if tipo == "janela":
            cmd += ["-window_id", ref, "-i", display]
        else:
            telas = listar_telas()
            tela = next((t for t in telas if t["nome"] == ref), None) or \
                (telas[0] if telas else {"w": 1920, "h": 1080, "x": 0, "y": 0})
            cmd += ["-video_size", "%dx%d" % (tela["w"], tela["h"]),
                    "-i", "%s+%d,%d" % (display, tela["x"], tela["y"])]

        fonte = self.mesa.monitor()
        if fonte:
            cmd += ["-f", "pulse", "-thread_queue_size", "1024", "-i", fonte]

        # Quadro fixo: a janela cabe inteira dentro dele, sem distorcer, e o
        # que sobrar vira tarja preta. Assim a resolucao nunca muda no meio.
        filtros = [
            "scale=%d:%d:force_original_aspect_ratio=decrease:flags=bicubic"
            % (n["larg"], n["alt"]),
            "pad=%d:%d:(ow-iw)/2:(oh-ih)/2" % (n["larg"], n["alt"]),
            "format=nv12,hwupload" if gpu else "format=yuv420p",
        ]
        cmd += ["-vf", ",".join(filtros)]

        gop = str(n["fps"] * 2)
        if gpu:
            # O driver desta placa so aceita CQP, entao a qualidade e fixa por
            # quadro e nao por taxa. Ver a secao de problemas conhecidos.
            cmd += ["-c:v", "h264_vaapi", "-profile:v", "high", "-level", "42",
                    "-rc_mode", "CQP", "-qp", str(n["qp"]), "-g", gop, "-bf", "0"]
        else:
            k = n["kbps"]
            cmd += ["-c:v", "libx264", "-preset", "veryfast",
                    "-profile:v", "high", "-level", "4.2",
                    "-b:v", "%dk" % k, "-maxrate", "%dk" % k,
                    "-bufsize", "%dk" % (k * 2),
                    "-g", gop, "-keyint_min", gop, "-sc_threshold", "0", "-bf", "2"]

        if fonte:
            cmd += ["-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", "2",
                    "-af", "aresample=async=1000", "-map", "0:v:0", "-map", "1:a:0"]
        else:
            cmd += ["-an", "-map", "0:v:0"]

        cmd += ["-movflags", "+frag_keyframe+empty_moov+default_base_moof",
                "-flush_packets", "1", "-stats_period", "3",
                "-progress", "pipe:2", "-f", "mp4", "pipe:1"]
        return cmd

    def _mime(self):
        codecs = "avc1.64002A"
        if self.mesa.monitor():
            codecs += ", mp4a.40.2"
        return 'video/mp4; codecs="%s"' % codecs

    # -------------------------------------------------------- qualidade sozinha

    def mudar_nivel(self, delta, motivo=""):
        with self.trava:
            novo = max(0, min(len(NIVEIS) - 1, self.nivel + delta))
            if novo == self.nivel or not self.deve_rodar:
                return False
            self.nivel = novo
            self.aviso_nivel = motivo
            log("qualidade ->", NIVEIS[novo]["nome"], motivo)
            self._parar_processo()
            self._iniciar_processo()
            return True

    # ------------------------------------------------------- leitura do fluxo

    @staticmethod
    def _proxima_caixa(buf):
        """Le uma caixa do MP4: 4 bytes de tamanho, 4 de tipo, depois o conteudo."""
        if len(buf) < 8:
            return None
        tamanho = int.from_bytes(buf[0:4], "big")
        tipo = bytes(buf[4:8])
        if tamanho == 1:
            if len(buf) < 16:
                return None
            tamanho = int.from_bytes(buf[8:16], "big")
        if tamanho < 8:
            raise ValueError("caixa mp4 invalida")
        if len(buf) < tamanho:
            return None
        dados = bytes(buf[:tamanho])
        del buf[:tamanho]
        return tipo, dados

    def _leitor(self, proc, gen):
        buf, inicial, frag = bytearray(), bytearray(), bytearray()
        pronto = False
        try:
            while True:
                pedaco = proc.stdout.read(65536)
                if not pedaco:
                    break
                buf += pedaco
                while True:
                    try:
                        caixa = self._proxima_caixa(buf)
                    except ValueError:
                        buf.clear()
                        break
                    if caixa is None:
                        break
                    tipo, dados = caixa
                    if not pronto:
                        # ftyp + moov formam o cabecalho que todo navegador
                        # precisa receber antes de qualquer imagem.
                        if tipo in (b"ftyp", b"moov"):
                            inicial += dados
                            if tipo == b"moov":
                                pronto = True
                                with self.trava:
                                    if gen == self.gen:
                                        self.init_seg = bytes(inicial)
                                        self.estado = "no ar"
                                        self.falhas = 0
                        continue
                    if tipo == b"moof":
                        frag = bytearray(dados)
                    elif tipo == b"mdat" and frag:
                        frag += dados
                        self._difundir(gen, bytes(frag))
                        frag = bytearray()
        except Exception as e:
            log("leitor:", e)
        finally:
            self._encerrou(proc, gen)

    def _difundir(self, gen, dados):
        with self.trava:
            if gen != self.gen:
                return
            self.bytes_janela += len(dados)
            for a in list(self.assinantes):
                a.enviar(dados)
                if not a.viva:
                    self.assinantes.discard(a)
                    self.quedas += 1

    CHAVES_PROGRESSO = ("frame=", "fps=", "stream_", "bitrate=", "total_size=",
                        "out_time", "dup_frames=", "drop_frames=", "speed=",
                        "progress=")

    def _erros(self, proc, gen):
        for linha in iter(proc.stderr.readline, b""):
            texto = linha.decode("utf-8", "replace").rstrip()
            if not texto:
                continue
            if texto.startswith(self.CHAVES_PROGRESSO):
                if texto.startswith("speed="):
                    with self.trava:
                        if gen == self.gen:
                            self.velocidade = texto.split("=", 1)[1].strip()
                continue
            with self.trava:
                if gen == self.gen:
                    self.registro.append(texto)
                    del self.registro[:-40]
            log("ffmpeg:", texto)

    def _encerrou(self, proc, gen):
        time.sleep(0.2)
        with self.trava:
            if gen != self.gen:
                return
            codigo = proc.poll()
            for a in list(self.assinantes):
                a.encerrar()
            self.assinantes.clear()
            self.init_seg = None
            if not self.deve_rodar:
                self.estado = "parado"
                return
            self.falhas += 1
            pistas = [l for l in self.registro
                      if "rror" in l or "nvalid" in l or "ailed" in l]
            self.erro = pistas[-1] if pistas else ("ffmpeg saiu com codigo %s" % codigo)
            # A placa de video recusou: passa a comprimir pela CPU.
            if self.codificador == "gpu" and self.falhas <= 2 and any(
                    "vaapi" in l.lower() or "hwupload" in l.lower() for l in self.registro):
                self.codificador = "cpu"
                self.erro = ""
                log("vaapi falhou, caindo para libx264")
            if self.falhas >= 5:
                self.deve_rodar = False
                self.estado = "erro"
                return
            self.estado = "reconectando"
        time.sleep(1.5)
        with self.trava:
            if self.deve_rodar and gen == self.gen:
                self._parar_processo()
                self._iniciar_processo()

    def _medidor(self):
        while True:
            time.sleep(2)
            with self.trava:
                self.kbps_real = int(self.bytes_janela * 8 / 2 / 1000)
                self.bytes_janela = 0

    def _vigia_janela(self):
        """Janela minimizada nao entrega imagem nenhuma. Em vez de transmitir o
        nada, avisa e retoma sozinho quando ela voltar para a tela."""
        while True:
            time.sleep(3)
            try:
                with self.trava:
                    tipo, _, ref = self.opcoes["alvo"].partition(":")
                    rodando, pausado = self.deve_rodar, self.pausado_por_janela
                if tipo != "janela" or not (rodando or pausado):
                    continue
                situacao = estado_janela(ref)
                with self.trava:
                    if situacao == "visivel" and pausado:
                        self.pausado_por_janela = False
                        self.deve_rodar = True
                        self.erro = ""
                        self.falhas = 0
                        log("janela voltou, retomando")
                        self._parar_processo()
                        self._iniciar_processo()
                    elif situacao != "visivel" and not pausado and rodando:
                        self.pausado_por_janela = True
                        self.deve_rodar = False
                        self._parar_processo()
                        if situacao == "sumiu":
                            self.estado = "janela fechada"
                            self.erro = "Essa janela foi fechada. Escolha outra na lista."
                            self.pausado_por_janela = False
                        else:
                            self.estado = "janela minimizada"
                            self.erro = ("A janela saiu da tela. Restaure ela e a "
                                         "transmissão volta sozinha.")
            except Exception as e:
                log("vigia da janela:", e)

    # ------------------------------------------------------------ quem assiste

    def assinar(self):
        with self.trava:
            if not self.init_seg:
                return None, None, None
            a = Assinante(self.gen)
            self.assinantes.add(a)
            return a, self.init_seg, self.mime

    def desassinar(self, a):
        with self.trava:
            self.assinantes.discard(a)
            a.viva = False

    def consumir_quedas(self):
        with self.trava:
            q, self.quedas = self.quedas, 0
            return q

    def congestionado(self):
        with self.trava:
            return any(a.fila.qsize() >= Assinante.ATRASO for a in self.assinantes)

    def estado_atual(self):
        with self.trava:
            n = NIVEIS[self.nivel]
            return {
                "estado": self.estado,
                "erro": self.erro,
                "espectadores": len(self.assinantes),
                "kbps": self.kbps_real,
                "segundos": int(time.time() - self.inicio) if self.inicio and self.deve_rodar else 0,
                "rodando": self.deve_rodar,
                "opcoes": dict(self.opcoes),
                "qualidade": n["nome"],
                "nivel": self.nivel,
                "fps": n["fps"],
                "dimensoes": self.dimensoes,
                "codificador": "placa de vídeo" if self.codificador == "gpu" else "CPU",
                "velocidade": self.velocidade,
                "aviso_nivel": self.aviso_nivel,
                "som": self.mesa.estado(),
                "registro": list(self.registro[-6:]),
            }


class Adaptador:
    """Desce e sobe a qualidade sozinho, olhando como quem assiste esta indo."""

    PACIENCIA = 180        # segundos de calmaria antes de tentar subir de novo

    def __init__(self, captura, ctx):
        self.captura = captura
        self.ctx = ctx
        self.apertado = 0
        self.calmo_desde = time.time()
        self.motivo = ""
        threading.Thread(target=self._laco, daemon=True).start()

    def diagnostico(self):
        return {"calmo_ha": int(time.time() - self.calmo_desde),
                "paciencia": self.PACIENCIA, "motivo": self.motivo}

    def _laco(self):
        while True:
            time.sleep(5)
            try:
                self._avaliar()
            except Exception as e:
                log("adaptador:", e)

    def _avaliar(self):
        cap = self.captura
        if not cap.deve_rodar or cap.estado != "no ar":
            self.motivo = "captura parada"
            return
        quedas = cap.consumir_quedas()
        saude = self.ctx.saude()
        entupido = cap.congestionado()
        if quedas or saude == "apertado" or entupido:
            self.apertado += 1
            self.calmo_desde = time.time()
            self.motivo = "apertado (quedas=%d, saude=%s, fila=%s)" % (
                quedas, saude, entupido)
            if self.apertado >= 2:
                self.apertado = 0
                cap.mudar_nivel(+1, "a conexão de quem assiste não estava dando conta")
            return
        self.apertado = 0
        self.motivo = "calmo (%s)" % saude
        # Sem ninguem assistindo tambem vale voltar ao normal: nao ha sinal de
        # aperto, e quando alguem entrar ja pega a qualidade cheia.
        if saude in ("ok", "sem publico") and \
                time.time() - self.calmo_desde > self.PACIENCIA:
            self.calmo_desde = time.time()
            cap.mudar_nivel(-1, "")


# ======================================================================= tunel

class Tunel:
    """Link publico sem mexer no roteador, usando o cloudflared."""

    def __init__(self):
        self.proc = None
        self.url = ""
        self.estado = "desligado"

    @property
    def disponivel(self):
        return shutil.which("cloudflared") is not None

    def iniciar(self, porta):
        if self.proc and self.proc.poll() is None:
            return
        if not self.disponivel:
            self.estado = "cloudflared nao instalado"
            return
        self.url = ""
        self.estado = "conectando"
        self.proc = subprocess.Popen(
            ["cloudflared", "tunnel", "--no-autoupdate", "--url",
             "http://127.0.0.1:%d" % porta],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, bufsize=1, text=True)
        threading.Thread(target=self._ler, daemon=True).start()

    def _ler(self):
        padrao = re.compile(r"https://[a-z0-9-]+\.trycloudflare\.com")
        for linha in iter(self.proc.stderr.readline, ""):
            m = padrao.search(linha)
            if m and not self.url:
                self.url = m.group(0)
                self.estado = "no ar"
                log("tunel no ar")
        if self.estado == "conectando":
            self.estado = "falhou"

    def parar(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=3)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
        self.proc = None
        self.url = ""
        self.estado = "desligado"


