def titulo_janela(jid):
    if not IS_WINDOWS:
        return ""
    try:
        hwnd = int(str(jid), 0)
        user32 = ctypes.windll.user32
        n = user32.GetWindowTextLengthW(hwnd)
        if n <= 0:
            return ""
        buf = ctypes.create_unicode_buffer(n + 1)
        user32.GetWindowTextW(hwnd, buf, n + 1)
        return buf.value or ""
    except Exception:
        return ""


def geometria_janela(jid):
    """Retorna x,y,w,h da janela no Windows, ja ajustado pro gdigrab."""
    if not IS_WINDOWS:
        return None
    try:
        hwnd = int(str(jid), 0)
        user32 = ctypes.windll.user32
        try:
            user32.SetProcessDPIAware()
        except Exception:
            pass
        if not user32.IsWindow(hwnd) or user32.IsIconic(hwnd):
            return None
        rect = wintypes.RECT()
        if not user32.GetWindowRect(hwnd, ctypes.byref(rect)):
            return None
        x, y = int(rect.left), int(rect.top)
        w, h = int(rect.right - rect.left), int(rect.bottom - rect.top)

        # Area virtual do desktop (gdigrab usa esse sistema de coordenadas)
        vx = int(user32.GetSystemMetrics(76))  # SM_XVIRTUALSCREEN
        vy = int(user32.GetSystemMetrics(77))  # SM_YVIRTUALSCREEN
        vw = int(user32.GetSystemMetrics(78) or user32.GetSystemMetrics(0))
        vh = int(user32.GetSystemMetrics(79) or user32.GetSystemMetrics(1))

        # Janela maximizada no Win10/11 vem com borda negativa (-7/-8).
        if x < vx:
            w -= (vx - x)
            x = vx
        if y < vy:
            h -= (vy - y)
            y = vy
        if x + w > vx + vw:
            w = vx + vw - x
        if y + h > vy + vh:
            h = vy + vh - y

        # gdigrab exige largura/altura pares e positivas
        w -= w % 2
        h -= h % 2
        if w < 16 or h < 16:
            return None
        return {"x": x, "y": y, "w": w, "h": h}
    except Exception:
        return None


def estado_janela(jid):
    if IS_WINDOWS:
        try:
            hwnd = int(str(jid), 0)
            user32 = ctypes.windll.user32
            if not user32.IsWindow(hwnd):
                return "sumiu"
            return "minimizada" if user32.IsIconic(hwnd) else "visivel"
        except Exception:
            return "sumiu"

    saida = rodar(["xwininfo", "-id", jid], timeout=3)
    if not saida.strip():
        return "sumiu"
    return "visivel" if "IsViewable" in saida else "minimizada"


def janela_visivel(jid):
    return estado_janela(jid) == "visivel"


def restaurar_janela(jid):
    if IS_WINDOWS:
        try:
            hwnd = int(str(jid), 0)
            user32 = ctypes.windll.user32
            if not user32.IsWindow(hwnd):
                return False
            # SW_RESTORE=9; se so estiver atras, traz pra frente
            if user32.IsIconic(hwnd):
                user32.ShowWindow(hwnd, 9)
            else:
                user32.ShowWindow(hwnd, 5)  # SW_SHOW
            user32.BringWindowToTop(hwnd)
            user32.SetForegroundWindow(hwnd)
            time.sleep(0.4)
            return janela_visivel(jid)
        except Exception:
            return False

    rodar(["wmctrl", "-i", "-a", jid], timeout=3)
    time.sleep(0.7)
    return janela_visivel(jid)


def listar_janelas():
    if IS_WINDOWS:
        janelas = []
        user32 = ctypes.windll.user32
        try:
            user32.SetProcessDPIAware()
        except Exception:
            pass

        @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
        def enum_windows_callback(hwnd, extra):
            try:
                if not user32.IsWindowVisible(hwnd):
                    return True
                length = user32.GetWindowTextLengthW(hwnd)
                if length <= 0:
                    return True
                buff = ctypes.create_unicode_buffer(length + 1)
                user32.GetWindowTextW(hwnd, buff, length + 1)
                title = buff.value or ""
                ignorar = (
                    "Program Manager",
                    "Settings",
                    "Microsoft Text Input Application",
                    "Windows Input Experience",
                )
                if not title or any(ig.lower() in title.lower() for ig in ignorar):
                    return True
                rect = wintypes.RECT()
                user32.GetWindowRect(hwnd, ctypes.byref(rect))
                w = rect.right - rect.left
                h = rect.bottom - rect.top
                if w <= 100 or h <= 100:
                    return True
                pid = wintypes.DWORD()
                user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
                cls = ctypes.create_unicode_buffer(256)
                user32.GetClassNameW(hwnd, cls, 256)
                janelas.append({
                    "id": str(int(hwnd)),
                    "pid": int(pid.value),
                    "titulo": title,
                    "app": (cls.value or title)[:30],
                    "classe": cls.value or title,
                    "x": int(rect.left),
                    "y": int(rect.top),
                    "w": int(w),
                    "h": int(h),
                    "minimizada": bool(user32.IsIconic(hwnd)),
                })
            except Exception:
                pass
            return True

        # Mantem referencia do callback (senao o GC do Python quebra o EnumWindows).
        listar_janelas._cb = enum_windows_callback
        user32.EnumWindows(enum_windows_callback, 0)
        janelas.sort(key=lambda j: (j["minimizada"], j["titulo"].lower()))
        return janelas

    saida = rodar(["wmctrl", "-l", "-G", "-p", "-x"])
    janelas = []
    for linha in saida.splitlines():
        partes = linha.split(None, 9)
        if len(partes) < 10:
            continue
        jid, mesa, pid, x, y, w, h, classe, _host, titulo = partes
        if mesa == "-1":
            continue
        try:
            w, h, pid = int(w), int(h), int(pid)
        except ValueError:
            continue
        if w < 120 or h < 120:
            continue
        janelas.append({
            "id": jid, "pid": pid,
            "titulo": titulo.strip(),
            "app": classe.split(".")[-1],
            "classe": classe,
            "w": w, "h": h,
            "minimizada": not janela_visivel(jid),
        })
    return janelas


def listar_telas():
    if IS_WINDOWS:
        user32 = ctypes.windll.user32
        try:
            user32.SetProcessDPIAware()
        except Exception:
            pass
        # "desktop" e o nome que o gdigrab entende.
        vx = user32.GetSystemMetrics(76)
        vy = user32.GetSystemMetrics(77)
        vw = user32.GetSystemMetrics(78) or user32.GetSystemMetrics(0)
        vh = user32.GetSystemMetrics(79) or user32.GetSystemMetrics(1)
        return [{"nome": "desktop", "rotulo": "Desktop Principal",
                 "w": int(vw), "h": int(vh), "x": int(vx), "y": int(vy)}]

    saida = rodar(["xrandr", "--query"])
    telas = []
    for linha in saida.splitlines():
        m = re.match(r"^(\S+) connected (?:primary )?(\d+)x(\d+)\+(\d+)\+(\d+)", linha)
        if m:
            nome, w, h, x, y = m.groups()
            telas.append({"nome": nome, "w": int(w), "h": int(h),
                          "x": int(x), "y": int(y)})
    return telas


