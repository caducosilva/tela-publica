def _dshow_audio_devices():
    cmd = [FFMPEG_BIN, "-hide_banner", "-list_devices", "true", "-f", "dshow", "-i", "dummy"]
    try:
        kwargs = dict(capture_output=True, text=True, timeout=12)
        if IS_WINDOWS:
            kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        res = subprocess.run(cmd, **kwargs)
        out = (res.stderr or "") + (res.stdout or "")
    except Exception:
        out = ""
    return re.findall(r'"([^"]+)"\s*\(audio\)', out)


def listar_loopback_windows():
    """Stereo Mix / Cable Output etc., se o Windows expuser no DirectShow."""
    for name in _dshow_audio_devices():
        baixo = name.lower()
        if any(x in baixo for x in ("stereo mix", "what u hear", "loopback",
                                    "wave out mix", "cable output", "vb-audio")):
            return name
    return ""


