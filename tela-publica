def estado_janela(jid):
    """Janela minimizada fica IsUnMapped e o X entrega zero quadros dela."""
    saida = rodar(["xwininfo", "-id", jid], timeout=3)
    if not saida.strip():
        return "sumiu"
    return "visivel" if "IsViewable" in saida else "minimizada"


def janela_visivel(jid):
    return estado_janela(jid) == "visivel"


def restaurar_janela(jid):
    rodar(["wmctrl", "-i", "-a", jid], timeout=3)
    time.sleep(0.7)
    return janela_visivel(jid)


def listar_janelas():
    saida = rodar(["wmctrl", "-l", "-G", "-p", "-x"])
    janelas = []
    for linha in saida.splitlines():
        partes = linha.split(None, 9)
        if len(partes) < 10:
            continue
        jid, mesa, pid, x, y, w, h, classe, _host, titulo = partes
        if mesa == "-1":          # paineis e area de trabalho
            continue
        try:
            w, h, pid = int(w), int(h), int(pid)
        except ValueError:
            continue
        if w < 120 or h < 120:
            continue
        janelas.append({
            "id": jid, "pid": pid,
            "titulo": titulo.strip(),
            "app": classe.split(".")[-1],
            "classe": classe,
            "w": w, "h": h,
            "minimizada": not janela_visivel(jid),
        })
    return janelas


def listar_telas():
    saida = rodar(["xrandr", "--query"])
    telas = []
    for linha in saida.splitlines():
        m = re.match(r"^(\S+) connected (?:primary )?(\d+)x(\d+)\+(\d+)\+(\d+)", linha)
        if m:
            nome, w, h, x, y = m.groups()
            telas.append({"nome": nome, "w": int(w), "h": int(h),
                          "x": int(x), "y": int(y)})
    return telas


def sink_padrao():
    return rodar(["pactl", "get-default-sink"]).strip()


def listar_microfones():
    """Entradas de verdade, sem os monitores de saida."""
    saida = rodar(["pactl", "list", "short", "sources"])
    fontes = []
    for linha in saida.splitlines():
        campos = linha.split("\t")
        if len(campos) < 2:
            continue
        nome = campos[1]
        if nome.endswith(".monitor") or nome.startswith(SINK_MESA):
            continue
        rotulo = (nome.replace("alsa_input.", "")
                      .replace("usb-", "").replace(".analog-stereo", "")
                      .replace("_", " "))
        fontes.append({"nome": nome, "rotulo": rotulo[:48]})
    return fontes


