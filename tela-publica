def geometria_janela(jid):
    """Retorna x,y,w,h da janela no Windows, ja ajustado pro gdigrab."""
    if not IS_WINDOWS:
        return None
    try:
        hwnd = int(str(jid), 0)
        user32 = ctypes.windll.user32
        try:
            user32.SetProcessDPIAware()
        except Exception:
            pass
        if not user32.IsWindow(hwnd) or user32.IsIconic(hwnd):
            return None
        rect = wintypes.RECT()
        # Preferir bounds DWM (sem sombra/borda invisivel do Win10/11).
        try:
            dwmapi = ctypes.windll.dwmapi
            # DWMWA_EXTENDED_FRAME_BOUNDS = 9
            if dwmapi.DwmGetWindowAttribute(hwnd, 9, ctypes.byref(rect),
                                            ctypes.sizeof(rect)) != 0:
                if not user32.GetWindowRect(hwnd, ctypes.byref(rect)):
                    return None
        except Exception:
            if not user32.GetWindowRect(hwnd, ctypes.byref(rect)):
                return None
        x, y = int(rect.left), int(rect.top)
        w, h = int(rect.right - rect.left), int(rect.bottom - rect.top)

        # Area virtual do desktop (gdigrab usa esse sistema de coordenadas)
        vx = int(user32.GetSystemMetrics(76))  # SM_XVIRTUALSCREEN
        vy = int(user32.GetSystemMetrics(77))  # SM_YVIRTUALSCREEN
        vw = int(user32.GetSystemMetrics(78) or user32.GetSystemMetrics(0))
        vh = int(user32.GetSystemMetrics(79) or user32.GetSystemMetrics(1))

        # Janela maximizada no Win10/11 vem com borda negativa (-7/-8).
        if x < vx:
            w -= (vx - x)
            x = vx
        if y < vy:
            h -= (vy - y)
            y = vy
        if x + w > vx + vw:
            w = vx + vw - x
        if y + h > vy + vh:
            h = vy + vh - y

        # gdigrab exige largura/altura pares e positivas
        w -= w % 2
        h -= h % 2
        if w < 16 or h < 16:
            return None
        return {"x": x, "y": y, "w": w, "h": h}
    except Exception:
        return None


def estado_janela(jid):
    """Estado da janela alvo.

    "visivel" aqui significa capturavel (aberta, mesmo coberta ou sem foco).
    Nao exige estar em primeiro plano. Alguns apps (VLC/Qt) mentem IsIconic
    ao perder foco: se ainda tem tamanho util, trata como capturavel.
    """
    if IS_WINDOWS:
        try:
            hwnd = int(str(jid), 0)
            user32 = ctypes.windll.user32
            if not user32.IsWindow(hwnd):
                return "sumiu"
            rect = wintypes.RECT()
            tem_rect = bool(user32.GetWindowRect(hwnd, ctypes.byref(rect)))
            w = int(rect.right - rect.left) if tem_rect else 0
            h = int(rect.bottom - rect.top) if tem_rect else 0
            # Minimizada de verdade costuma ir para coords ~-32000.
            offscreen = tem_rect and (rect.left <= -25000 or rect.top <= -25000)
            if w >= 16 and h >= 16 and not offscreen:
                return "visivel"
            if user32.IsIconic(hwnd) or offscreen or w < 16 or h < 16:
                return "minimizada"
            return "visivel"
        except Exception:
            return "sumiu"

    saida = rodar(["xwininfo", "-id", jid], timeout=3)
    if not saida.strip():
        return "sumiu"
    return "visivel" if "IsViewable" in saida else "minimizada"


def janela_visivel(jid):
    return estado_janela(jid) == "visivel"


def janela_ainda_existe(jid):
    return estado_janela(jid) != "sumiu"


class WINDOWPLACEMENT(ctypes.Structure):
    _fields_ = [
        ("length", wintypes.UINT),
        ("flags", wintypes.UINT),
        ("showCmd", wintypes.UINT),
        ("ptMinPosition", wintypes.POINT),
        ("ptMaxPosition", wintypes.POINT),
        ("rcNormalPosition", wintypes.RECT),
    ]


def garantir_janela_capturavel(jid):
    """Garante que a janela nao esta minimizada, sem roubar o foco.

    Voce pode continuar navegando em outras janelas: a captura usa a HWND
    alvo, nao a janela em primeiro plano.
    """
    if not IS_WINDOWS:
        return janela_visivel(jid)
    try:
        hwnd = int(str(jid), 0)
        user32 = ctypes.windll.user32
        if not user32.IsWindow(hwnd):
            return False
        if user32.IsIconic(hwnd):
            # Restaura sem ativar (nao tira o foco do Chrome/YouTube etc).
            wp = WINDOWPLACEMENT()
            wp.length = ctypes.sizeof(WINDOWPLACEMENT)
            if user32.GetWindowPlacement(hwnd, ctypes.byref(wp)):
                wp.showCmd = 4  # SW_SHOWNOACTIVATE
                user32.SetWindowPlacement(hwnd, ctypes.byref(wp))
            else:
                user32.ShowWindow(hwnd, 4)  # SW_SHOWNOACTIVATE
            time.sleep(0.2)
        return bool(user32.IsWindow(hwnd)) and not bool(user32.IsIconic(hwnd))
    except Exception:
        return False


class BITMAPINFOHEADER(ctypes.Structure):
    _fields_ = [
        ("biSize", wintypes.DWORD),
        ("biWidth", wintypes.LONG),
        ("biHeight", wintypes.LONG),
        ("biPlanes", wintypes.WORD),
        ("biBitCount", wintypes.WORD),
        ("biCompression", wintypes.DWORD),
        ("biSizeImage", wintypes.DWORD),
        ("biXPelsPerMeter", wintypes.LONG),
        ("biYPelsPerMeter", wintypes.LONG),
        ("biClrUsed", wintypes.DWORD),
        ("biClrImportant", wintypes.DWORD),
    ]


class BITMAPINFO(ctypes.Structure):
    _fields_ = [("bmiHeader", BITMAPINFOHEADER), ("bmiColors", wintypes.DWORD * 3)]


def tamanho_janela_captura(jid):
    """Largura/altura pares da janela para PrintWindow (GetWindowRect).

    Nao usa bounds DWM: PrintWindow desenha no tamanho de GetWindowRect.
    Se misturar os dois, o frame fica cortado ou com barra preta.
    Ignora IsIconic mentiroso: se o rect ainda e util, captura.
    """
    if not IS_WINDOWS:
        return 0, 0
    try:
        hwnd = int(str(jid), 0)
        user32 = ctypes.windll.user32
        if not user32.IsWindow(hwnd):
            return 0, 0
        rect = wintypes.RECT()
        if not user32.GetWindowRect(hwnd, ctypes.byref(rect)):
            return 0, 0
        if rect.left <= -25000 or rect.top <= -25000:
            return 0, 0
        w = int(rect.right - rect.left)
        h = int(rect.bottom - rect.top)
        w -= w % 2
        h -= h % 2
        if w < 16 or h < 16:
            return 0, 0
        return w, h
    except Exception:
        return 0, 0


def capturar_hwnd_bgr(hwnd, larg, alt):
    """Captura o conteudo real da janela (mesmo coberta / sem foco).

    gdigrab por titulo/regiao so pega pixels visiveis no desktop: se o
    YouTube estiver na frente do VLC, sai o YouTube ou preto. PrintWindow
    com PW_RENDERFULLCONTENT le o buffer DWM da HWND alvo.
    """
    if not IS_WINDOWS or not hwnd or larg < 2 or alt < 2:
        return None
    user32 = ctypes.windll.user32
    gdi32 = ctypes.windll.gdi32
    hwnd = int(hwnd)
    if not user32.IsWindow(hwnd):
        return None

    # DC da propria janela (melhor que DC da tela para apps Qt/DirectX).
    hdc_win = user32.GetWindowDC(hwnd) or user32.GetDC(hwnd)
    if not hdc_win:
        return None
    hdc_mem = gdi32.CreateCompatibleDC(hdc_win)
    hbmp = gdi32.CreateCompatibleBitmap(hdc_win, larg, alt)
    antigo = gdi32.SelectObject(hdc_mem, hbmp)
    try:
        # limpa pra nao reaproveitar lixo se PrintWindow falhar parcialmente
        gdi32.BitBlt(hdc_mem, 0, 0, larg, alt, 0, 0, 0, 0x00000042)  # BLACKNESS
        # 2 = PW_RENDERFULLCONTENT (janela coberta); 3 = client+full; 0 = basico
        ok = False
        for flag in (2, 3, 0):
            if user32.PrintWindow(hwnd, hdc_mem, flag):
                ok = True
                break
        if not ok:
            # ultimo recurso: BitBlt do DC da janela (pode falhar se coberta)
            gdi32.BitBlt(hdc_mem, 0, 0, larg, alt, hdc_win, 0, 0, 0x00CC0020)
            ok = True
        if not ok:
            return None

        bmi = BITMAPINFO()
        ctypes.memset(ctypes.byref(bmi), 0, ctypes.sizeof(bmi))
        bmi.bmiHeader.biSize = ctypes.sizeof(BITMAPINFOHEADER)
        bmi.bmiHeader.biWidth = larg
        bmi.bmiHeader.biHeight = -alt  # top-down
        bmi.bmiHeader.biPlanes = 1
        bmi.bmiHeader.biBitCount = 24
        bmi.bmiHeader.biCompression = 0  # BI_RGB
        stride = ((larg * 3 + 3) & ~3)
        buf = (ctypes.c_char * (stride * alt))()
        linhas = gdi32.GetDIBits(hdc_mem, hbmp, 0, alt, buf, ctypes.byref(bmi), 0)
        if linhas <= 0:
            return None
        if stride == larg * 3:
            return bytes(buf)
        cru = bytearray(larg * 3 * alt)
        for y in range(alt):
            ini = y * stride
            cru[y * larg * 3:(y + 1) * larg * 3] = buf[ini:ini + larg * 3]
        return bytes(cru)
    finally:
        gdi32.SelectObject(hdc_mem, antigo)
        gdi32.DeleteObject(hbmp)
        gdi32.DeleteDC(hdc_mem)
        user32.ReleaseDC(hwnd, hdc_win)


def restaurar_janela(jid):
    if IS_WINDOWS:
        try:
            hwnd = int(str(jid), 0)
            user32 = ctypes.windll.user32
            kernel32 = ctypes.windll.kernel32
            if not user32.IsWindow(hwnd):
                return False
            # SW_RESTORE=9; se so estiver atras, traz pra frente
            if user32.IsIconic(hwnd):
                user32.ShowWindow(hwnd, 9)
            else:
                user32.ShowWindow(hwnd, 5)  # SW_SHOW
            # SetForegroundWindow costuma falhar sem AttachThreadInput.
            fg = user32.GetForegroundWindow()
            pid_fg = wintypes.DWORD()
            tid_fg = user32.GetWindowThreadProcessId(fg, ctypes.byref(pid_fg)) if fg else 0
            pid_alvo = wintypes.DWORD()
            tid_alvo = user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid_alvo))
            tid_atual = kernel32.GetCurrentThreadId()
            anexou = False
            if tid_fg and tid_fg != tid_atual:
                anexou = bool(user32.AttachThreadInput(tid_atual, tid_fg, True))
            try:
                user32.BringWindowToTop(hwnd)
                # HWND_TOP = 0; SWP_NOMOVE|SWP_NOSIZE|SWP_SHOWWINDOW = 0x0040|0x0002|0x0001
                user32.SetWindowPos(hwnd, 0, 0, 0, 0, 0, 0x0043)
                user32.SetForegroundWindow(hwnd)
                user32.SetActiveWindow(hwnd)
                user32.SetFocus(hwnd)
            finally:
                if anexou:
                    user32.AttachThreadInput(tid_atual, tid_fg, False)
            time.sleep(0.45)
            return janela_visivel(jid)
        except Exception:
            return False

    rodar(["wmctrl", "-i", "-a", jid], timeout=3)
    time.sleep(0.7)
    return janela_visivel(jid)


def listar_janelas():
    if IS_WINDOWS:
        janelas = []
        user32 = ctypes.windll.user32
        try:
            user32.SetProcessDPIAware()
        except Exception:
            pass

        # Tipagem explicita evita HWND truncado em Python 64-bit.
