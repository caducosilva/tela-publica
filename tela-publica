const $ = i => document.getElementById(i);
let est = {}, alvo = "", assinaturas = {}, ultimoChat = 0, itensFontes = [];

function api(rota, corpo){
  const sep = rota.indexOf("?") >= 0 ? "&" : "?";
  return fetch(rota + sep + "k=" + encodeURIComponent(D.chave), {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify(corpo === undefined ? {} : corpo),
    cache: "no-store"
  }).then(async r => {
    const d = await r.json().catch(() => null);
    if (!r.ok) throw new Error((d && d.erro) || ("http " + r.status));
    return d;
  });
}

function ocupado(btn, promessa){
  if (!btn) return promessa;
  btn.disabled = true;
  return promessa.finally(() => { btn.disabled = false; });
}

function rotuloJanela(j){
  const app = (j.app || "").trim();
  const tit = (j.titulo || "").trim();
  if (app && tit && tit.toLowerCase() !== app.toLowerCase()
      && !tit.toLowerCase().startsWith(app.toLowerCase()))
    return app + " - " + tit;
  return tit || app || "Janela";
}

function aplicarFontes(d){
  if (!d || !Array.isArray(d.telas) || !Array.isArray(d.janelas)) return false;
  const itens = [];
  (d.telas || []).forEach(t => itens.push({v:"tela:"+t.nome, tipo:"tela",
    t:"Tela inteira (" + (t.rotulo || t.nome) + ")", s:t.w + "x" + t.h, app:""}));
  (d.janelas || []).forEach(j => itens.push({v:"janela:"+j.id, tipo:"janela",
    t: rotuloJanela(j), app: j.app || "",
    s:(j.minimizada ? "minimizada  " : "") + (j.w + "x" + j.h), min:!!j.minimizada}));
  itensFontes = itens;
  const cont = $("contagem");
  if (cont) cont.textContent = "(" + (d.janelas || []).length + " janelas)";
  assinaturas.jn = null;
  pintarListaJanelas();
  preencherMics(d.microfones || [], true);
  if (d.microfone_atual && $("mic")){
    const f = $("mic");
    if ([...f.options].some(o => o.value === d.microfone_atual)) f.value = d.microfone_atual;
  }
  return itens.length > 0;
}

function pintarListaJanelas(){
  const jn = $("jn");
  if (!jn) return;
  const q = (($("busca-janela") && $("busca-janela").value) || "").trim().toLowerCase();
  const filtrados = !q ? itensFontes : itensFontes.filter(it =>
    (it.t + " " + (it.app || "") + " " + it.s).toLowerCase().indexOf(q) >= 0);
  jn.innerHTML = "";
  filtrados.forEach(it => {
    const el = document.createElement("div");
    el.setAttribute("data-alvo", it.v);
    const meta = document.createElement("div");
    meta.className = "meta";
    const span = document.createElement("span");
    span.textContent = it.t;
    meta.appendChild(span);
    if (it.app && it.tipo === "janela"){
      const em = document.createElement("em");
      em.textContent = it.app;
      meta.appendChild(em);
    }
    const small = document.createElement("small");
    small.textContent = it.s;
    el.appendChild(meta);
    el.appendChild(small);
    if (it.min) el.style.opacity = ".55";
    if (it.v === alvo) el.className = "sel";
    el.onclick = () => {
      alvo = it.v;
      [...jn.children].forEach(c => c.className = "");
      el.className = "sel";
      assinaturas.jn = null;
      api("/api/opcoes", {alvo: alvo}).then(pintar).catch(()=>{});
    };
    jn.appendChild(el);
  });
  if (!filtrados.length){
    const msg = document.createElement("div");
    msg.textContent = q
      ? ('Nenhuma janela com "' + q + '"')
      : "Nenhuma janela aberta. Abra o app e clique em Atualizar lista.";
    jn.appendChild(msg);
  }
}

function filtrarJanelas(){ pintarListaJanelas(); }

function listar(forcar, tentativa){
  tentativa = tentativa || 1;
  const jn = $("jn");
  const btn = $("btn-atualizar");
  if (forcar && btn && tentativa === 1){
    btn.dataset.txt = btn.textContent;
    btn.textContent = "Atualizando...";
    btn.disabled = true;
  }
  return api("/api/fontes", {}).then(d => {
    if (btn && btn.dataset.txt){
      btn.textContent = btn.dataset.txt;
      btn.disabled = false;
    }
    if (!aplicarFontes(d)){
      if (tentativa < 4)
        return new Promise(r => setTimeout(r, 300 * tentativa)).then(() => listar(forcar, tentativa + 1));
      if (jn && !itensFontes.length){
        jn.innerHTML = "";
        const msg = document.createElement("div");
        msg.textContent = "Nao consegui listar. Clique em Atualizar lista.";
        jn.appendChild(msg);
      }
    }
  }).catch(() => {
    if (tentativa < 4)
      return new Promise(r => setTimeout(r, 300 * tentativa)).then(() => listar(forcar, tentativa + 1));
    if (btn && btn.dataset.txt){
      btn.textContent = btn.dataset.txt;
      btn.disabled = false;
    }
    if (jn && !itensFontes.length){
      jn.innerHTML = "";
      const msg = document.createElement("div");
      msg.textContent = "Falha ao carregar. Clique em Atualizar lista.";
      jn.appendChild(msg);
    }
  });
}

function preencherMics(lista, forcar){
  const f = $("mic");
  if (!f) return;
  const atuais = [...f.options].map(o => o.value).filter(Boolean);
  // Nao apaga a lista boa se uma leitura veio vazia.
  if (!(lista || []).length){
    if (!atuais.length){
      f.innerHTML = "";
      const o = document.createElement("option");
      o.value = ""; o.textContent = "nenhum microfone encontrado";
      f.appendChild(o);
    }
    return;
  }
  const assinaM = JSON.stringify(lista.map(m => m.nome));
  if (!forcar && assinaturas.mic === assinaM && f.options.length) return;
  assinaturas.mic = assinaM;
  let antes = f.value || (D.opcoes && D.opcoes.microfone) || "";
  const wireless = lista.find(m => /wireless|sem fio/i.test(m.nome || ""));
  if (!antes && wireless) antes = wireless.nome;
  if (!antes) antes = lista[0].nome;
  f.innerHTML = "";
  lista.forEach(m => {
    const o = document.createElement("option");
    o.value = m.nome;
    o.textContent = m.rotulo || m.nome;
    f.appendChild(o);
  });
  if ([...f.options].some(o => o.value === antes)) f.value = antes;
  else if (f.options.length) f.selectedIndex = 0;
  if (f.value && (!(D.opcoes && D.opcoes.microfone) || D.opcoes.microfone !== f.value))
    api("/api/opcoes", {microfone: f.value}).then(e => { if (e) pintar(e); }).catch(()=>{});
}

function atualizarMics(btn){
  return ocupado(btn, api("/api/fontes", {atualizar_mics: true}).then(d => {
    preencherMics((d && d.microfones) || [], true);
  }));
}

function alternarMic(btn){
  const ligar = !(est.opcoes && est.opcoes.mic_ligado);
  return ocupado(btn, api("/api/microfone",
    {microfone: $("mic").value, mic_ligado: ligar}).then(pintar));
}

function alternar(btn){
  btn.textContent = est.rodando ? "Parando..." : "Iniciando...";
  return ocupado(btn, api(est.rodando ? "/api/parar" : "/api/iniciar",
    {alvo: alvo}).then(e => { pintar(e); listar(); }));
}

function encerrar(btn){
  if (!confirm("Encerrar tudo e liberar a porta?")) return;
  btn.disabled = true;
  fetch("/api/encerrar?agora=1&k=" + D.chave, {method:"POST"}).catch(()=>{});
  document.body.innerHTML = "<div class='env'><h1>Encerrado</h1>" +
    "<p class='mut'>A porta foi liberada. Pode fechar esta janela.</p></div>";
}

function caixaLink(url, publico){
  const cx = document.createElement("div");
  cx.className = "lnk";
  const a = document.createElement("a");
  a.className = "url";
  a.href = url;
  a.target = "_blank";
  a.rel = "noopener";
  a.textContent = url;
  const b = document.createElement("button");
  b.textContent = "Copiar";
  b.onclick = () => {
    const ok = () => {
      b.textContent = "Copiado";
      setTimeout(() => b.textContent = "Copiar", 1500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText)
      navigator.clipboard.writeText(url).then(ok).catch(() => {
        window.prompt("Copie o link:", url); ok();
      });
    else { window.prompt("Copie o link:", url); ok(); }
  };
  cx.appendChild(a); cx.appendChild(b);
  if (publico){
    const w = document.createElement("button");
    w.textContent = "WhatsApp";
    w.onclick = () => window.open("https://wa.me/?text=" + encodeURIComponent(
      "Assiste aqui: " + url), "_blank");
    cx.appendChild(w);
  }
  return cx;
}

function pintarLinks(){
  const assina = est.url_publica + "|" + (est.urls_diretas||[]).join("|") + "|" + est.tunel;
  if (assinaturas.links === assina) return;
  assinaturas.links = assina;
  const t = $("tunel");
  if (!t) return;
  t.innerHTML = "";
  const m = document.createElement("div");
  m.className = "mut";
  if (est.url_publica){
    m.textContent = est.rodando
      ? "Mande este link. Funciona de qualquer lugar."
      : "Link pronto. Clique em Comecar acima para a imagem aparecer para quem assistir.";
    t.appendChild(m);
    t.appendChild(caixaLink(est.url_publica, true));
  } else if (est.tunel === "conectando"){
    m.textContent = "Abrindo o link publico... aguarde uns segundos.";
    t.appendChild(m);
  } else if (est.tunel_disponivel){
    m.textContent = "Sem link publico ativo. ";
    const btn = document.createElement("button");
    btn.textContent = "Gerar link agora";
    btn.onclick = () => ocupado(btn, api("/api/tunel", {}).then(pintar));
    m.appendChild(btn);
    t.appendChild(m);
  } else {
    m.textContent = "Para gerar link de fora da sua rede, instale o cloudflared: " +
      "tela-publica --instalar-cloudflared";
    t.appendChild(m);
  }
  const dd = $("diretos");
  if (!dd) return;
  dd.innerHTML = "";
  const m2 = document.createElement("div");
  m2.className = "mut"; m2.style.marginTop = "14px";
  m2.textContent = "Na mesma rede Wi-Fi de casa:";
  dd.appendChild(m2);
  (est.urls_diretas||[]).forEach(u => dd.appendChild(caixaLink(u, false)));
}

function pintarProblemas(){
  if (assinaturas.problemas) return;
  assinaturas.problemas = true;
  const cx = $("problemas");
  if (!cx) return;
  (est.problemas || []).forEach(p => {
    const d = document.createElement("div");
    d.className = "aviso";
    const t = document.createElement("div");
    t.textContent = p.texto;
    const s = document.createElement("code");
    s.textContent = p.solucao;
    d.appendChild(t); d.appendChild(s);
    cx.appendChild(d);
  });
}

function pintar(e){
  if (e) est = e;
  if (!est || !est.opcoes) return;
  if (!alvo && est.opcoes.alvo) alvo = est.opcoes.alvo;
  try { pintarProblemas(); } catch (err) {}
  try { pintarLinks(); } catch (err) {}

  const pt = $("pt");
  if (pt) pt.className = "pt" + (est.estado === "no ar" ? " on" :
    (est.estado === "erro" ? " er" : ""));
  const btnMain = $("btn");
  if (btnMain) btnMain.textContent = est.rodando ? "Parar" : "Comecar";

  const vs = est.visores || [];
  const tocando = vs.filter(x => x.tocando).length;
  let quem = (est.espectadores || 0) + " conectado(s)";
  if (tocando) quem = tocando + " assistindo, " +
    Math.round(Math.max(...vs.map(x => x.buffer)) * 10) / 10 + "s de folga";
  const status = $("status");
  if (status) status.textContent = (est.estado || "") + (est.rodando ? "  |  " + quem : "");
  const resumo = $("resumo");
  if (resumo) resumo.textContent = est.rodando ?
    "no ar ha " + Math.floor((est.segundos || 0)/60) + " min" : "";

  const qbtns = $("qbtns");
  if (qbtns){
    const niveis = est.niveis || [
      {nome:"480p", larg:854, alt:480, fps:30, kbps:1500},
      {nome:"720p", larg:1280, alt:720, fps:30, kbps:4500},
      {nome:"1080p", larg:1920, alt:1080, fps:30, kbps:12000}
    ];
    qbtns.innerHTML = "";
    niveis.forEach(n => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = n.nome + " 30fps";
      if ((est.qualidade || "") === n.nome) b.className = "sel";
      b.title = n.larg + "x" + n.alt + " ~" + Math.round(n.kbps/1000) + " Mbps";
      b.onclick = () => ocupado(b, api("/api/qualidade", {qualidade: n.nome}).then(pintar));
      qbtns.appendChild(b);
    });
  }

  const abtns = $("atrasobtns");
  if (abtns){
    const opcoes = est.atrasos || [3, 6, 10];
    const atual = est.atraso || 6;
    abtns.innerHTML = "";
    opcoes.forEach(sec => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = sec + " segundos";
      if (Number(atual) === Number(sec)) b.className = "sel";
      b.title = "Quem assiste fica cerca de " + sec + "s atras do ao vivo";
      b.onclick = () => ocupado(b, api("/api/atraso", {atraso: sec}).then(pintar));
      abtns.appendChild(b);
    });
  }

  const q = $("q");
  if (q){
    q.innerHTML = "";
    const b = document.createElement("b");
    b.textContent = (est.qualidade || "?") + " " + (est.fps || 30) + "fps"
      + (est.dimensoes ? " (" + est.dimensoes + ")" : "")
      + " · atraso " + (est.atraso || 6) + "s";
    q.appendChild(b);
    const det = document.createElement("span");
    det.className = "mut";
    const enviando = (est.kbps || 0);
    const alvo = (est.kbps_alvo || 0);
    det.textContent = "enviando " + enviando + " kbps (~"
      + (Math.round(enviando/100)/10) + " Mbps)  |  alvo ~"
      + Math.round(alvo/1000) + " Mbps  |  "
      + (est.codificador || "")
      + (est.velocidade ? "  |  encode " + est.velocidade : "");
    q.appendChild(det);
  }

  const cx = $("cxstat");
  if (cx){
    const c = est.conexao || {};
    const st = c.status || (est.rodando ? "aviso" : "parado");
    cx.className = "cxstat " + st;
    const tit = document.createElement("b");
    const rotulo = {
      ok: "Conexao ok",
      apertado: "Conexao apertada",
      erro: "Nao esta transmitindo",
      iniciando: "Iniciando...",
      pausado: "Pausado",
      parado: "Parado",
      aviso: "Aguardando"
    }[st] || st;
    tit.textContent = rotulo;
    const det = document.createElement("span");
    det.className = "mut";
    det.textContent = c.detalhe || "";
    const extra = document.createElement("span");
    extra.className = "mut";
    const esp = (est.espectadores || 0);
    extra.textContent = esp
      ? (esp + " assistindo agora")
      : (est.rodando ? "Link no ar; aguardando quem assiste" : "");
    cx.innerHTML = "";
    cx.appendChild(tit);
    if (det.textContent) cx.appendChild(det);
    if (extra.textContent) cx.appendChild(extra);
  }

  const s = est.som || {};
  const info = $("som-info");
  if (info){
    if (!est.opcoes.alvo) info.textContent = "Escolha uma janela acima.";
    else if (s.programa) info.textContent = "Som: " + s.programa +
      ". Quem assiste ouve o que sai nas suas caixas (VLC, Chrome, etc.).";
    else info.textContent = "Transmitindo audio do sistema.";
  }

  const bm = $("bmic");
  if (bm){
    const ligado = !!est.opcoes.mic_ligado;
    bm.className = ligado ? "on" : "";
    bm.textContent = ligado ? (s.mic_no_ar ? "Microfone no ar" : "Ligando microfone...")
                            : "Microfone desligado";
  }

  const er = $("erro");
  if (er) er.textContent = est.erro || "";
  const reg = $("reg");
  if (reg) reg.textContent = (est.registro || []).join(String.fromCharCode(10));
}

function adicionar(m){
  const el = document.createElement("div");
  el.className = "msg";
  const b = document.createElement("b");
  b.textContent = m.nome;
  el.appendChild(b);
  el.appendChild(document.createTextNode(m.texto));
  $("msgs").appendChild(el);
  $("msgs").scrollTop = $("msgs").scrollHeight;
  setTimeout(() => { el.className = "msg saindo";
    setTimeout(() => el.remove(), 800); }, Math.max(1, m.resta) * 1000);
}

function puxarChat(){
  api("/api/chat?desde=" + ultimoChat).then(d => {
    ultimoChat = d.ultimo;
    (d.mensagens || []).forEach(adicionar);
  }).catch(()=>{});
}

function salvarNomePainel(){
  const n = ($("apelido").value || "").trim();
  if (n.length < 2){
    $("chat-aviso").textContent = "Use pelo menos 2 letras.";
    return;
  }
  localStorage.setItem("tp_apelido", n);
  $("chat-aviso").textContent = "";
  $("chat-gate").style.display = "none";
  $("chat-form").style.display = "flex";
  $("texto").focus();
}
function mandar(btn){
  const nome = ($("apelido").value || localStorage.getItem("tp_apelido") || "").trim();
  const texto = $("texto").value.trim();
  if (nome.length < 2){
    $("chat-aviso").textContent = "Escolha um nome antes.";
    $("chat-gate").style.display = "flex";
    $("chat-form").style.display = "none";
    return;
  }
  if (!texto) return;
  return ocupado(btn, api("/api/chat", {nome: nome, texto: texto}).then(d => {
    if (d.ok){ $("texto").value = ""; $("chat-aviso").textContent = ""; puxarChat(); }
    else $("chat-aviso").textContent = d.erro + (d.espera ? " (" + d.espera + "s)" : "");
  }));
}
try {
  const elTexto = $("texto");
  if (elTexto) elTexto.addEventListener("keydown", ev => {
    if (ev.key === "Enter") mandar();
  });
  const elApelido = $("apelido");
  if (elApelido){
    elApelido.addEventListener("keydown", ev => {
      if (ev.key === "Enter") salvarNomePainel();
    });
    const nomeSalvo = localStorage.getItem("tp_apelido") || "";
    elApelido.value = nomeSalvo;
    if (nomeSalvo.trim().length >= 2){
      const gate = $("chat-gate");
      const form = $("chat-form");
      if (gate) gate.style.display = "none";
      if (form) form.style.display = "flex";
    }
  }
} catch (e) {}

// Lista ja vem no HTML (D.fontes). Pinta na hora, depois atualiza via API.
try {
  if (D && D.opcoes && D.opcoes.alvo) alvo = D.opcoes.alvo;
  if (D && D.fontes) aplicarFontes(D.fontes);
} catch (e) {
  const jn = $("jn");
  if (jn) jn.textContent = "Erro ao montar lista inicial. Clique em Atualizar lista.";
}
listar(true);
api("/api/estado", {}).then(pintar).catch(()=>{});
setInterval(() => api("/api/estado", {}).then(pintar).catch(()=>{}), 2000);
setInterval(() => listar(false), 10000);
setInterval(puxarChat, 2000);
setInterval(() => api("/api/ping", {}).catch(()=>{}), 5000);
// Nao mata o servidor ao trocar de aba (pagehide no Chrome dispara demais).
// Use o botao Encerrar, ou feche a janela do terminal/atalho.
</script>
"""

