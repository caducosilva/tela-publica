def preferir_microfone(mics, atual=""):
    """Prioriza o microfone wireless; senão mantém o atual se ainda existir."""
    if not mics:
        return ""
    nomes = [m["nome"] for m in mics]
    if atual and atual in nomes:
        return atual
    for n in nomes:
        baixo = n.lower()
        if "wireless" in baixo or "sem fio" in baixo:
            return n
    return nomes[0]


def listar_microfones(forcar=False):
    agora = time.time()
    if (not forcar and _CACHE_MICS["lista"] is not None
            and agora - _CACHE_MICS["em"] < 60):
        return list(_CACHE_MICS["lista"])

    # No caminho normal do painel: nunca bloqueia. Devolve cache e aquece fora.
    if not forcar:
        if _CACHE_MICS["lista"] is None:
            threading.Thread(target=aquecer_cache_mics, daemon=True).start()
        return list(_CACHE_MICS["lista"] or [])

    if IS_WINDOWS:
        nomes = []
        for name in _microfones_windows_pnp():
            if not _eh_loopback_ou_virtual(name):
                nomes.append(name)
        if not nomes:
            for name in _dshow_audio_devices(forcar=True):
                if _eh_loopback_ou_virtual(name):
                    continue
                if name.lower() not in {n.lower() for n in nomes}:
                    nomes.append(name)

        mics = [{"nome": n, "rotulo": n[:64]} for n in nomes]
        mics.sort(key=lambda m: (
            0 if ("wireless" in m["nome"].lower() or "sem fio" in m["nome"].lower()) else 1,
            m["nome"].lower()
        ))
        if mics:
            _CACHE_MICS["lista"] = mics
            _CACHE_MICS["em"] = agora
        elif _CACHE_MICS["lista"]:
            return list(_CACHE_MICS["lista"])
        return list(mics)

    saida = rodar(["pactl", "list", "short", "sources"])
    fontes = []
    for linha in saida.splitlines():
        campos = linha.split("\t")
        if len(campos) < 2:
            continue
        nome = campos[1]
        if nome.endswith(".monitor") or nome.startswith(SINK_MESA):
            continue
        rotulo = (nome.replace("alsa_input.", "")
                      .replace("usb-", "").replace(".analog-stereo", "")
                      .replace("_", " "))
        fontes.append({"nome": nome, "rotulo": rotulo[:48]})
    return fontes


def aquecer_cache_mics():
    try:
        listar_microfones(forcar=True)
        log("cache de mics pronto:", len(_CACHE_MICS["lista"] or []))
    except Exception as e:
        log("aquecer mics:", e)


