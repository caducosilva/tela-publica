# GUIDs reais do runtime (NAudio/Wine). A documentacao da Microsoft lista outros.
_GUID_MMENUM = "{BCDE0395-E52F-467C-8E3D-C4579291692E}"
_GUID_IMMENUM = "{A95664D2-9614-4F35-A746-DE8DB63617E6}"
_GUID_IAUDIOCLIENT = "{1CB9AD4C-DBFA-4C32-B178-C2F568A703B2}"
_GUID_IAUDIOCAPTURE = "{C8ADBD64-E71E-48A0-A4DE-185C395CD317}"
_AUDCLNT_STREAMFLAGS_LOOPBACK = 0x00020000
_CLSCTX_ALL = 23


class _GUID(Structure):
    _fields_ = [
        ("Data1", wintypes.DWORD), ("Data2", wintypes.WORD),
        ("Data3", wintypes.WORD), ("Data4", wintypes.BYTE * 8),
    ]

    def __init__(self, texto=None):
        super().__init__()
        if not texto:
            return
        p = texto.strip("{}").split("-")
        self.Data1 = int(p[0], 16)
        self.Data2 = int(p[1], 16)
        self.Data3 = int(p[2], 16)
        b = bytes.fromhex(p[3] + p[4])
        for i, x in enumerate(b):
            self.Data4[i] = x


class _WAVEFORMATEX(Structure):
    _fields_ = [
        ("wFormatTag", wintypes.WORD), ("nChannels", wintypes.WORD),
        ("nSamplesPerSec", wintypes.DWORD), ("nAvgBytesPerSec", wintypes.DWORD),
        ("nBlockAlign", wintypes.WORD), ("wBitsPerSample", wintypes.WORD),
        ("cbSize", wintypes.WORD),
    ]


def _com_vt(obj, idx, restype, *argtypes):
    this = cast(obj, POINTER(c_void_p))
    vt = cast(this[0], POINTER(c_void_p))
    fn = WINFUNCTYPE(restype, c_void_p, *argtypes)(vt[idx])
    return lambda *a: fn(this, *a)


class WasapiLoopback:
    """Captura o som que sai nas caixas (loopback) e manda PCM s16le via TCP."""

    def __init__(self):
        self.porta = 0
        self.rate = 48000
        self.channels = 2
        self.ativo = False
        self.erro = ""
        self._parar = threading.Event()
        self._pronto = threading.Event()
        self._thread = None
        self._srv = None

    def preparar(self):
        """Sobe WASAPI numa thread e espera o socket ficar pronto."""
        self.parar()
        self._parar.clear()
        self._pronto.clear()
        self.erro = ""
        self._thread = threading.Thread(target=self._rodar, daemon=True)
        self._thread.start()
        if not self._pronto.wait(timeout=10):
            self.parar()
            raise RuntimeError(self.erro or "timeout ao iniciar WASAPI")
        if self.erro or not self.porta:
            self.parar()
            raise RuntimeError(self.erro or "WASAPI nao iniciou")
        return self.porta

    def parar(self):
        self._parar.set()
        srv, self._srv = self._srv, None
        if srv:
            try:
                # Desbloqueia accept() se ainda estiver esperando.
                try:
                    socket.create_connection(("127.0.0.1", srv.getsockname()[1]), timeout=0.3).close()
                except Exception:
                    pass
                srv.close()
            except Exception:
                pass
        thr, self._thread = self._thread, None
        if thr and thr.is_alive() and thr is not threading.current_thread():
            try:
                thr.join(timeout=2.0)
            except Exception:
                pass
        self.ativo = False
        self.porta = 0
        self._pronto.set()

    def _rodar(self):
        ole32 = ctypes.windll.ole32
        HRESULT = ctypes.c_long
        conn = None
        stop_fn = None
        try:
            ole32.CoInitializeEx(None, 0)
            enum_obj = c_void_p()
            hr = ole32.CoCreateInstance(
                byref(_GUID(_GUID_MMENUM)), None, _CLSCTX_ALL,
                byref(_GUID(_GUID_IMMENUM)), byref(enum_obj))
            if hr < 0:
                raise RuntimeError("CoCreateInstance 0x%X" % (hr & 0xffffffff))
            get_default = _com_vt(
                enum_obj, 4, HRESULT, wintypes.DWORD, wintypes.DWORD, POINTER(c_void_p))
            dev = c_void_p()
            hr = get_default(0, 0, byref(dev))
            if hr < 0:
                raise RuntimeError("GetDefaultAudioEndpoint 0x%X" % (hr & 0xffffffff))
            activate = _com_vt(
                dev, 3, HRESULT, POINTER(_GUID), wintypes.DWORD, c_void_p, POINTER(c_void_p))
            client = c_void_p()
            hr = activate(byref(_GUID(_GUID_IAUDIOCLIENT)), _CLSCTX_ALL, None, byref(client))
            if hr < 0:
                raise RuntimeError("Activate IAudioClient 0x%X" % (hr & 0xffffffff))
            get_mix = _com_vt(client, 8, HRESULT, POINTER(POINTER(_WAVEFORMATEX)))
            pwfx = POINTER(_WAVEFORMATEX)()
            hr = get_mix(byref(pwfx))
            if hr < 0:
                raise RuntimeError("GetMixFormat 0x%X" % (hr & 0xffffffff))
            wfx = pwfx.contents
            self.rate = int(wfx.nSamplesPerSec or 48000)
            self.channels = int(wfx.nChannels or 2)
            initialize = _com_vt(
                client, 3, HRESULT, wintypes.DWORD, wintypes.DWORD,
                c_longlong, c_longlong, POINTER(_WAVEFORMATEX), POINTER(_GUID))
            hr = initialize(0, _AUDCLNT_STREAMFLAGS_LOOPBACK, 5000000, 0, pwfx, None)
            if hr < 0:
                raise RuntimeError("Initialize loopback 0x%X" % (hr & 0xffffffff))
            get_service = _com_vt(client, 14, HRESULT, POINTER(_GUID), POINTER(c_void_p))
            cap = c_void_p()
            hr = get_service(byref(_GUID(_GUID_IAUDIOCAPTURE)), byref(cap))
            if hr < 0:
                raise RuntimeError("GetService capture 0x%X" % (hr & 0xffffffff))
            start = _com_vt(client, 10, HRESULT)
            stop_fn = _com_vt(client, 11, HRESULT)
            get_buffer = _com_vt(
                cap, 3, HRESULT, POINTER(POINTER(c_byte)), POINTER(c_uint32),
                POINTER(c_ulong), POINTER(c_uint64), POINTER(c_uint64))
            release_buffer = _com_vt(cap, 4, HRESULT, c_uint32)
            next_pkt = _com_vt(cap, 5, HRESULT, POINTER(c_uint32))
            start()

            srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            srv.bind(("127.0.0.1", 0))
            srv.listen(1)
            srv.settimeout(20)
            self._srv = srv
            self.porta = srv.getsockname()[1]
            self._pronto.set()

            conn, _addr = srv.accept()
            if self._parar.is_set():
                return
            conn.settimeout(1.0)
            self.ativo = True
            log("wasapi loopback no ar @ %d Hz porta %d" % (self.rate, self.porta))
            eh_float = (wfx.wFormatTag == 3) or (wfx.wFormatTag == 0xFFFE)
            ch = max(1, int(wfx.nChannels))
            rate = max(8000, int(self.rate))
            silencio_frames = max(1, rate // 50)
            ultimo_envio = time.time()
            while not self._parar.is_set():
                pkt = c_uint32(0)
                next_pkt(byref(pkt))
                if pkt.value == 0:
                    if time.time() - ultimo_envio >= 0.02:
                        try:
                            conn.sendall(b"\x00\x00\x00\x00" * silencio_frames)
                            ultimo_envio = time.time()
                        except OSError:
                            break
                    time.sleep(0.004)
                    continue
                data = POINTER(c_byte)()
                nframes = c_uint32(0)
                flags = c_ulong(0)
                get_buffer(byref(data), byref(nframes), byref(flags), None, None)
                nbytes = int(nframes.value) * int(wfx.nBlockAlign)
                raw = string_at(data, nbytes)
                release_buffer(nframes.value)
                if flags.value & 0x2:
                    pcm = b"\x00\x00\x00\x00" * int(nframes.value)
                elif eh_float and nbytes >= 4:
                    out = bytearray()
                    passo = 4 * ch
                    for i in range(0, nbytes - passo + 1, passo):
                        L = struct.unpack_from("<f", raw, i)[0]
                        R = struct.unpack_from("<f", raw, i + 4)[0] if ch > 1 else L
                        L = max(-1.0, min(1.0, float(L)))
                        R = max(-1.0, min(1.0, float(R)))
                        out += struct.pack("<hh", int(L * 32767), int(R * 32767))
                    pcm = bytes(out)
                elif wfx.wBitsPerSample == 16:
                    if ch == 2:
                        pcm = raw
                    else:
                        out = bytearray()
                        for i in range(0, len(raw) - 1, 2):
                            out += raw[i:i + 2] * 2
                        pcm = bytes(out)
                else:
                    continue
                if not pcm:
                    continue
                try:
                    conn.sendall(pcm)
                    ultimo_envio = time.time()
                except OSError:
                    break
        except Exception as e:
            self.erro = str(e)
            log("wasapi loopback:", e)
            self._pronto.set()
        finally:
            self.ativo = False
            try:
                if stop_fn:
                    stop_fn()
            except Exception:
                pass
            try:
                if conn:
                    conn.close()
            except Exception:
                pass
            try:
                if self._srv:
                    self._srv.close()
            except Exception:
                pass
            self._srv = None
            try:
                ole32.CoUninitialize()
            except Exception:
                pass
            self._pronto.set()


def _achar_csc():
    """Compilador C# do .NET Framework (sempre presente no Windows)."""
    base = os.path.join(os.environ.get("WINDIR", r"C:\Windows"),
                        "Microsoft.NET", "Framework64")
    for ver in ("v4.0.30319", "v3.5"):
        csc = os.path.join(base, ver, "csc.exe")
        if os.path.isfile(csc):
            return csc
    return shutil.which("csc") or ""


def garantir_helper_audio_pid():
    """Compila captura-audio-pid.exe no cache se ainda nao existir."""
    exe = os.path.join(DIR_CACHE, "captura-audio-pid.exe")
    stamp = os.path.join(DIR_CACHE, "captura-audio-pid.ver")
    cs = os.path.join(_dir_script(), "captura-audio-pid.cs")
    if not os.path.isfile(cs):
        raise RuntimeError("captura-audio-pid.cs nao encontrado em %s" % _dir_script())
    precisa = True
    if os.path.isfile(exe) and os.path.isfile(stamp):
        try:
            if (open(stamp, encoding="utf-8").read().strip() == HELPER_AUDIO_VER
                    and os.path.getmtime(exe) >= os.path.getmtime(cs)):
                precisa = False
        except Exception:
            precisa = True
    if not precisa:
        return exe
    csc = _achar_csc()
    if not csc:
        raise RuntimeError("csc.exe nao encontrado (precisa do .NET Framework)")
    os.makedirs(DIR_CACHE, exist_ok=True)
    tmp = exe + ".tmp.exe"
    kwargs = dict(capture_output=True, text=True, timeout=60)
    kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
    r = subprocess.run(
        [csc, "/nologo", "/optimize+", "/platform:x64", "/out:" + tmp, cs],
        **kwargs)
    if r.returncode != 0 or not os.path.isfile(tmp):
        err = (r.stderr or r.stdout or "").strip()
        raise RuntimeError("falha ao compilar captura-audio-pid: %s" % (err[:400] or r.returncode))
    try:
        if os.path.isfile(exe):
            os.remove(exe)
    except Exception:
        pass
    os.replace(tmp, exe)
    with open(stamp, "w", encoding="utf-8") as f:
        f.write(HELPER_AUDIO_VER)
    log("helper de audio por processo compilado:", exe)
    return exe


class WasapiProcessLoopback:
    """Som so do PID (e filhos), via helper C# + TCP PCM s16le 48kHz."""

    def __init__(self, pid, include=True):
        self.pid = int(pid)
        self.include = bool(include)
        self.porta = 0
        self.rate = 48000
        self.channels = 2
        self.ativo = False
        self.erro = ""
        self._proc = None

    def preparar(self):
        self.parar()
        self.erro = ""
        exe = garantir_helper_audio_pid()
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.bind(("127.0.0.1", 0))
        porta = s.getsockname()[1]
        s.close()
        modo = "include" if self.include else "exclude"
        kwargs = dict(
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL, bufsize=0, env=ambiente())
        kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        self._proc = subprocess.Popen(
            [exe, str(self.pid), modo, str(porta)], **kwargs)
        linhas = queue.Queue()

        def _le_stderr():
            try:
                for raw in iter(self._proc.stderr.readline, b""):
                    if not raw:
                        break
                    linhas.put(raw.decode("utf-8", "replace").strip())
            except Exception:
                pass
            linhas.put(None)

        threading.Thread(target=_le_stderr, daemon=True).start()
        prazo = time.time() + 12
        while time.time() < prazo:
            if self._proc.poll() is not None and linhas.empty():
                self.erro = self.erro or "helper de audio saiu cedo"
                self.parar()
                raise RuntimeError(self.erro)
            try:
                linha = linhas.get(timeout=0.2)
            except queue.Empty:
                continue
            if linha is None:
                break
            if not linha:
                continue
            log("audio-pid:", linha)
            if linha.startswith("READY"):
                self.porta = porta
                self.ativo = True
                threading.Thread(target=self._drena_fila, args=(linhas,),
                                 daemon=True).start()
                log("audio so do processo %s @ %d Hz porta %d" % (
                    self.pid, self.rate, self.porta))
                return self.porta
            if any(x in linha for x in ("failed", "fail", "error", "timeout")):
                self.erro = linha[:300]
            elif "0x" in linha and "Activate" in linha:
                self.erro = linha[:300]
        self.erro = self.erro or "timeout ao iniciar audio do processo"
        self.parar()
        raise RuntimeError(self.erro)

    def _drena_fila(self, linhas):
        try:
            while True:
                try:
                    linha = linhas.get(timeout=1.0)
                except queue.Empty:
                    if not self._proc or self._proc.poll() is not None:
                        break
                    continue
                if linha is None:
                    break
                if linha:
                    log("audio-pid:", linha)
        except Exception:
            pass

    def parar(self):
        self.ativo = False
        p, self._proc = self._proc, None
        if not p:
            self.porta = 0
            return
        try:
            if p.poll() is None:
                p.terminate()
                try:
                    p.wait(timeout=1.5)
                except Exception:
                    p.kill()
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
        try:
            if p.stderr:
                p.stderr.close()
        except Exception:
            pass
        self.porta = 0


