_CACHE_DSHOW = {"em": 0.0, "devs": None}
_CACHE_MICS = {"em": 0.0, "lista": None}


def _dshow_audio_devices(forcar=False):
    agora = time.time()
    if (not forcar and _CACHE_DSHOW["devs"] is not None
            and agora - _CACHE_DSHOW["em"] < 20):
        return list(_CACHE_DSHOW["devs"])

    cmd = [FFMPEG_BIN, "-hide_banner", "-list_devices", "true", "-f", "dshow", "-i", "dummy"]
    out = ""
    try:
        kwargs = dict(capture_output=True, timeout=15)
        if IS_WINDOWS:
            kwargs["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        res = subprocess.run(cmd, **kwargs)
        bruto = (res.stderr or b"") + (res.stdout or b"")
        for enc in ("utf-8", "cp1252", "latin-1"):
            try:
                out = bruto.decode(enc)
                break
            except Exception:
                continue
        if not out:
            out = bruto.decode("utf-8", errors="replace")
    except Exception as e:
        log("falha ao listar devices dshow:", e)
        out = ""

    # Formatos comuns do ffmpeg (ASCII e aspas “curvas”).
    nomes = []
    for padrao in (
        r'"([^"]+)"\s*\(audio\)',
        r"'([^']+)'\s*\(audio\)",
        r'“([^”]+)”\s*\(audio\)',
        r'"([^"]+)"\s*\(audio\s*only\)',
    ):
        for n in re.findall(padrao, out, flags=re.IGNORECASE):
            n = (n or "").strip()
            if n and n not in nomes:
                nomes.append(n)

    if nomes:
        _CACHE_DSHOW["devs"] = nomes
        _CACHE_DSHOW["em"] = agora
    elif _CACHE_DSHOW["devs"]:
        return list(_CACHE_DSHOW["devs"])
    return list(nomes)


def _microfones_windows_pnp():
